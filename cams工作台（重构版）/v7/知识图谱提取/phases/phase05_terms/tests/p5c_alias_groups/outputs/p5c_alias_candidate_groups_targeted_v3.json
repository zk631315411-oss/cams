      "evidence_examples": [
        {
          "unit_id": "v7u_N001721",
          "unit_order": 1721,
          "en_quote": "Another goal of the AML Act is to transform SARs from a simple reporting requirement to a tool for intelligence gathering. SARs are now expected to provide a “high degree of usefulness” for law enforcement and national security agencies.",
          "knowledge_zh": "《反洗钱法》将可疑交易报告转变为高价值情报工具"
        },
        {
          "unit_id": "v7u_N001722",
          "unit_order": 1722,
          "en_quote": "Additionally, there are provisions to facilitate cross-border sharing of SARs within financial institutions.",
          "knowledge_zh": "《反洗钱法》允许金融机构内部跨境共享可疑交易报告"
        },
        {
          "unit_id": "v7u_N001740",
          "unit_order": 1740,
          "en_quote": "For instance, FinCEN sets the standards for what constitutes suspicious activity and ensures that financial institutions properly file reports that could prove useful in criminal, tax, and counterterrorism investigations.",
          "knowledge_zh": "FinCEN 设定可疑活动标准并确保金融机构正确提交报告以支持调查"
        },
        {
          "unit_id": "v7u_N001689",
          "unit_order": 1689,
          "en_quote": "Suspicious activity reports",
          "knowledge_zh": "可疑活动报告"
        },
        {
          "unit_id": "v7u_N002450",
          "unit_order": 2450,
          "en_quote": "An MLRO oversees an organization’s AML program, files SARs to the relevant FIU, and ensures implementation and compliance with AML strategies and policies.",
          "knowledge_zh": "洗钱RO监督机构反洗钱项目，向FIU提交可疑活动报告，确保反洗钱策略与政策的实施与合规。"
        }
