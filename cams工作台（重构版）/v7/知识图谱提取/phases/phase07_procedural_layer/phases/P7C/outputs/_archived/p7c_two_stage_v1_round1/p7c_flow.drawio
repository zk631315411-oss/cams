ll><mxCell id="e_24173b156a" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_a79ae44ee8" target="v_e37846d7c1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3741742618" value="DECIDES / yes" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_941ef710c4" target="v_a79ae44ee8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_3d096ef7ce" value="虚线 = functional_dependency 或 needs_review，需要 P7D 复核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="780" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH02-S04" id="page_854cc318c6"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_dcbe8e9209" value="CH02-S04 Types of financial crime &amp;gt; Case example: FullTechGlobal corruption scandal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_4d8681979e" value="status=missing_summary | cards=2 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_305f09ead8" value="CH02-S04 / card 1: FullTechGlobal 审查识别内部控制缺陷" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_cc222ca099" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_4ea21f5ddb" value="&lt;b&gt;步骤：&lt;/b&gt;Sophie 对 FullTechGlobal&lt;br&gt;进行审查与审计&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000141&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_a205ce2909" value="&lt;b&gt;产出：&lt;/b&gt;识别出 ABC 框架与内部控制存在缺陷&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000141&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_5291a5a36b" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_4ea21f5ddb" target="v_a205ce2909"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_bac9d3e01e" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：Sophie 进行审查与审计 → 识别出 ABC 框架与内部控制缺陷。KG不足：基础 KG 可将该事实作为案例指标保存，但无法表达‘审查动作产生识别结论’的程序性方向，该有向结构可区分审查步骤与发现结果。选项判断：可确认审查的具体产出为缺陷识别，排除其他无关结果。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_e39e1f28ae" value="CH02-S04 / card 2: Sophie 初始调查发现雇佣中间人" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_6f78434850" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_b799d2e011" value="&lt;b&gt;步骤：&lt;/b&gt;Sophie 进行初始调查&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000138&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_eb5dd15765" value="&lt;b&gt;产出：&lt;/b&gt;发现 FullTechGlobal&lt;br&gt;战略性地雇佣中间人以获取合同&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000138&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_1e3633d0c6" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_b799d2e011" target="v_eb5dd15765"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_4f51ebcf4f" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：Sophie 初始调查 → 发现公司战略性地雇佣中间人。KG不足：基础 KG 可将该事实作为案例说明，但无法表达调查动作与发现之间的程序性方向。选项判断：可确认调查的产出为识别特定行为模式。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH03-S02" id="page_9e97a68d98"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_f84a09f924" value="CH03-S02 Examples of predicate crimes &amp;gt; Environmental crime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_c732d48f54" value="status=missing_summary | cards=0 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_c14766c1cd" value="&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="780" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH03-S03" id="page_436205fe18"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_755ae2bc32" value="CH03-S03 Examples of predicate crimes &amp;gt; Drug trafficking" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_fdf6dddccf" value="status=missing_summary | cards=0 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_094b93d92c" value="&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;当前section均为毒品贩卖与洗钱的定义、事实和案例描述，未发现机构应对、条件分支或程序性有向结构。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="780" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH03-S07" id="page_709575bef5"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2530" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_766225609e" value="CH03-S07 Examples of predicate crimes &amp;gt; Case example: Mr. Wolfe’s scheme" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_6a87856ab4" value="status=missing_summary | cards=4 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_19fa021041" value="CH03-S07 / card 1: 金融机构检测非法活动" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_6580e66880" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_0e1eea38ae" value="&lt;b&gt;输入：&lt;/b&gt;交易监控系统标记：结构化存款、快速跨境分层和异常资金流动关联已知恐怖钱包&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000283&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_0bb8b971f6" value="&lt;b&gt;步骤：&lt;/b&gt;金融机构：通过交易监控系统检测到非法活动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000283&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_bef9a552ff" value="作为识别线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_0e1eea38ae" target="v_0bb8b971f6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_d008257dfe" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：交易监控系统标记（线索）支持金融机构检测非法活动；KG不足：基础KG可保存检测事实，但无法表达基于特定线索识别的有向关系；选项判断：可确认金融机构检测非法活动依赖于特定交易监控标记；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="347" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_30272ec25a" value="CH03-S07 / card 2: FIU综合信息触发红旗信号" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_e7dc42d416" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_fc78b14434" value="&lt;b&gt;步骤：&lt;/b&gt;金融情报机构（FIU）综合银行可疑交易报告与跨境金融活动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000285&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_55c1e9dc06" value="&lt;b&gt;产出：&lt;/b&gt;国际监管网络中触发红旗信号&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000285&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_2f44548be3" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_fc78b14434" target="v_55c1e9dc06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_84965a2231" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：FIU综合信息动作产生触发红旗信号的结果；KG不足：基础KG可保存综合与触发作为整体事实，但无法表达动作与结果的有向产出关系；选项判断：可确认红旗信号由FIU综合信息触发；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_0e61aa184d" value="CH03-S07 / card 3: FIU升级案件触发执法机构监控" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1345" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_2bcbefc6df" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1379" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_75370a8f5f" value="&lt;b&gt;触发：&lt;/b&gt;FIU升级案件&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000286&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1427" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_1d664db631" value="&lt;b&gt;步骤：&lt;/b&gt;执法机构：对嫌疑人进行针对性监控以追踪现金走私者和哈瓦拉网络&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000286&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1552" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_697adfd457" value="PRECEDES / 当FIU升级案件时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_75370a8f5f" target="v_1d664db631"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_b89c000d09" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：FIU升级案件作为前提条件，导致执法机构执行监控；KG不足：基础KG可保存升级和监控两个事实，但无法表达条件触发的有向顺序；选项判断：可确认执法机构监控是响应于FIU升级案件；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1672" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_ff566f1130" value="CH03-S07 / card 4: 执法机构资产冻结导致查封和瓦解" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1945" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_917de4a336" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1979" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_a415366d1b" value="&lt;b&gt;步骤：&lt;/b&gt;执法机构协调资产冻结以切断金融渠道&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000287&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2027" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_9aed14fe76" value="&lt;b&gt;产出：&lt;/b&gt;数字钱包被查封&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000287&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2152" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_a2b69e7e1e" value="&lt;b&gt;产出：&lt;/b&gt;Wolfe用于资助恐怖主义的公司被瓦解&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000287&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2244" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_a8182c44b9" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_a415366d1b" target="v_9aed14fe76"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_bfc4774258" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_a415366d1b" target="v_a2b69e7e1e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_b59d4705e7" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：执法机构资产冻结动作产生两个独立结果：查封数字钱包和瓦解公司；KG不足：基础KG可保存资产冻结及结果作为整体事实，但无法表达动作产出多结果的有向结构；选项判断：可确认查封和瓦解是资产冻结的直接结果；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2272" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH05-S02" id="page_b11a7ccfec"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_c50ea0c173" value="CH05-S02 Financial crime risks in relation to other types of risks &amp;gt; Case example: A lasting lesson" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_f7154751e8" value="status=missing_summary | cards=1 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_6658d80f4c" value="CH05-S02 / card 1: DPA要求触发的银行合规重组措施" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_d377f4bc8b" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_8ec536c8f6" value="&lt;b&gt;触发：&lt;/b&gt;美国司法部与汇丰达成五年延期起诉协议，要求全面整改全球合规运营&lt;br&gt;(Five-year deferred&lt;br&gt;prosecution agreement&lt;br&gt;mandating comprehensive&lt;br&gt;overhaul of global&lt;br&gt;compliance operations)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000358&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_0902f5527c" value="&lt;b&gt;步骤：&lt;/b&gt;汇丰银行被迫重新平衡组织权力，加强中央监督和合规职能，并限制地方业务部门自主权&lt;br&gt;(HSBC was compelled to&lt;br&gt;rebalance power dynamics,&lt;br&gt;strengthening central&lt;br&gt;oversight and compliance&lt;br&gt;functions while limiting the&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000362&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_15408fc62c" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_8ec536c8f6" target="v_0902f5527c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_c7b0d56c36" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：DPA要求全面整改（entry）→ 银行被迫执行加强中央监督和限制地方自治等具体措施（process）。KG不足：基础KG只能存储“汇丰达成DPA并采取了纠正措施”的事实，无法表达DPA作为外部命令约束金融机构实施特定结构改革的程序性有向关系。选项判断：可确认纠正措施的具体内容及其触发来源。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH05-S04" id="page_7033e60ae8"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_999ad80c66" value="CH05-S04 Financial crime risks in relation to other types of risks &amp;gt; Operational, legal, concentration, and reputational risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_c149d0fc24" value="status=missing_summary | cards=2 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_5406b01f27" value="CH05-S04 / card 1: 全球组织基于母国政策并适应东道国法律调整合规政策" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_550f057734" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_0c5bfc6bcb" value="&lt;b&gt;标准：&lt;/b&gt;母国监管政策&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000376&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_52c4867a27" value="&lt;b&gt;标准：&lt;/b&gt;东道国法律&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000376&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_f4503777a7" value="&lt;b&gt;步骤：&lt;/b&gt;全球组织通常调整合规政策&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000376&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_2023a74d00" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_0c5bfc6bcb" target="v_f4503777a7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_18305ce620" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_52c4867a27" target="v_f4503777a7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_f2328392fd" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：全球组织通常调整合规政策 --REFERENCES--&amp;gt; 母国监管政策（基础标准），全球组织通常调整合规政策 --REFERENCES--&amp;gt; 东道国法律（适应要求）；KG不足：基础KG可记录组织以母国政策为基础标准的事实，但无法表达调整过程中的标准约束关系；选项判断：可确认组织调整政策时需参照母国和东道国标准，排除不受标准约束的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="347" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_50e6144347" value="CH05-S04 / card 2: 法规错位触发合规计划更新" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_aa25be01e0" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_05b03c20ad" value="&lt;b&gt;触发：&lt;/b&gt;演变的法规与现有业务模型和控制错位&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000377&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_fbb8338c75" value="&lt;b&gt;步骤：&lt;/b&gt;合规计划必须持续更新&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000378&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_2d69c12abc" value="PRECEDES / 当法规与业务模型和控制错位时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_05b03c20ad" target="v_fbb8338c75"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_1f07edd662" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：演变的法规与业务模型错位 --PRECEDES(条件)--&amp;gt; 合规计划必须持续更新；KG不足：基础KG可能保存合规计划需更新的规则，但不能表达法规错位这一条件触发更新义务的有向链；选项判断：可确认法规错位是更新合规计划的触发条件，排除无条件更新的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH06-S09" id="page_b453eb51b9"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="3730" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_a074eef87e" value="CH06-S09 Money Laundering Risks in Financial Services &amp;gt; Politically exposed person risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_d7fa8b5a7f" value="status=missing_summary | cards=6 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_30d94c0391" value="CH06-S09 / card 1: PEP Identification Must Adhere to Local Regulatory Requirements" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_86c67fbd87" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_8022b5c329" value="&lt;b&gt;标准：&lt;/b&gt;当地监管要求&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000459&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_58f4c31a4c" value="&lt;b&gt;步骤：&lt;/b&gt;机构必须识别政治敏感人物&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000459&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_b67b499a7b" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_8022b5c329" target="v_58f4c31a4c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_3692f76616" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：机构识别PEP --REFERENCES--&amp;gt; 当地监管要求；KG不足：基础KG只能保存规则“机构必须遵守当地监管要求”，无法表达识别动作与标准之间的有向参照关系；选项判断：可确认识别PEP时必须参照当地监管要求这一义务；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="347" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_3a77ee8bfa" value="CH06-S09 / card 2: Organizations May Enforce Higher PEP Standards Based on Risk Appetite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_38f367a8cc" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_ad72d3faa3" value="&lt;b&gt;标准：&lt;/b&gt;风险偏好&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000460&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="827" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_b791b6e8e1" value="&lt;b&gt;步骤：&lt;/b&gt;机构可选择执行更高的PEP标准&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000460&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_13ab8d2338" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_ad72d3faa3" target="v_b791b6e8e1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_bca7110d54" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：机构可选择执行更高的PEP标准 --REFERENCES--&amp;gt; 风险偏好；KG不足：基础KG只能表达规则，无法表达风险偏好与可选动作之间的条件-动作有向关系；选项判断：可确认机构可基于风险偏好提高PEP标准；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="947" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_ef6548f1b3" value="CH06-S09 / card 3: Use a Broad Definition When Defining PEPs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1345" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_ca829edba4" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1379" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_3e47ac81e8" value="&lt;b&gt;标准：&lt;/b&gt;宽泛定义&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000467&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1427" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_ddc75f0c47" value="&lt;b&gt;步骤：&lt;/b&gt;机构应使用宽泛定义界定PEP&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000467&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1427" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_fc918c0862" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_3e47ac81e8" target="v_ddc75f0c47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_afccc3d9b7" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：定义PEP --REFERENCES--&amp;gt; 宽泛定义；KG不足：基础KG只能保存规则“应使用宽泛定义”，无法表达定义动作与标准的有向关系；选项判断：可确认定义PEP时应采用宽泛定义；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1547" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_9e79bc2c93" value="CH06-S09 / card 4: Some Organizations Follow Once a PEP Always a PEP Approach Due to Continued Influence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1945" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_6ccef12f92" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1979" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_7124fa8243" value="&lt;b&gt;触发：&lt;/b&gt;个人卸任后仍可能保持影响力&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000477&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2027" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_290d5aea39" value="&lt;b&gt;步骤：&lt;/b&gt;部分组织遵循“一旦是PEP，永远是PEP”的做法&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000477&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2152" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_43113b7a89" value="PRECEDES / because the individual may remain in the same circles of influence" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_7124fa8243" target="v_290d5aea39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_5a20dde963" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：个人卸任后仍可能保持影响力 --PRECEDES--&amp;gt; 部分组织遵循“一旦是PEP，永远是PEP”的做法；KG不足：基础KG只能表达部分组织采用该做法，无法表达触发条件；选项判断：可确认该做法的适用条件（保持影响力）；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2272" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_071cd006fa" value="CH06-S09 / card 5: Other Organizations Consider Influence and Duration When Assessing PEP Risk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="2545" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_830cdcb0bc" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="2579" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_0d7c164ef1" value="&lt;b&gt;输入：&lt;/b&gt;个人当时的影响力&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000479&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="2627" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_e75ccbb2bc" value="&lt;b&gt;输入：&lt;/b&gt;被归类为PEP的时间长短&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000480&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="2732" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_fde98f1e04" value="&lt;b&gt;步骤：&lt;/b&gt;其他组织评估PEP风险&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000478&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2627" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_54b9c43438" value="作为识别线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_0d7c164ef1" target="v_fde98f1e04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_96db3f41cd" value="作为识别线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_e75ccbb2bc" target="v_fde98f1e04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_e2883f7442" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：其他组织评估PEP风险 --REFERENCES--&amp;gt; 个人当时的影响力 和 被归类为PEP的时间长短；KG不足：基础KG只能列出这些因素，无法表达评估动作对这些因素的参照；选项判断：可确认评估PEP风险时的具体考量因素；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2747" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_396bcb03e5" value="CH06-S09 / card 6: Organizations Must Adapt Transaction Monitoring, KYC Reviews, and Escalate Based on Risk Appetite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="3145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_930f313f71" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="3179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_4182d35abb" value="&lt;b&gt;标准：&lt;/b&gt;风险偏好&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000482&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="3227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_e8581d4df7" value="&lt;b&gt;步骤：&lt;/b&gt;机构必须调整交易监控、KYC审查并升级处理&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000482&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="3227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_183f646a70" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4182d35abb" target="v_e8581d4df7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_6f34161308" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：机构必须调整交易监控、KYC审查并升级 --REFERENCES--&amp;gt; 风险偏好；KG不足：基础KG只能保存规则，无法表达动作与标准的有向关系；选项判断：可确认调整措施必须基于风险偏好；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="3347" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH06-S10" id="page_785a7f3ce8"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2530" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_a7cf1a80e7" value="CH06-S10 Money Laundering Risks in Financial Services &amp;gt; Control and ownership for AML compliance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_9b2c66568b" value="status=missing_summary | cards=4 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_a03e5f9484" value="CH06-S10 / card 1: 审查所有权结构时识别UBO的监管义务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_39be1fc063" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_83e898d3bb" value="&lt;b&gt;标准：&lt;/b&gt;监管义务：要求识别客户的UBO&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000488&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_8f7bae7214" value="&lt;b&gt;步骤：&lt;/b&gt;机构：在审查所有权结构时识别客户的UBO&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000488&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_5565315748" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_83e898d3bb" target="v_8f7bae7214"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_9c86e269b8" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：审查所有权结构 --触发--&amp;gt; 机构识别UBO，且该动作受监管义务约束。KG不足：基础KG只能将整句作为规则保存，无法表达条件-动作的动态关系以及标准约束动作的有向性。选项判断：可确认在审查所有权结构的情境下机构的识别义务。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="347" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_16a2856cf8" value="CH06-S10 / card 2: 识别间接持股以识别UBO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_5d832304c3" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_210d069227" value="&lt;b&gt;步骤：&lt;/b&gt;机构：识别直接和间接持股&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000493&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_d95072e3da" value="&lt;b&gt;步骤：&lt;/b&gt;机构：识别UBO&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000488, v7u_N000493&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_3fadffaf5a" value="PRECEDES / 为了识别UBO" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_210d069227" target="v_d95072e3da"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_a38204dae5" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：识别间接持股 --前提--&amp;gt; 识别UBO。KG不足：基础KG可保存&amp;#x27;为了识别UBO需要识别间接持股&amp;#x27;的知识，但无法表达这一前提-目的关系及步骤顺序。选项判断：可确认识别间接持股是识别UBO的必要步骤。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_93873ecc57" value="CH06-S10 / card 3: 无自然人UBO时识别控制人" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1345" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_6e5906a7df" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1379" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_d7a84e09ef" value="&lt;b&gt;触发：&lt;/b&gt;公司中不存在自然人受益所有人&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000496&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1427" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_8510a7c3e3" value="&lt;b&gt;步骤：&lt;/b&gt;机构：识别并核实控制人或名义受益所有人&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000496&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1552" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_8832bf63a0" value="PRECEDES / 当不存在自然人受益所有人时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_d7a84e09ef" target="v_8510a7c3e3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_eb673677d7" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：不存在自然人受益人 --条件--&amp;gt; 机构应识别控制人。KG不足：基础KG可保存该规则，但无法表达例外条件触发特定应对的有向关系。选项判断：可确认在无自然人UBO时的替代识别对象。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1672" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_bb6edd6fd4" value="CH06-S10 / card 4: 基于风险为本方法设定受益所有权阈值" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1945" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_78f2674790" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1979" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_26f7d0f756" value="&lt;b&gt;标准：&lt;/b&gt;风险为本方法&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000490&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="2027" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_6461131b2a" value="&lt;b&gt;标准：&lt;/b&gt;高风险客户阈值可低至10%，显著高风险可低至5%&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000491, v7u_N000492&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="2132" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_35945861d8" value="&lt;b&gt;步骤：&lt;/b&gt;机构：基于风险为本方法设定受益所有权阈值&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000490, v7u_N000491, v7u_N000492&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2027" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_33482ff114" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_26f7d0f756" target="v_35945861d8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_cf80023d65" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_6461131b2a" target="v_35945861d8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_780732b7ff" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：机构设定阈值 --受约束于--&amp;gt; 风险为本方法 及 高风险下阈值选项。KG不足：基础KG可分别保存各规则事实，但无法表达标准约束动作以及阈值选项作为设定参考的有向关系。选项判断：可确认机构设定阈值时必须采用风险为本方法，并需考虑高风险下的低阈值选项。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2147" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH07-S03" id="page_0cdb40b6eb"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_7b15abb761" value="CH07-S03 Money laundering risks associated with retail and commercial banking &amp;gt; Credit-related product risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_d301c62696" value="status=missing_summary | cards=2 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_6488196c3d" value="CH07-S03 / card 1: 不应接受非法还贷资金" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_5dabbded0e" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_a78790a887" value="&lt;b&gt;触发：&lt;/b&gt;银行知道或怀疑客户使用非法资金还贷&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000554&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_04889ffe89" value="&lt;b&gt;步骤：&lt;/b&gt;银行不应接受资金用于还贷&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000554&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_721c59fa70" value="PRECEDES / 如果银行知道或怀疑客户使用非法资金还贷" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_a78790a887" target="v_04889ffe89"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_da42d3eeab" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：银行知道或怀疑客户使用非法资金还贷 → 银行不应接受资金用于还贷；KG不足：基础KG只能表达“提前还贷可能涉及非法资金”的风险指标，无法表达条件触发特定主体义务的有向结构；选项判断：可确认或排除关于银行在知道或怀疑时应如何行动的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_2033652712" value="CH07-S03 / card 2: 退出客户关系时的核销贷款决策与批准要求" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_5591699601" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_6a2feac85e" value="&lt;b&gt;标准：&lt;/b&gt;需要广泛的理由和批准&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000555&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="827" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_87f4577134" value="&lt;b&gt;触发：&lt;/b&gt;退出超出风险容忍度的客户关系，且客户仍欠贷款余额&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000555&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_6c4b54d07d" value="&lt;b&gt;步骤：&lt;/b&gt;银行核销贷款&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000555&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_a16d3e0681" value="PRECEDES / 当退出超出风险容忍度的客户关系且客户仍有贷款余额时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_87f4577134" target="v_6c4b54d07d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_df95f3916a" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_6a2feac85e" target="v_6c4b54d07d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_3fa60e840e" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：当退出超出风险容忍度的客户关系且客户仍有贷款余额时，银行核销贷款（通常）需要广泛的理由和批准；KG不足：基础KG只能表达“核销贷款是重大财务决策”的事实，无法表达情境触发动作并受标准约束的有向关系；选项判断：可确认或排除关于退出客户关系时核销贷款需要什么条件的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH08-S05" id="page_9e18db0fd6"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_2c4170b133" value="CH08-S05 Private banking and wealth management risks &amp;gt; Special purpose vehicle risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_f17a34451e" value="status=missing_summary | cards=1 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_2b59f696c4" value="CH08-S05 / card 1: 金融机构对SPV和PIV的强化尽职调查（EDD）要求" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_b235f88b34" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_9c5713a32e" value="&lt;b&gt;标准：&lt;/b&gt;客户尽职调查（CDD）规则（如FinCEN CDD规则）&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000658&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_5f70e8d910" value="&lt;b&gt;步骤：&lt;/b&gt;金融机构必须对SPV和PIV进行强化尽职调查（EDD），识别最终受益所有人并了解其真实目的，并确保遵守CDD规则&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000658, v7u_N000659&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_e8e6870017" value="&lt;b&gt;产出：&lt;/b&gt;潜在金融犯罪风险可能得到缓解&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000660&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_3b55de15da" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_9c5713a32e" target="v_5f70e8d910"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3fb17d2f42" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_5f70e8d910" target="v_e8e6870017"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_431d63703c" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：金融机构必须进行EDD --REFERENCES--&amp;gt; CDD规则，且EDD --PRODUCES--&amp;gt; 可能减轻风险；KG不足：基础KG只能保存整体规则事实，无法表达主体义务导向标准和减轻风险结果的有向关系；选项判断：可确认或排除关于金融机构对SPV/PIV必须EDD及识别UBO的选项，并可判断风险减轻是EDD的预期效果；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>