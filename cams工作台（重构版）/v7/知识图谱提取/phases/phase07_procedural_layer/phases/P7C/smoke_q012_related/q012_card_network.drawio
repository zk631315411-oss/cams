        <mxCell id="c4202_001" value="p7card_CH42-S02_001&lt;br&gt;Customer risk assessment and due diligence routing&lt;br&gt;风险评级：低/中/高；高风险进入 EDD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="425" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4203_001" value="p7card_CH42-S03_001&lt;br&gt;Enhanced due diligence verification of wealth and funds claims&lt;br&gt;EDD：更深入核实财富来源、资金来源和支持文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="525" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4205_001" value="p7card_CH42-S05_001&lt;br&gt;Risk-based KYC refresh and EDD trigger&lt;br&gt;KYC refresh：风险升高可能触发 EDD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="625" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4205_002" value="p7card_CH42-S05_002&lt;br&gt;Transaction sanctions exposure screening response&lt;br&gt;交易制裁暴露筛查：发现风险则冻结/升级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="725" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4205_003" value="p7card_CH42-S05_003&lt;br&gt;Transaction monitoring for suspicious patterns&lt;br&gt;交易监控：识别异常行为、触发警报、动态调整风险画像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="825" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4206_001" value="p7card_CH42-S06_001&lt;br&gt;Customer risk assessment using parallel risk elements&lt;br&gt;客户画像 / 司法辖区 / 产品 / 渠道等并列风险要素" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="925" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4701_001" value="p7card_CH47-S01_001&lt;br&gt;Transaction monitoring alert generation and review&lt;br&gt;阈值/客户画像参数触发告警；审查异常是否可解释或可疑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="1025" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c0805_003" value="p7card_CH08-S05_003&lt;br&gt;Conduct EDD and CDD checks on SPVs and PIVs&lt;br&gt;对复杂结构/SPV/PIV 执行 CDD/EDD、UBO 和目的审查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="980" y="1125" width="520" height="80" as="geometry" />
        </mxCell>

        <mxCell id="controls" value="中间判断&lt;br&gt;已有控制措施：CDD / EDD / CRA / 持续筛查 / 交易监控&lt;br&gt;但“存在控制”不等于“控制有效”" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1600" y="550" width="330" height="170" as="geometry" />
        </mxCell>

        <mxCell id="col3" value="3. 控制有效性与剩余风险卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1600" y="805" width="520" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c3703_001" value="p7card_CH37-S03_001&lt;br&gt;Control effectiveness assessment and residual risk adjustment&lt;br&gt;评估控制有效性：正确应用/功能性/一致性 + 设计有效性 + 运行有效性&lt;br&gt;若 controls judged effective，剩余风险可降至 medium/low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0e6f6;strokeColor=#9673a6;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1600" y="880" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c3704_001" value="p7card_CH37-S04_001&lt;br&gt;Residual risk tolerance assessment and action plan development&lt;br&gt;剩余风险是否在 tolerance 内？不在则制定 action plan&lt;br&gt;措施、负责人、截止日期、复核频率、治理论坛" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1600" y="1030" width="520" height="120" as="geometry" />
        </mxCell>

        <mxCell id="formula" value="剩余风险评估核心&lt;br&gt;Residual risk = inherent risk - control effectiveness" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1600" y="330" width="410" height="95" as="geometry" />
