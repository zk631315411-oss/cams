      "card_nature": "control",
      "title": "Mitigate de-risking with risk-based controls",
      "summary": "When broad risk aversion would produce de-risking, organizations can use proportional, case-by-case controls and inclusion-supporting measures instead of broad exclusions.",
      "flow_nodes": [
        {
          "node_id": "n_trigger_broad_exclusion_risk",
          "node_type": "trigger",
          "label": "Broad risk-aversion decisions risk de-risking and conflict with proportional, risk-based management",
          "evidence_unit_ids": ["v7u_N003678", "v7u_N003679", "v7u_N003690"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_output_debanking_risk",
          "node_type": "output",
          "label": "Financial exclusion or de-banking can result, including loss of banking access for client categories",
          "evidence_unit_ids": ["v7u_N003680", "v7u_N003681", "v7u_N003682", "v7u_N003683"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_form_committee",
          "node_type": "action",
          "label": "Form a de-risking, reputational risk, or client selection committee with business, legal, and compliance members",
          "evidence_unit_ids": ["v7u_N003691"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_case_by_case_assessment",
          "node_type": "action",
          "label": "Conduct case-by-case individual risk assessments and reviews instead of categorizing entire sectors as high risk",
          "evidence_unit_ids": ["v7u_N003692"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_standardize_information",
          "node_type": "action",
          "label": "Develop sector-specific questionnaires to standardize information collection",
          "evidence_unit_ids": ["v7u_N003693"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_advanced_monitoring",
          "node_type": "action",
          "label": "Implement advanced transaction monitoring to improve transparency and efficiency",
          "evidence_unit_ids": ["v7u_N003694"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_stakeholder_discussions",
          "node_type": "action",
          "label": "Engage regulators and industry bodies to align expectations and reduce compliance burdens",
          "evidence_unit_ids": ["v7u_N003695"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_nuanced_tiers",
          "node_type": "action",
          "label": "Develop nuanced risk tiers that account for multiple factors beyond jurisdiction or nationality",
          "evidence_unit_ids": ["v7u_N003696"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_tiered_access",
          "node_type": "action",
          "label": "Provide tiered accounts with risk-appropriate transaction limits to support inclusion while managing exposure",
          "evidence_unit_ids": ["v7u_N003697"],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n_action_due_diligence",
          "node_type": "action",
          "label": "Conduct due diligence or EDD appropriate to sector or business-type risks",
