      "focal_question": "如何依据持股比例认定 UBO",
      "title": "根据直接和间接持股及阈值认定 UBO",
      "card_nature": "assessment",
      "elements": [
        {
          "element_id": "e001",
          "role": "context",
          "label": "审查客户所有权结构",
          "evidence_unit_ids": [
            "v7u_N000488"
          ],
          "modality": null
        },
        {
          "element_id": "e002",
          "role": "action",
          "label": "识别并合计直接和间接持股",
          "evidence_unit_ids": [
            "v7u_N000493",
            "v7u_N000494"
          ],
          "modality": null
        },
        {
          "element_id": "e003",
          "role": "standard",
          "label": "受益所有权识别阈值：25% 或以上",
          "evidence_unit_ids": [
            "v7u_N000489"
          ],
          "modality": null
        },
        {
          "element_id": "e004",
          "role": "decision",
          "label": "比较总持股与阈值，判断是否为 UBO",
          "evidence_unit_ids": [
            "v7u_N000494",
            "v7u_N000495"
          ],
          "modality": null
        },
        {
          "element_id": "e005",
          "role": "outcome",
          "label": "认定为 UBO",
          "evidence_unit_ids": [
            "v7u_N000494"
          ],
          "modality": null
        },
        {
          "element_id": "e006",
          "role": "outcome",
          "label": "不认定为 UBO",
          "evidence_unit_ids": [
            "v7u_N000495"
          ],
          "modality": null
        }
      ],
      "relations": [
        {
          "relation_id": "r001",
          "kind": "trigger",
          "trigger_mode": "condition",
          "trigger_element_id": "e001",
          "process_element_id": "e002",
          "condition": "当审查客户所有权结构时",
          "relation_type": "standard_transmits_requirement",
          "qualifier": null,
          "evidence_unit_ids": [
            "v7u_N000488"
          ],
          "source_quote": "When reviewing ownership structures, there is a regulatory obligation to identify the UBO of a customer."
        },
        {
          "relation_id": "r002",
          "kind": "sequence",
          "before_element_id": "e002",
          "after_element_id": "e004",
          "condition": null,
          "relation_type": null,
          "qualifier": null,
          "evidence_unit_ids": [
            "v7u_N000493"
          ],
          "source_quote": "In order to identify the UBOs of Company A, you need to identify indirect ownership stakes in addition to direct ownership."
        },
        {
          "relation_id": "r003",
          "kind": "reference",
          "process_element_id": "e004",
          "auxiliary_element_id": "e003",
          "condition": null,
          "relation_type": null,
          "qualifier": null,
          "evidence_unit_ids": [
            "v7u_N000489"
          ],
          "source_quote": "For AML purposes, most jurisdictions require beneficial ownership to be identified at a threshold of 25% or more."
        },
        {
          "relation_id": "r004",
          "kind": "branch",
          "decision_element_id": "e004",
          "target_element_id": "e005",
          "condition": "总持股达到或超过 25%",
          "relation_type": null,
          "qualifier": null,
          "evidence_unit_ids": [
            "v7u_N000494"
          ],
          "source_quote": "Individual D is then considered a UBO with 82% shareholding of Company A."
        },
        {
          "relation_id": "r005",
          "kind": "branch",
          "decision_element_id": "e004",
          "target_element_id": "e006",
          "condition": "总持股低于 25%",
          "relation_type": null,
          "qualifier": null,
          "evidence_unit_ids": [
            "v7u_N000495"
          ],
          "source_quote": "Individual C, who owns 10% of Company A directly and an additional 8% indirectly via their 10% ownership of Company B, is not a UBO."
        }
      ],
      "split_reason": null
    },
    {
