{
  "batch_start": 3768,
  "items": [
    {
      "i": 3768,
      "keep": true,
      "knowledge": "健全的客户尽职调查程序应包含可靠的客户身份识别和开户流程，以便金融组织确定客户的真实身份。",
      "type": "定义"
    },
    {
      "i": 3769,
      "keep": true,
      "knowledge": "组织应根据特定客户可能的风险来设定相应的身份识别标准。",
      "type": "流程"
    },
    {
      "i": 3770,
      "keep": true,
      "knowledge": "在某些国家或地区，有关当局发布了具体的法律法规，详细说明组织在客户身份识别方面应采取的措施。",
      "type": "法规"
    },
    {
      "i": 3771,
      "keep": true,
      "knowledge": "巴塞尔委员会指出银行应建立系统的客户身份识别与核实流程，适当时包括客户代理人和受益所有人的身份。",
      "type": "法规"
    },
    {
      "i": 3772,
      "keep": true,
      "knowledge": "巴塞尔委员会的建议适用于任何开立账户的金融组织。",
      "type": "事实"
    },
    {
      "i": 3773,
      "keep": true,
      "knowledge": "银行在建立银行业务关系或开展任何交易前必须按照金融行动特别工作组第10项建议充分确认并核实客户身份。",
      "type": "法规"
    },
    {
      "i": 3774,
      "keep": true,
      "knowledge": "组织应利用可靠、独立来源的文件、数据和信息，核实客户、受益所有人或其代理人的身份。",
      "type": "流程"
    },
    {
      "i": 3775,
      "keep": true,
      "knowledge": "受监管组织应该意识到某些身份文件更容易伪造。",
      "type": "事实"
    },
    {
      "i": 3776,
      "keep": true,
      "knowledge": "如果遇到易伪造文件或客户提交的文件信息存在不确定性，机构应提高核实要求并采取更多的问询及参考其他信息来源核实客户提供的信息。",
      "type": "流程"
    },
    {
      "i": 3777,
      "keep": true,
      "knowledge": "巴塞尔委员会在附录四《账户开立通用指南》中提供了开户和客户身份识别的指导意见。",
      "type": "事实"
    },
    {
      "i": 3778,
      "keep": true,
      "knowledge": "这份文件并未涵盖每种可能出现的情况。",
      "type": "事实"
    },
    {
      "i": 3779,
      "keep": true,
      "knowledge": "文件着重关注了一些方法，这些方法可供银行用来制定有效的客户身份识别与核实制度。",
      "type": "事实"
    },
    {
      "i": 3780,
      "keep": true,
      "knowledge": "附录将客户分为两类，一类为欲开立账户的自然人，一类为法人和法律安排。",
      "type": "分类"
    },
    {
      "i": 3781,
      "keep": true,
      "knowledge": "附录涵盖了针对两类客户分别应该收集和核实哪些类型的信息。",
      "type": "事实"
    },
    {
      "i": 3782,
      "keep": true,
      "knowledge": "欲开设个人账户的自然人新客户应该提供以下信息。",
      "type": "流程"
    },
    {
      "i": 3783,
      "keep": true,
      "knowledge": "自然人新客户应提供法定姓名及其他曾用名。",
      "type": "流程"
    },
    {
      "i": 3784,
      "keep": true,
      "knowledge": "自然人新客户应提供完整的居住地址，视风险等级提供公司地址或邮编。",
      "type": "流程"
    },
    {
      "i": 3785,
      "keep": true,
      "knowledge": "自然人新客户应提供固定电话或移动电话和电子邮件地址。",
      "type": "流程"
    },
    {
      "i": 3786,
      "keep": true,
      "knowledge": "自然人新客户应提供出生日期和出生地。",
      "type": "流程"
    },
    {
      "i": 3787,
      "keep": true,
      "knowledge": "自然人新客户应提供国籍和居民身份。",
      "type": "流程"
    },
    {
      "i": 3788,
      "keep": true,
      "knowledge": "自然人新客户应提供职业、职位和单位名称。",
      "type": "流程"
    },
    {
      "i": 3789,
      "keep": true,
      "knowledge": "自然人新客户应提供官方指定的个人身份证号或者其他的唯一身份识别号。",
      "type": "流程"
    },
    {
      "i": 3790,
      "keep": true,
