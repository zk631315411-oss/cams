{
  "batch_start": 1248,
  "items": [
    {
      "i": 1248,
      "keep": true,
      "knowledge": "商品基金经理人是汇集会员资金进行期货或期权合约交易的经理人或律师。",
      "type": "定义"
    },
    {
      "i": 1249,
      "keep": true,
      "knowledge": "期货经纪商是寻求或接受期货合约或商品期权订单并就订单执行收取佣金的公司或个人。",
      "type": "定义"
    },
    {
      "i": 1250,
      "keep": true,
      "knowledge": "商品中介经纪商是寻求或接受客户商品期货订单但不接受资金的公司或个人。",
      "type": "定义"
    },
    {
      "i": 1251,
      "keep": true,
      "knowledge": "商品中介经纪商分为担保经纪商和独立经纪商。",
      "type": "分类"
    },
    {
      "i": 1252,
      "keep": true,
      "knowledge": "担保中介经纪商是与期货经纪商签有排他性书面协议，且期货经纪商对其行为承担责任的中介经纪商。",
      "type": "定义"
    },
    {
      "i": 1253,
      "keep": true,
      "knowledge": "独立中介经纪商是须遵循最低资本和财务报告要求，可向任何期货经纪商引介客户的经纪商。",
      "type": "定义"
    },
    {
      "i": 1254,
      "keep": true,
      "knowledge": "投资顾问是就证券和投资提供建议并管理客户资产的人。",
      "type": "定义"
    },
    {
      "i": 1255,
      "keep": true,
      "knowledge": "投资和商品顾问行业被洗钱分子利用的方式有以下几种。",
      "type": "context"
    },
    {
      "i": 1256,
      "keep": true,
      "knowledge": "洗钱方式包括通过向无关联账户或高风险司法管辖区转账以撤回资产。",
      "type": "事实"
    },
    {
      "i": 1257,
      "keep": true,
      "knowledge": "洗钱方式包括经常性地向账户注入资产或从账户中提取资产。",
      "type": "事实"
    },
    {
      "i": 1258,
      "keep": true,
      "knowledge": "洗钱方式包括客户从与其不相关的第三方账户中使用支票提款或电汇形式进行投资。",
      "type": "事实"
    },
    {
      "i": 1259,
      "keep": true,
      "knowledge": "洗钱方式包括客户要求提供保管服务从而保持匿名。",
      "type": "事实"
    },
    {
      "i": 1260,
      "keep": true,
      "knowledge": "在离析计划中，资金先转移给投资顾问，之后再转入其他机构的账户。",
      "type": "事实"
    },
    {
      "i": 1261,
      "keep": true,
      "knowledge": "洗钱方式包括商品交易顾问或其他专业人员代客户投资非法所得。",
      "type": "事实"
    },
    {
      "i": 1262,
      "keep": true,
      "knowledge": "洗钱方式包括转移资金以隐匿其来源。",
      "type": "事实"
    },
    {
      "i": 1263,
      "keep": true,
      "knowledge": "信托和公司服务提供商是在各方之间建立信托并为公司提供某些法律和管理服务的守门人。",
      "type": "定义"
    },
    {
      "i": 1264,
      "keep": true,
      "knowledge": "金融行动特别工作组指出，信托和公司服务提供商包括向第三方提供特定服务的个人或企业。",
      "type": "context"
    },
    {
      "i": 1265,
      "keep": true,
      "knowledge": "信托和公司服务提供商的服务包括代表法人创建公司的代理机构。",
      "type": "事实"
    },
    {
      "i": 1266,
      "keep": true,
      "knowledge": "信托和公司服务提供商的服务包括担任或安排他人担任公司的董事或秘书、合伙制企业的合伙人或其他法人的类似职位。",
      "type": "事实"
    },
    {
      "i": 1267,
      "keep": true,
      "knowledge": "信托和公司服务提供商的服务包括为公司、合伙制企业或任何其他法人或组织提供注册办公地、营业场所或通讯地址。",
      "type": "事实"
    },
    {
      "i": 1268,
      "keep": true,
      "knowledge": "信托和公司服务提供商的服务包括担任或安排他人担任书面信托受托人。",
      "type": "事实"
    },
    {
      "i": 1269,
      "keep": true,
      "knowledge": "信托和公司服务提供商的服务包括担任或安排他人担任第三人的代名股东。",
      "type": "事实"
    },
    {
      "i": 1270,
      "keep": true,
      "knowledge": "金融行动特别工作组强调，信托和公司服务提供商应获取客户详细信息，了解资金来源及客户创建机构的一般目的。",
      "type": "法规"
    },
    {
      "i": 1271,
      "keep": true,
      "knowledge": "信托和公司服务提供商还应识别账户受益所有人和控制人的身份。",
      "type": "法规"
    }
  ]
}