  "node_type_reasons": {
    "ep_001": {
      "e001": "风险评估本身是一种评估动作，形成风险结论，对应P1_assessment",
      "e002": "风险评估的输出是特定的洗钱与恐怖融资风险，属于风险分类/结论，故X1_classification",
      "e003": "评估系统与控制相称性也是评估动作，产生判断，故P1_assessment",
      "e004": "相称性判断是决策/判断结论，虽然是decision角色但并无分支，语义上仍属评估结论，故P1_assessment"
    },
    "ep_002": {
      "e001": "企业银行交易作为处理对象进入，对应E2_object_entry",
      "e002": "判断需要强大的交易监控系统，是需求/适宜性结论，故P1_assessment",
      "e003": "预期结果是系统能够有效检测异常，使交易监控进入新的有效状态，故X3_state_change"
    },
    "ep_003": {
      "e001": "交易特征（金额高、复杂、涉及第三方）作为已观察到的状态/阈值，触发后续判断，故E3_state_threshold",
      "e002": "强调CDD的重要性，是对其地位的判断/评估，故P1_assessment"
    },
    "ep_004": {
      "e001": "直接对应标准/最佳实践，故standard",
      "e002": "投资培训是实施行为，执行已有计划，故P2_execution",
      "e003": "培训旨在让团队保持最新状态，是团队能力状态的更新，故X3_state_change"
    }
  },
