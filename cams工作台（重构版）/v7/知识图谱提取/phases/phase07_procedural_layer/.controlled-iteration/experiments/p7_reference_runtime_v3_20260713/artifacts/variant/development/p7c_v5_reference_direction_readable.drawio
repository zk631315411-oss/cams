" vertex="1" parent="1"><mxGeometry x="70" y="248" width="1360" height="34" as="geometry" /></mxCell><mxCell id="v_0ba0063ea9" value="CH06-S09 | Money Laundering Risks in Financial Services &amp;gt; Politically exposed person risks | status=ok, cards=4, errors=None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="294" width="1360" height="34" as="geometry" /></mxCell><mxCell id="v_56856bdc02" value="CH06-S10 | Money Laundering Risks in Financial Services &amp;gt; Control and ownership for AML compliance | status=ok, cards=2, errors=None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="1360" height="34" as="geometry" /></mxCell><mxCell id="v_72588906e8" value="CH07-S03 | Money laundering risks associated with retail and commercial banking &amp;gt; Credit-related product risks | status=ok, cards=2, errors=None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="386" width="1360" height="34" as="geometry" /></mxCell><mxCell id="v_284752d113" value="CH08-S05 | Private banking and wealth management risks &amp;gt; Special purpose vehicle risks | status=ok, cards=1, errors=None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="432" width="1360" height="34" as="geometry" /></mxCell><mxCell id="v_dd4bfba26f" value="CH12-S04 | Money laundering risks associated with insurance, securities, brokerage, and custodian services &amp;gt; Securities and brokerage risks | status=ok, cards=4, errors=None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x