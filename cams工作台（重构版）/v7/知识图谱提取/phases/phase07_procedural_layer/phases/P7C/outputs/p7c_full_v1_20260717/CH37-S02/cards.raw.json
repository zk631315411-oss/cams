          "edge_id": "edge_005",
          "edge_type": "REFERENCES",
          "source": "e002",
          "target": "e006",
          "evidence_unit_ids": [
            "v7u_N002747"
          ],
          "relation_type": "standard_constrains_action",
          "source_quote": "To determine product risk, consider the complexity, potential misuse, or attractiveness of the product for illicit activities."
