  "batch_start": 2400,
  "items": [
    {
      "i": 2400,
      "keep": true,
      "knowledge": "全美证券交易商协会 (NASD) 是根据美国证券交易委员会的授权负责监管纳斯达克股票市场的一个自律性组织。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 2401,
      "keep": true,
      "knowledge": "2002 年，该协会在《全美证券交易商协会致全体成员的特别通知》中指出了证券领域可疑洗钱活动的迹象特征，包括：",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2402,
      "keep": true,
      "knowledge": "客户似乎在充当未披露姓名的委托人的代理人，但在没有正当商业理由的情况下，拒绝或不愿意提供信息或回避谈论被代理的个人或实体。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2403,
      "keep": true,
      "knowledge": "在没有任何明显理由的情况下，客户拥有以一人或多人名义开立的多个账户，并拥有大量的账户间转账或第三方转账。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2404,
      "keep": true,
      "knowledge": "客户的账户有原因不明或突然增多的电汇，特别是以往很少有或几乎没有此类交易活动的账户。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2405,
      "keep": true,
      "knowledge": "客户存入资金的目的是购买长线投资工具，但不久后即要求清算头寸并将收益转出。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2406,
      "keep": true,
      "knowledge": "客户在没有任何明显商业目的的情况下，在无关账户之间涉及大量的日记账分录。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2407,
      "keep": true,
      "knowledge": "客户要求交易以特定方式进行以规避机构的正常记录要求。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2408,
      "keep": true,
      "knowledge": "客户在没有任何明显的理由或出现其他\"危险信号\"的情况下，从事涉及某些类型证券的交易， 如低价股票、\"S\" 规则股票、无记名债券等，这些证券虽然合法，但曾被用于与诈骗和洗钱等相关的活动。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2409,
      "keep": true,
      "knowledge": "客户账户存在原因不明的大量交易活动，但证券交易量很小。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2410,
      "keep": true,
      "knowledge": "借款人/买家提交无效文件，以撤销抵押债券或付清其贷款余额。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2411,
      "keep": true,
      "knowledge": "同一公证员和/或其他授权代表与数量异常的借款人合作及/或收取他们支付的款项。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2412,
      "keep": true,
      "knowledge": "伪造和开具以借款人/买家账户而非金融机构账户为担保的保付支票、银行本票或非现金项目支票。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2413,
      "keep": true,
      "knowledge": "借款人/买家为主要住所申请贷款，但并不住在贷款申请上填写的新主要住所。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2414,
      "keep": true,
      "knowledge": "其他个人占用借款人/买家的新主要住所，表明该物业目前为次要住所或创收物业。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2415,
      "keep": true,
      "knowledge": "公共文件和个人文件显示借款人/买家实住地与贷款申请上填写的地址不同，但借款人/买家仍提出主要住所再融资申请。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2416,
      "keep": true,
      "knowledge": "评估价值低、卖空买家和卖家之间存在不公平关系，且以前的做空交易中存在欺诈性抛卖行为，都属于异常的房地产活动。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2417,
      "keep": true,
      "knowledge": "买家或卖家在抵押贷款交易中的代理人未取得经营执照。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2418,
      "keep": true,
      "knowledge": "借款人/买家过去做出过虚假陈述，试图获取资金、物业、再融资和/或实施卖空。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2419,
      "keep": true,
      "knowledge": "文件手续不当/不完整，包括借款人/买家不愿提供更多信息并且/或者未兑现提供更多信息的承诺，均是异常活动。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2420,
      "keep": true,
      "knowledge": "重新提交的贷款申请明显是被拒绝过的申请，其中的关键借款人/买家明细信息从个人借款人改成了公司/ 企业，这可能表明，同一人试图以虚假手段，通过虚拟借款人或不存在的人员取得贷款。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2421,
      "keep": true,
      "knowledge": "借款人/买家试图拆分现金存款和取款，或以其他方式隐瞒或掩盖资产的真正价值，以达到面向存在经济困难的业主的贷款修改计划的要求。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2422,
      "keep": true,
      "knowledge": "代表存在经济困难的业主的第三方关联机构要求接受抵押贷款咨询、止赎规避、贷款修改或其他相关服务的业主提前付费。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2423,
      "keep": true,
      "knowledge": "第三方诱使存在经济困难的业主接受所谓的抵押贷款咨询、止赎规避、贷款修改或其他相关服务。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2424,
      "keep": true,
      "knowledge": "这些第三方也可能自称是合法抵押贷款人、美国政府或美国政府计划的关联方。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2425,
      "keep": true,
      "knowledge": "金融行动特别工作组发布的报告 描述了与交易实务相关的交易性和其他危险信号标志，包括：",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2426,
      "keep": true,
      "knowledge": "钻石来源国的钻石产量有限，或者根本没有钻石矿。",
