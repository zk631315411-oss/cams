{
  "batch_start": 2000,
  "items": [
    {
      "i": 2000,
      "keep": true,
      "knowledge": "母行不知道客户组合的结构，是因为没有综合客户名单，并且依赖爱沙尼亚分行提供的信息。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2001,
      "keep": true,
      "knowledge": "在八年的时间里，爱沙尼亚分行处理了约 2000 亿美元的交易，其中大部分后来被监管机构认定为可疑交易。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2002,
      "keep": true,
      "knowledge": "根据爱沙尼亚金融监管局 (FSA) 的命令，爱沙尼亚分行于 2019 年关闭。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 2003,
      "keep": true,
      "knowledge": "丹斯克银行在多个领域违反了反洗钱/反恐融资规定。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2004,
      "keep": true,
      "knowledge": "在收购三普银行之后，爱沙尼亚分行从未整合到集团的 IT 合规基础设施中。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 2005,
      "keep": true,
      "knowledge": "集团范围内的反洗钱和\"了解您的客户\"政策及程序未与爱沙尼亚分行共享。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2006,
      "keep": true,
      "knowledge": "这一疏忽导致丹斯克银行内部\"了解您的客户\"的执行支离破碎且不一致。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2007,
      "keep": true,
      "knowledge": "调查人员发现，爱沙尼亚分行员工对洗钱风险的了解有限，其反洗钱控制存在重大缺陷。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2008,
      "keep": true,
      "knowledge": "爱沙尼亚分行仅专注于信用风险，对\"了解您的客户\"的执行有限。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2009,
      "keep": true,
      "knowledge": "他们未发现洗钱、恐怖融资、制裁或逃税风险，且\"了解您的客户\"、反洗钱及风险管理部门未与集团整合。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2010,
      "keep": true,
      "knowledge": "丹斯克银行没有履行其法律义务，并且低估了其客户组合的风险。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2011,
      "keep": true,
      "knowledge": "该行未能采用符合法律法规及其集团要求的增强型尽职调查措施。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 2012,
      "keep": true,
      "knowledge": "例如，它没有对收到的付款进行制裁筛查、没有进行政治人物筛查，也没有对可疑客户及交易做出回应。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 2013,
      "keep": true,
      "knowledge": "这一可疑的犯罪活动已上报给丹斯克银行的高级管理层，但该行进行的内部审计却没有发现可疑的洗钱行为，因此也没有采取进一步的行动。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2014,
      "keep": true,
      "knowledge": "反洗钱专员必须在其公司（包括分支机构和子公司）内整合组织的反洗钱/反恐融资和 KYC框架。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 2015,
      "keep": true,
      "knowledge": "他们应开展全面彻底的风险评估，确保实施适当的客户风险评级方法。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2016,
      "keep": true,
      "knowledge": "必须在全组织范围内实施政策和程序，确保反洗钱/反恐融资和\"了解您的客户\"流程稳健一致，包括在适当时应用增强尽职调查。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 2017,
      "keep": true,
      "knowledge": "需要整合筛查客户和识别可疑活动的 IT 系统，以支持流程和风险管理，包括整体风险视图。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2018,
      "keep": true,
      "knowledge": "各组织必须立即将新收购公司的反洗钱/反恐融资和\"了解您的客户\"框架与全面的风险评估整合起来。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2019,
      "keep": true,
      "knowledge": "各组织应在全组织范围内实施反洗钱/反恐融资和\"了解您的客户\"政策和程序。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2020,
      "keep": true,
      "knowledge": "各组织需要有一致的客户风险评级方法。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2021,
      "keep": true,
      "knowledge": "各组织需要制定健全且一致的\"了解您的客户\"流程，包括增强尽职调查。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 2022,
      "keep": true,
      "knowledge": "专责反洗钱团队应独立于业务部门。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2023,
      "keep": true,
      "knowledge": "应在整个组织中建立强大的反洗钱文化，并由高级管理层给予明确的监督和指导。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2024,
      "keep": true,
      "knowledge": "如果金融组织执行的客户尽职调查制度过于分散，将导致其面临的洗钱和恐怖融资风险大幅上升。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2025,
      "keep": true,
      "knowledge": "为确保执行有效的客户尽职调查制度，金融组织可以采取的措施为：在组织层面统一并简化账户开立程序并对交易流程进行持续监控。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 2026,
      "keep": true,
      "knowledge": "如果可行，该方法应在国内和国外同时应用。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2027,
      "keep": true,
      "knowledge": "政府间机构已经意识到实施一体化的客户尽职调查的重要性，也已为金融机组织定了专门的指导意见。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2028,
      "keep": true,
      "knowledge": "根据巴塞尔委员会的要求，全球客户尽职调查风险管理制度应包括：在全球范围内对客户账户进行跨越业务领域和地理区位的持续识别和监控，同时在母公司层面进行监管，以便发现那些在其他情况下可能无法侦测的异常交易事例和模式。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2029,
      "keep": true,
      "knowledge": "该委员会表示，对客户信息进行此等全面处理可以侦测潜在的有害活动并大大提高组织的整体声誉风险、集中风险、操作风险和法律风险管理水平。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2030,
      "keep": true,
      "knowledge": "金融组织应努力将一体化的客户接纳政策、客户身份识别程序、高风险账户监控流程和风险管理框架运用到其所有办事处、分支机构和附属机构。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2031,
      "keep": true,
      "knowledge": "组织应通过持续的培训活动、定期交流明确传达这些政策和流程，以及监控和测试来确保符合政策和流程的要求。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 2032,
      "keep": true,
      "knowledge": "组织的每个办事处、分支机构和附属机构都应遵守母公司实施的最低客户身份识别和接受标准。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2033,
      "keep": true,
      "knowledge": "但是，为了符合当地监管要求和相关风险因素（如：某些地区的洗钱、恐怖融资和腐败风险较高），不同司法管辖区的信息收集和保存方式可存在差别。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2034,
      "keep": true,
      "knowledge": "如果母国和东道国在客户尽职调查的最低标准上存在差异，那么位于东道国司法管辖区的办事处应该采用两者之中较高的标准。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2035,
      "keep": true,
      "knowledge": "如果上述要求无法落实，则组织应与母公司和律师协商以执行适当且有效的客户尽职调查标准。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2036,
      "keep": true,
      "knowledge": "经济制裁从经济方面孤立制裁\"目标\"，从而影响司法管辖区或集团的行为。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 2037,
      "keep": true,
      "knowledge": "与军事打击相比，各国越来越倾向于使用经济制裁作为一种对外政策。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 2038,
      "keep": true,
      "knowledge": "一般，经济制裁可分为以下几类：",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 2039,
      "keep": true,
      "knowledge": "针对性制裁措施：针对特定人员，如某国或某地区的重要领导人、特定恐怖分子、重大毒品走私犯罪分子和大规模杀伤性武器扩散分子。",
      "type": "法规",
      "local_label": true
    }
  ],
  "label_source": "local_rules"
}