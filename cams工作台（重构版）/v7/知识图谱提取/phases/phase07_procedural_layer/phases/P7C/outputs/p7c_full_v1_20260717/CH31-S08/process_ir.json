          "modality": "prohibited"
        }
      ],
      "relations": [
        {
          "relation_id": "r001",
          "kind": "trigger",
          "trigger_mode": "event",
          "trigger_element_id": "e001",
          "process_element_id": "e002",
          "condition": null,
          "relation_type": "conclusion_triggers_response",
          "qualifier": null,
          "evidence_unit_ids": [
            "v7u_N002291"
          ],
          "source_quote": "Since the UK’s withdrawal from the EU on January 31, 2020, it can no longer accept EIOs."
