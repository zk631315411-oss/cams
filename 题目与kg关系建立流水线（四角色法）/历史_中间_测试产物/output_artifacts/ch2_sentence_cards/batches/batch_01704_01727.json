      "keep": true,
      "knowledge": "空架公司是不进行任何经营活动的公司。",
      "type": "定义"
    },
    {
      "i": 1721,
      "keep": true,
      "knowledge": "空架公司创建后便'束之高阁'。",
      "type": "事实"
    },
    {
      "i": 1722,
      "keep": true,
