{
  "batch_start": 1392,
  "items": [
    {
      "i": 1392,
      "keep": true,
      "knowledge": "贸易洗钱是犯罪活动的重要渠道，随着国际贸易增加，其作为洗钱和恐怖融资手段的吸引力也增加。",
      "type": "事实"
    },
    {
      "i": 1393,
      "keep": true,
      "knowledge": "随着其他洗钱手段的标准日益有效，贸易洗钱手段将更具吸引力。",
      "type": "事实"
    },
    {
      "i": 1394,
      "keep": true,
      "knowledge": "香港银行公会制定《打击贸易洗钱指引文件》，指出了解每笔贸易交易的商业目的是明确洗钱风险的关键要求。",
      "type": "法规"
    },
    {
      "i": 1395,
      "keep": true,
      "knowledge": "指引文件列举了六种利用贸易洗钱的手段。",
      "type": "分类"
    },
    {
      "i": 1396,
      "keep": true,
      "knowledge": "高开发票指卖方以高于市场公平价格开具发票，从买方处谋取差价利润。",
      "type": "定义"
    },
    {
      "i": 1397,
      "keep": true,
      "knowledge": "高开发票情境下，商品或服务售价高于买方在公开市场收取的价格。",
      "type": "事实"
    },
    {
      "i": 1398,
      "keep": true,
      "knowledge": "低开发票指以低于公平市场价格为商品或服务开具发票。",
      "type": "定义"
    },
    {
      "i": 1399,
      "keep": true,
      "knowledge": "低开发票手段中，卖方通过低于公开市场售价将差额价值转移给买方。",
      "type": "事实"
    },
    {
      "i": 1400,
      "keep": true,
      "knowledge": "超量装载或装载不足指发票记录的商品数量与实际装载数量有出入，使买方或卖方谋取差额利润。",
      "type": "定义"
    },
    {
      "i": 1401,
      "keep": true,
      "knowledge": "空箱运载指买卖双方共谋虚假贸易，伪造文件显示商品已售已发货，但实际未发送任何商品。",
      "type": "定义"
    },
    {
      "i": 1402,
      "keep": true,
      "knowledge": "空壳公司用于降低交易所有权的透明度。",
      "type": "事实"
    },
    {
      "i": 1403,
      "keep": true,
      "knowledge": "多次开票指对同一批装载商品开具数张发票，使洗钱犯罪分子借机支付数笔款项。",
      "type": "定义"
    },
    {
      "i": 1404,
      "keep": true,
      "knowledge": "黑市贸易中，外国进口商利用境内转账支付货款。",
      "type": "定义"
    },
    {
      "i": 1405,
      "keep": true,
      "knowledge": "信用证是另一洗钱手段。",
      "type": "事实"
    },
    {
      "i": 1406,
      "keep": true,
      "knowledge": "信用证是由银行签发的信用票据，保证在满足某些条件时代客户向第三方付款。",
      "type": "定义"
    },
    {
      "i": 1407,
      "keep": true,
      "knowledge": "信用证通常用于为出口提供融资，为出口商提供付款保障。",
      "type": "事实"
    },
    {
      "i": 1408,
      "keep": true,
      "knowledge": "买方的银行将信用证转给付款所在地的代理银行。",
      "type": "流程"
    },
    {
      "i": 1409,
      "keep": true,
      "knowledge": "商品装运、进口港收货、清关并发运后，出口商通过信用证收取货款。",
      "type": "流程"
    },
    {
      "i": 1410,
      "keep": true,
      "knowledge": "洗钱者可以利用信用证将资金从外汇控制措施不严的国家转出，造成开展进口交易活动的假象。",
      "type": "事实"
    },
    {
      "i": 1411,
      "keep": true,
      "knowledge": "在通过操纵进出口价格进行洗钱时，信用证也可以作为一个幌子。",
      "type": "事实"
    },
    {
      "i": 1412,
      "keep": true,
      "knowledge": "另一种非法利用信用证的方法为通过电汇，将根本不存在的贸易活动伪装成合法活动。",
      "type": "事实"
    },
    {
      "i": 1413,
      "keep": true,
      "knowledge": "亚太反洗钱工作组指出，缺乏可靠的贸易洗钱数据资料是妨碍制定解决方案的重要因素。",
      "type": "事实"
    },
    {
      "i": 1414,
      "keep": true,
      "knowledge": "为便于识破贸易洗钱，工作组列举了司法管辖区、商品、公司结构和上游犯罪等方面的具体特点和危险信号。",
      "type": "分类"
    },
    {
      "i": 1415,
      "keep": true,
      "knowledge": "预防或打击贸易洗钱的策略必须旨在瓦解贸易洗钱结构，同时保证合法贸易不受阻碍。",
      "type": "事实"
    }
  ]
}