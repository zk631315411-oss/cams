mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_1a30baadd5" value="&lt;b&gt;标准：&lt;/b&gt;Engage external legal&lt;br&gt;counsel for serious&lt;br&gt;investigations&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003470, v7u_N003471&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_359e40ecc3" value="&lt;b&gt;标准：&lt;/b&gt;Ad-hoc committee with clear&lt;br&gt;governance for external&lt;br&gt;investigation response&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003472&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_b7c6a57b77" value="&lt;b&gt;标准：&lt;/b&gt;Clear reporting lines and&lt;br&gt;escalation processes&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003473&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="752" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_c91c0e55b9" value="&lt;b&gt;标准：&lt;/b&gt;Internal and press&lt;br&gt;communication plans&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003473&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="857" 