          "edge_type": "REFERENCES",
          "source": "e002",
          "target": "e004",
          "evidence_unit_ids": [
            "v7u_N002745"
          ],
          "relation_type": "standard_constrains_action",
          "source_quote": "For customers, risk rating generally considers their industry, transaction volume, corruption index, and geographic location."
