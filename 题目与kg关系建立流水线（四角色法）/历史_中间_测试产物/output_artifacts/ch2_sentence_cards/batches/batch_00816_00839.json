{
  "batch_start": 816,
  "items": [
    {
      "i": 816,
      "keep": true,
      "knowledge": "与证券行业尤为相关的可疑信号包括一系列行为模式。",
      "type": "context"
    },
    {
      "i": 817,
      "keep": true,
      "knowledge": "证券公司老客户突然变现所有资产并转移财富是可疑信号。",
      "type": "风险指标"
    },
    {
      "i": 818,
      "keep": true,
      "knowledge": "客户不顾损失或费用开立账户或购买产品，包括提前取消长期证券，是可疑信号。",
      "type": "风险指标"
    },
    {
      "i": 819,
      "keep": true,
      "knowledge": "证券账户用于支付或电汇但交易活动很少，是可疑信号。",
      "type": "风险指标"
    },
    {
      "i": 820,
      "keep": true,
      "knowledge": "客户交易持续损失可能是将价值转移至另一方的信号。",
      "type": "风险指标"
    },
    {
      "i": 821,
      "keep": true,
      "knowledge": "一方高价购进但亏本出售给另一方的交易可能是价值转移的信号。",
      "type": "风险指标"
    },
    {
      "i": 822,
      "keep": true,
      "knowledge": "客户不熟悉金融产品详情却仍希望投资是可疑信号。",
      "type": "风险指标"
    },
    {
      "i": 823,
      "keep": true,
      "knowledge": "客户有亲友在证券发行商工作或交易模式显示可能掌握非公开信息是可疑信号。",
      "type": "风险指标"
    },
    {
      "i": 824,
      "keep": true,
      "knowledge": "同家证券公司的多个不相关账户突然同时交易非流动或低价证券是可疑信号。",
      "type": "风险指标"
    },
    {
      "i": 825,
      "keep": true,
      "knowledge": "客户存入数量多、账户名称异常、未制定约束性说明或获得方式不合理的证券是可疑信号。",
      "type": "风险指标"
    },
    {
      "i": 826,
      "keep": true,
      "knowledge": "零售证券经销商是产业前沿防线，也是最脆弱的地带。",
      "type": "事实"
    },
    {
      "i": 827,
      "keep": true,
      "knowledge": "管理层经常向零售证券经销商施压，要求开发更多客户和资产。",
      "type": "事实"
    },
    {
      "i": 828,
      "keep": true,
      "knowledge": "客户账户中的资产越多，证券经销商获得的佣金就越多。",
      "type": "事实"
    },
    {
      "i": 829,
      "keep": true,
      "knowledge": "洗钱者可能通过允诺高额或固定佣金来利用证券经销商。",
      "type": "事实"
    },
    {
      "i": 830,
      "keep": true,
      "knowledge": "证券经销商有必要了解交易对象并监控客户可疑活动。",
      "type": "事实"
    },
    {
      "i": 831,
      "keep": true,
      "knowledge": "美国SEC和FINRA在《银行保密法》指引下对证券经销商提出反洗钱要求。",
      "type": "法规"
    },
    {
      "i": 832,
      "keep": true,
      "knowledge": "要求证券经销商执行反洗钱制度，包括委任专员、客户尽职调查、可疑活动监控、培训和独立审计。",
      "type": "法规"
    },
    {
      "i": 833,
      "keep": true,
      "knowledge": "证券经销商受证监会、金融业监管局或二者同时监管，以监控其遵守反洗钱制度情况。",
      "type": "法规"
    },
    {
      "i": 834,
      "keep": true,
      "knowledge": "反洗钱制度存在缺陷或未制定的证券经销商可能面临巨额罚款及刑事处罚。",
      "type": "法规"
    },
    {
      "i": 835,
      "keep": true,
      "knowledge": "2017年英国FCA对德意志银行处以1.63亿英镑罚款，因其2012至2015年缺乏充分反洗钱控制框架。",
      "type": "案例"
    },
    {
      "i": 836,
      "keep": true,
      "knowledge": "德意志银行未能获取充足客户信息以开展风险评估和实施有效交易监控。",
      "type": "案例"
    },
    {
      "i": 837,
      "keep": true,
      "knowledge": "德意志银行俄罗斯子公司前台在2012年4月至2014年10月执行了2400多对镜像交易。",
      "type": "案例"
    },
    {
      "i": 838,
      "keep": true,
      "knowledge": "金融行为监管局认定德意志银行的反洗钱控制框架存在严重缺陷。",
      "type": "案例"
    },
    {
      "i": 839,
      "keep": true,
      "knowledge": "德意志银行英国企业银行和证券部存在严重缺陷，导致镜像交易顺利执行。",
      "type": "案例"
    }
  ]
}