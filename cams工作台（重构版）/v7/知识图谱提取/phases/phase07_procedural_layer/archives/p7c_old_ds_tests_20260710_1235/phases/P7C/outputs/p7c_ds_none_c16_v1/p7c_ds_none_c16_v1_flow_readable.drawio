x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_567f06a392" value="CH49-S06 / card 1: SAR submission requirements" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_b28c16098e" value="nature=control | review=accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_9f2e9e9be6" value="&lt;b&gt;标准：&lt;/b&gt;Provide clear communication,&lt;br&gt;evidence-based analysis, and&lt;br&gt;strict compliance protocols&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003556&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_71abf2aab7" value="&lt;b&gt;标准：&lt;/b&gt;Use headings, bullet points,&lt;br&gt;and logical sequencing to&lt;br&gt;simplify complex details&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003557&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_21036d7d03" value="&lt;b&gt;标准：&lt;/b&gt;Write in plain English and&lt;br&gt;highlight contradictions to&lt;br&gt;justify concerns&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003558&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor