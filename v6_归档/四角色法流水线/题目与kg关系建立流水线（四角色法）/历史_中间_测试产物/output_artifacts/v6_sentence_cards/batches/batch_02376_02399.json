{
  "batch_start": 2376,
  "items": [
    {
      "i": 2376,
      "keep": true,
      "knowledge": "银行应定期对整个机构进行审计。",
      "type": "流程"
    },
    {
      "i": 2377,
      "keep": true,
      "knowledge": "审计应设定适当范围以评估制度有效性，包括适时使用外部审计机构。",
      "type": "流程"
    },
    {
      "i": 2378,
      "keep": true,
      "knowledge": "审计应积极跟进其结论和建议。",
      "type": "流程"
    },
    {
      "i": 2379,
      "keep": true,
      "knowledge": "银行应制定客户接纳政策，明确高风险客户及拒不接纳的客户关系。",
      "type": "流程"
    },
    {
      "i": 2380,
      "keep": true,
      "knowledge": "银行应对所有客户执行基本尽职调查，并根据风险等级调整程度。",
      "type": "流程"
    },
    {
      "i": 2381,
      "keep": true,
      "knowledge": "低洗钱风险客户可能仅需接受简化尽职调查。",
      "type": "事实"
    },
    {
      "i": 2382,
      "keep": true,
      "knowledge": "第三方数据或中央数据库有助于收集客户信息及评估风险指标。",
      "type": "事实"
    },
    {
      "i": 2383,
      "keep": true,
      "knowledge": "中央数据库应指明最后更新日期及与信息来源最后一次确认的日期。",
      "type": "事实"
    },
    {
      "i": 2384,
      "keep": true,
      "knowledge": "中央数据库应指明信息来源。",
      "type": "事实"
    },
    {
      "i": 2385,
      "keep": true,
      "knowledge": "客户尽职调查政策应旨在确定和核实客户及受益所有人，并建立风险档案。",
      "type": "流程"
    },
    {
      "i": 2386,
      "keep": true,
      "knowledge": "银行应识别客户及受益所有人，并核实他们的身份。",
      "type": "流程"
    },
    {
      "i": 2387,
      "keep": true,
      "knowledge": "核实客户身份主要分为四个步骤。",
      "type": "流程"
    },
    {
      "i": 2388,
      "keep": true,
      "knowledge": "第一步：识别客户及任何受益所有人或授权签字人。",
      "type": "流程"
    },
    {
      "i": 2389,
      "keep": true,
      "knowledge": "第二步：评估客户风险档案信息。",
      "type": "流程"
    },
    {
      "i": 2390,
      "keep": true,
      "knowledge": "第三步：利用可靠文件和/或非文件来源核实客户及任何受益所有人或授权签字人身份。",
      "type": "流程"
    },
    {
      "i": 2391,
      "keep": false,
      "knowledge": "",
      "type": "context"
    },
    {
      "i": 2392,
      "keep": true,
      "knowledge": "第四步：进一步实施基于风险的核实工作，如核实财富来源和资金来源。",
      "type": "流程"
    },
    {
      "i": 2393,
      "keep": true,
      "knowledge": "对于个人，应收集的信息至少包括法定姓名、住址、独特身份证号、出生日期和地点。",
      "type": "事实"
    },
    {
      "i": 2394,
      "keep": true,
      "knowledge": "根据风险状况，可能还需收集其他曾用名、居住状况和单位地址。",
      "type": "事实"
    },
    {
      "i": 2395,
      "keep": true,
      "knowledge": "准确评估客户风险需收集职业、收入、账户预期用途及所需产品等信息。",
      "type": "事实"
    },
    {
      "i": 2396,
      "keep": true,
      "knowledge": "银行可根据文件和非文件方式核实客户提供的信息。",
      "type": "流程"
    },
    {
      "i": 2397,
      "keep": true,
      "knowledge": "文件证明方式包括使用政府签发的带照片身份证件或确认住址的账单。",
      "type": "事实"
    },
    {
      "i": 2398,
      "keep": true,
      "knowledge": "非文件证明方式包括使用公共登记处、私营数据库及其他可靠独立信息来源。",
      "type": "事实"
    },
    {
      "i": 2399,
      "keep": true,
      "knowledge": "高风险客户应采取进一步核实措施，如核实收入来源、就业状况或个人喜好。",
      "type": "流程"
    }
  ]
}