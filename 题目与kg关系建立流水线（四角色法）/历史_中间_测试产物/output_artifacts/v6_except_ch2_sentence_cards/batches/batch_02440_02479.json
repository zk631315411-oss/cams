  "items": [
    {
      "i": 2440,
      "keep": true,
      "knowledge": "钻石交易商付款的收款人名称不是出口商/供应商。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2441,
      "keep": true,
      "knowledge": "与往来交易无关的第三方几乎可以通过任何方式（例如现金、电汇、支票或银行汇票）进行付款。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 2442,
      "keep": true,
      "knowledge": "以拆分交易的方式向个人活期存款账户存入资金，在一天之内多次向同一家银行不同分支机构的多个账户存入款项。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2443,
      "keep": true,
      "knowledge": "发票中描述的货物或商品与装运的实物商品有差异。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2444,
      "keep": true,
      "knowledge": "无故修改信用证。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2445,
      "keep": true,
      "knowledge": "双方和交易之间无明显的业务关系。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2446,
      "keep": true,
      "knowledge": "经常进行舍入金额或整数金额的交易。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2447,
      "keep": true,
      "knowledge": "转入账户的资金被等额转移到高风险国家。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2448,
      "keep": true,
      "knowledge": "公司在其商业目的未得到全面理解并且难以确定所有权的司法管辖区开展业务。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2449,
      "keep": true,
      "knowledge": "交易缺少相应的支撑文件。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2450,
      "keep": true,
      "knowledge": "用不记名金融票据支付连号交易和/或无付款人信息的交易的款项。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2451,
      "keep": true,
      "knowledge": "据金融犯罪执法网络称，以下是关于人口走私的危险信号：",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2452,
      "keep": true,
      "knowledge": "多笔电汇（通常低于 3,000 美元报告限额）从美国各地流向西南边境沿线的美国或墨西哥城市的同一受益人。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2453,
      "keep": true,
      "knowledge": "同一日或连续几日在同一金融机构的不同分行，有多笔电汇转入或转出西南边境沿线的美国或墨西哥城市。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2454,
      "keep": true,
      "knowledge": "不符合常见汇款规律的资金流动：",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2455,
      "keep": true,
      "knowledge": "源于高移民比例国家（如墨西哥、危地马拉、萨尔瓦多、洪都拉斯）的电汇流向西南边境沿线的美国或墨西哥城市的受益人。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2456,
      "keep": true,
      "knowledge": "从高移民比例国家（如墨西哥、危地马拉、萨尔瓦多、洪都拉斯）收到电汇的受益人并不是这些国家的国民。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2457,
      "keep": true,
      "knowledge": "巨额现金存入美国金融组织，然后以电汇方式转移到高移民比例国家（如墨西哥、危地马拉、萨尔瓦多、洪都拉斯），与预期客户活动不相符。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 2458,
      "keep": true,
      "knowledge": "这可能包括现金存款突然增加，资金快速周转，资金来源不明的大额现金存款。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 2459,
      "keep": true,
      "knowledge": "显然没有关系的多位客户向同一受益人电汇资金，该受益人可能位于西南边境沿线的美国或墨西哥城市。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2460,
      "keep": true,
      "knowledge": "这些客户也可能使用相似的交易信息，包括但不限于相同的金额、地址和电话号码。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 2461,
      "keep": true,
      "knowledge": "在条件允许的情况下进行询问时，这些客户可能与收款人没有明显的关系，或者不知道电汇的目的。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2462,
      "keep": true,
      "knowledge": "客户账户似乎是流入账户，办理现金存款（通常低于 10,000 美元的报告限额）的城市/州不是客户居住地或业务所在地。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2463,
      "keep": true,
      "knowledge": "在流入账户的情况下，资金通常在存入后被迅速取出（同一日）。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2464,
      "keep": true,
      "knowledge": "从可能的流入账户存入的支票似乎是预签，签字栏和付款人栏的笔迹不同。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2465,
      "keep": true,
      "knowledge": "不在现金密集型行业工作的客户经常用小面额纸币兑换大面额纸币。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2466,
      "keep": true,
      "knowledge": "这类活动可能表明，走私贩在为大批量运输现金准备收益。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2467,
      "keep": true,
      "knowledge": "在西南边境附近的客户账户因可疑活动被注销时，新客户可能以账户已被注销的客户的名义开展交易，而这可能是继续非法活动的一种手段。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2468,
      "keep": true,
      "knowledge": "在这种情况下，新账户往往反映出与已注销账户相似的活动特点，交易频率可能很高，涉及大量现金，参与的个人过去经常与因可疑活动被注销的账户进行资金往来。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2469,
      "keep": true,
      "knowledge": "客户的生活方式与工作或岗位不符，且无正当理由/依据，或利润/存款显著多于类似职业/工作岗位的同行。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2470,
      "keep": true,
      "knowledge": "流入的资金多为现金，而大规模现金流与客户业务不相符；",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2471,
      "keep": true,
      "knowledge": "大量使用现金购买资产、进行交易。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2472,
      "keep": true,
      "knowledge": "据金融犯罪执法网络发布的《识别可能与偷渡和人口走私有关的活动指南--金融危险信，以下是关于人口贩卖的危险信号：",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2473,
      "keep": true,
      "knowledge": "企业客户没有正常的工资支出（如工资、工资税、社保缴费）；",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2474,
      "keep": true,
      "knowledge": "相对于客户声称的运营规模、员工人数或业务和/或商业模式，工资成本可能不存在或者极低。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2475,
      "keep": true,
      "knowledge": "工资被大幅扣减。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2476,
      "keep": true,
      "knowledge": "在金融组织可以观察的范围内，企业客户可能从员工工资中扣除大笔费用（如食宿费），员工只收到很少一部分工资。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2477,
      "keep": true,
      "knowledge": "这种情况可能发生在工资支付前后。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2478,
      "keep": true,
      "knowledge": "将工资支票兑换成现金，其中大部分资金由雇主保留或存回雇主账户。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2479,
      "keep": true,
      "knowledge": "那些可以取得工资单和其他工资记录的金融组织可以发现这种活动。",
      "type": "事实",
      "local_label": true
    }
  ],
