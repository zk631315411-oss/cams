    "baseline": {
      "argv": [
        "python",
        ".controlled-iteration/run_v3_prompt_arm.py",
        "--arm",
        "baseline",
        "--source-question",
        "{baseline_ref}",
        "--artifact-dir",
        "{artifact_dir}"
