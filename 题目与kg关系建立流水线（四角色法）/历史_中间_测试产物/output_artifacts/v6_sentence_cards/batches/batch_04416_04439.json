{
  "batch_start": 4416,
  "items": [
    {
      "i": 4416,
      "keep": true,
      "knowledge": "金融组织必须遵守传唤或作证传票的要求。",
      "type": "事实"
    },
    {
      "i": 4417,
      "keep": true,
      "knowledge": "金融组织不遵守传唤或作证传票可能遭受不利行动或处罚。",
      "type": "事实"
    },
    {
      "i": 4418,
      "keep": true,
      "knowledge": "金融组织不得向客户泄露谁正在被调查。",
      "type": "法规"
    },
    {
      "i": 4419,
      "keep": true,
      "knowledge": "组织应任命一名了解组织文件的员工负责检索与政府要求相关的文件。",
      "type": "流程"
    },
    {
      "i": 4420,
      "keep": true,
      "knowledge": "应建立文件保管系统以确保能找到所有文件，可存放在集中档案、部门档案或个人档案中。",
      "type": "流程"
    },
    {
      "i": 4421,
      "keep": true,
      "knowledge": "应检索不同人手中的同一份文件副本，因为有些副本可能有手写便条。",
      "type": "流程"
    },
    {
      "i": 4422,
      "keep": true,
      "knowledge": "政府要求金融组织保持某些账户开立应以书面形式提出，并印有适当抬头和经政府授权。",
      "type": "法规"
    },
    {
      "i": 4423,
      "keep": true,
      "knowledge": "政府要求保持账户开立的书面要求应包括账户应保持开立状态的时间期限。",
      "type": "法规"
    },
    {
      "i": 4424,
      "keep": true,
      "knowledge": "政府要求保持账户开立的文件应在要求到期后至少保存五年。",
      "type": "法规"
    },
    {
      "i": 4425,
      "keep": true,
      "knowledge": "搜查令是法院授权执法部门搜查指定场所并扣押特定物品或文件的法律文书。",
      "type": "定义"
    },
    {
      "i": 4426,
      "keep": true,
      "knowledge": "签发搜查令一般需要执法部门证明有理由相信能找到犯罪证据。",
      "type": "流程"
    },
    {
      "i": 4427,
      "keep": true,
      "knowledge": "法院根据执法人员提供的宣誓书中的信息签发搜查令。",
      "type": "流程"
    },
    {
      "i": 4428,
      "keep": true,
      "knowledge": "执法部门持搜查令搜查时，在场的每个人都应保持冷静。",
      "type": "事实"
    },
    {
      "i": 4429,
      "keep": true,
      "knowledge": "搜查令通常不是无限制的命令。",
      "type": "事实"
    },
    {
      "i": 4430,
      "keep": true,
      "knowledge": "搜查令仅授予执法人员进入公司、搜寻和扣押特定物品或文件的权利。",
      "type": "定义"
    },
    {
      "i": 4431,
      "keep": true,
      "knowledge": "搜查令不能强制要求作证。",
      "type": "事实"
    },
    {
      "i": 4432,
      "keep": true,
      "knowledge": "接到搜查令后，组织应考虑采取相应步骤。",
      "type": "context"
    },
    {
      "i": 4433,
      "keep": true,
      "knowledge": "接到搜查令后应致电内部法务或外部法律顾问，或指定安全、风险管理等专员。",
      "type": "流程"
    },
    {
      "i": 4434,
      "keep": true,
      "knowledge": "接到搜查令后应查看搜查令以了解授权范围。",
      "type": "流程"
    },
    {
      "i": 4435,
      "keep": true,
      "knowledge": "接到搜查令后应要求并获得一份搜查令的副本。",
      "type": "流程"
    },
    {
      "i": 4436,
      "keep": true,
      "knowledge": "接到搜查令后应要求获得一份支持搜查令的宣誓书的副本。",
      "type": "流程"
    },
    {
      "i": 4437,
      "keep": true,
      "knowledge": "执法人员没有提供宣誓书副本的义务。",
      "type": "事实"
    },
    {
      "i": 4438,
      "keep": true,
      "knowledge": "如果金融组织被允许查看宣誓书，可以更好地了解调查目的。",
      "type": "事实"
    },
    {
      "i": 4439,
      "keep": true,
      "knowledge": "执法人员制作扣押物品清单时，金融组织应派人在场并跟踪记录。",
      "type": "流程"
    }
  ]
}