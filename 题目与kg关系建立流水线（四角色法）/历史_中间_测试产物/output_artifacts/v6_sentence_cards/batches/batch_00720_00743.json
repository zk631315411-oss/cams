    },
    {
      "i": 730,
      "keep": true,
      "knowledge": "非专属代理人常与多家保险公司合作，可能因游走于多家公司之间而被忽略。",
      "type": "事实"
    },
    {
      "i": 731,
      "keep": true,
      "knowledge": "与洗钱犯罪分子合谋的代理人可能寻找反洗钱监控最薄弱的保险公司。",
      "type": "事实"
    },
    {
      "i": 732,
      "keep": true,
      "knowledge": "以销售业绩为目标的经纪人可能忽略洗钱信号，如缺乏财富解释和异常支付保费方式。",
      "type": "事实"
    },
    {
      "i": 733,
      "keep": false,
