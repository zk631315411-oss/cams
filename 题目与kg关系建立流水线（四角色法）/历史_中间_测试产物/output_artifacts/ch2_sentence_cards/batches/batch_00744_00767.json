{
  "batch_start": 744,
  "items": [
    {
      "i": 744,
      "keep": true,
      "knowledge": "保险经纪人对保单具有很大的控制权和自由度，缺乏对中介机构的监管/控制是洗钱风险因素。",
      "type": "风险指标"
    },
    {
      "i": 745,
      "keep": true,
      "knowledge": "保险公司可能拥有完全受控于保险公司的员工（即专属代理人），对销售人员的监督过于分散是洗钱风险因素。",
      "type": "风险指标"
    },
    {
      "i": 746,
      "keep": true,
      "knowledge": "非专属代理人提供保险公司的产品，但并非保险公司员工。",
      "type": "定义"
    },
    {
      "i": 747,
      "keep": true,
      "knowledge": "非专属代理人往往与多家保险公司合作，为客户提供最佳产品组合，可能因游走在多家保险公司之间而被忽略。",
      "type": "风险指标"
    },
    {
      "i": 748,
      "keep": true,
      "knowledge": "与洗钱犯罪分子合谋的代理人，可能会努力寻找反洗钱监控措施最薄弱的保险公司。",
      "type": "风险指标"
    },
    {
      "i": 749,
      "keep": true,
      "knowledge": "以销售业绩为目标的经纪人可能忽略各种洗钱信号，如缺乏对财富的解释及用异常方法支付保费。",
      "type": "风险指标"
    },
    {
      "i": 750,
      "keep": true,
      "knowledge": "通过保险公司进行洗钱的示例包括：",
      "type": "context"
    },
    {
      "i": 751,
      "keep": true,
      "knowledge": "有些保单以单位信托或共同基金的形式操作。",
      "type": "事实"
    },
    {
      "i": 752,
      "keep": true,
      "knowledge": "客户可以溢资投保，并在支付提前退保罚金后将资金转入或转出保单。",
      "type": "流程"
    },
    {
      "i": 753,
      "keep": true,
      "knowledge": "当保险公司返还资金时，洗钱者就成功地模糊了资金与犯罪活动之间的联系。",
      "type": "流程"
    },
    {
      "i": 754,
      "keep": true,
      "knowledge": "购买或赎回整付保费保险债券是主要的洗钱工具。",
      "type": "风险指标"
    },
    {
      "i": 755,
      "keep": true,
      "knowledge": "该债券可以从保险公司购得并在债券到期前折价赎回。",
      "type": "事实"
    },
    {
      "i": 756,
      "keep": true,
      "knowledge": "此时，保险公司会以'洗净的'支票形式支付债券余额。",
      "type": "流程"
    },
    {
      "i": 757,
      "keep": true,
      "knowledge": "保单撤销期允许投资者在签署保单并支付保费后的短时间内撤销保单且无需支付罚金。",
      "type": "定义"
    },
    {
      "i": 758,
      "keep": true,
      "knowledge": "这一流程使得洗钱者有机会获得保险支票，以此证明资金的合法性。",
      "type": "流程"
    },
    {
      "i": 759,
      "keep": true,
      "knowledge": "随着越来越多的保险公司受反洗钱制度要求约束，此类洗钱的侦测和报告更为容易。",
      "type": "事实"
    },
    {
      "i": 760,
      "keep": true,
      "knowledge": "当潜在的保单持有人更加关注保单的取消条款而非收益时，就有存在洗钱的可能。",
      "type": "风险指标"
    },
    {
      "i": 761,
      "keep": true,
      "knowledge": "洗钱者用非法资金购买保单，然后告诉保险公司他已改变主意，不再需要这份保险。",
      "type": "案例"
    },
    {
      "i": 762,
      "keep": true,
      "knowledge": "在支付罚金后，洗钱者赎回保单并获得一张由声誉良好的保险公司开据的干净支票。",
      "type": "流程"
    },
    {
      "i": 763,
      "keep": true,
      "knowledge": "金融行动特别工作组报告中指出了更多保险业存在的洗钱类型。",
      "type": "context"
    },
    {
      "i": 764,
      "keep": true,
      "knowledge": "签订保险协议时，未对支付保单的第三方进行正常的身份识别程序。",
      "type": "风险指标"
    },
    {
      "i": 765,
      "keep": true,
      "knowledge": "保险公司可能不清楚资金来源及保单持有者和该第三方的关系。",
      "type": "风险指标"
    },
    {
      "i": 766,
      "keep": true,
      "knowledge": "有些客户实际上并非寻求保险的保障，而是将之作为投资机会。",
      "type": "事实"
    },
    {
      "i": 767,
      "keep": true,
      "knowledge": "犯罪分子可以用大笔资金购买多份人寿整付保费保单，作为整套投资保单，以进行洗钱。",
      "type": "案例"
    }
  ]
}