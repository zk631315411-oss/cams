{
  "batch_start": 3168,
  "items": [
    {
      "i": 3168,
      "keep": true,
      "knowledge": "客户进行大量出乎意料的活动，如国内慈善机构收到多笔存款后开展大规模国际交易，或现金密集型企业接触大笔现金，可帮助确定客户实际风险。",
      "type": "事实"
    },
    {
      "i": 3169,
      "keep": true,
      "knowledge": "高风险客户及风险评级因活动调高的客户应接受增强尽职调查以缓释风险。",
      "type": "流程"
    },
    {
      "i": 3170,
      "keep": true,
      "knowledge": "增强尽职调查可能最终确定客户的活动是否可疑。",
      "type": "流程"
    },
    {
      "i": 3171,
      "keep": true,
      "knowledge": "如果客户活动可疑，客户记录应予以更新以反映变化。",
      "type": "流程"
    },
    {
      "i": 3172,
      "keep": true,
      "knowledge": "风险为本方法的核心目的是评估金融组织的客户、地理位置/司法管辖区以及产品和服务的风险。",
      "type": "定义"
    },
    {
      "i": 3173,
      "keep": true,
      "knowledge": "下文将更深入地分析三大重要的风险因素。",
      "type": "context"
    },
    {
      "i": 3174,
      "keep": true,
      "knowledge": "客户类型风险评估中一个至关重要的步骤是对组织所提供产品和服务的用户进行分析。",
      "type": "流程"
    },
    {
      "i": 3175,
      "keep": true,
      "knowledge": "客户类型包括个人、上市公司、私营企业、合资企业、合伙企业和金融机构等。",
      "type": "分类"
    },
    {
      "i": 3176,
      "keep": true,
      "knowledge": "有犯罪历史的客户会被评定为最高风险等级。",
      "type": "事实"
    },
    {
      "i": 3177,
      "keep": true,
      "knowledge": "对政治人物和政治组织成员的评分也趋于最高。",
      "type": "事实"
    },
    {
      "i": 3178,
      "keep": true,
      "knowledge": "跨国上市公司的风险评分一般低于非上市公司，因在主要证交所上市的公司已提供大量公开信息并进行了尽职调查。",
      "type": "事实"
    },
    {
      "i": 3179,
      "keep": true,
      "knowledge": "如果洗钱分子隐藏在公司组织形式之后，如信托、慈善组织、有限责任公司等，风险通常更高。",
      "type": "事实"
    },
    {
      "i": 3180,
      "keep": true,
      "knowledge": "如果客户公司位于反洗钱要求不健全或有严格公司保密法规的国家或地区，风险将进一步增加。",
      "type": "事实"
    },
    {
      "i": 3181,
      "keep": true,
      "knowledge": "各国监管机构已确认一些客户类型本身具有较高的洗钱风险。",
      "type": "事实"
    },
    {
      "i": 3182,
      "keep": true,
      "knowledge": "位于避税/金融庇护所的离岸公司和银行属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3183,
      "keep": true,
      "knowledge": "货币服务企业，包括货币兑换所、汇款经纪公司和支票兑现所，属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3184,
      "keep": true,
      "knowledge": "虚拟货币交易所属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3185,
      "keep": true,
      "knowledge": "汽车、船舶和飞机经销商属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3186,
      "keep": true,
      "knowledge": "二手车、二手卡车经销商和机械零部件生产商属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3187,
      "keep": true,
      "knowledge": "专业服务供应商（如律师、会计、投资经纪商等）属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3188,
      "keep": true,
      "knowledge": "证券经纪经销商属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3189,
      "keep": true,
      "knowledge": "珠宝、宝石和贵金属经销商属于高风险客户类型。",
      "type": "分类"
    },
    {
      "i": 3190,
      "keep": true,
      "knowledge": "现金密集型企业（如餐馆、零售商店、停车场等）属于高风险行业。",
      "type": "分类"
    },
    {
      "i": 3191,
      "keep": true,
      "knowledge": "行业并非决定风险大小的唯一因素。",
      "type": "事实"
    }
  ]
}