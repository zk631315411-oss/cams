{
  "batch_start": 24,
  "items": [
    {
      "i": 24,
      "keep": true,
      "knowledge": "洗钱活动往往涉及一系列难以区分的复杂交易。",
      "type": "事实"
    },
    {
      "i": 25,
      "keep": true,
      "knowledge": "通常认为洗钱分为三个阶段。",
      "type": "分类"
    },
    {
      "i": 26,
      "keep": true,
      "knowledge": "阶段一：处置——实际处理犯罪所得的现金或其他资产。",
      "type": "定义"
    },
    {
      "i": 27,
      "keep": true,
      "knowledge": "在处置阶段，洗钱者将非法所得投入金融系统中。",
      "type": "流程"
    },
    {
      "i": 28,
      "keep": true,
      "knowledge": "洗钱者通过向金融机构、赌场、商店等合法企业投入资金进行流通来实现处置。",
      "type": "流程"
    },
    {
      "i": 29,
      "keep": false,
      "knowledge": "",
      "type": "context"
    },
    {
      "i": 30,
      "keep": true,
      "knowledge": "混合资金：将非法资金与合法资金混和，例如将贩毒所得现金投入现金交易密集的餐厅。",
      "type": "案例"
    },
    {
      "i": 31,
      "keep": true,
      "knowledge": "用现金购买大额储值卡是处置交易示例。",
      "type": "案例"
    },
    {
      "i": 32,
      "keep": true,
      "knowledge": "用非法资金购买外汇是处置交易示例。",
      "type": "案例"
    },
    {
      "i": 33,
      "keep": true,
      "knowledge": "现金拆分：将现金分为多笔小数额存入多个银行账户，企图规避报告要求。",
      "type": "案例"
    },
    {
      "i": 34,
      "keep": true,
      "knowledge": "货币走私：现金或金融工具的跨境物理转移。",
      "type": "案例"
    },
    {
      "i": 35,
      "keep": true,
      "knowledge": "用待清洗现金偿还合法贷款是处置交易示例。",
      "type": "案例"
    },
    {
      "i": 36,
      "keep": true,
      "knowledge": "阶段二：离析——经过层层金融交易隐匿资金来源，将非法所得与其真实来源分离。",
      "type": "定义"
    },
    {
      "i": 37,
      "keep": true,
      "knowledge": "第二阶段涉及将犯罪所得转变为其他形式并创建层次复杂的金融交易来掩饰资金来源和所有权。",
      "type": "流程"
    },
    {
      "i": 38,
      "keep": false,
      "knowledge": "",
      "type": "context"
    },
    {
      "i": 39,
      "keep": true,
      "knowledge": "通过电子资金转移将资金从一国转移至另一国，然后投入高级金融期权或金融市场。",
      "type": "案例"
    },
    {
      "i": 40,
      "keep": true,
      "knowledge": "将资金从一家金融机构转移至另一家，或在同一机构内多个账户间互转。",
      "type": "案例"
    },
    {
      "i": 41,
      "keep": true,
      "knowledge": "将现金换为金融工具（票据）是离析交易示例。",
      "type": "案例"
    },
    {
      "i": 42,
      "keep": true,
      "knowledge": "转售高价值商品和预付存取或储值产品是离析交易示例。",
      "type": "案例"
    },
    {
      "i": 43,
      "keep": true,
      "knowledge": "投资不动产和其他合法企业是离析交易示例。",
      "type": "案例"
    },
    {
      "i": 44,
      "keep": true,
      "knowledge": "投资股票、债券或人寿保险产品是离析交易示例。",
      "type": "案例"
    },
    {
      "i": 45,
      "keep": true,
      "knowledge": "利用空壳公司掩盖最终受益所有人和资产是离析交易示例。",
      "type": "案例"
    },
    {
      "i": 46,
      "keep": true,
      "knowledge": "阶段三：融合——以看似正常业务或个人交易的形式将资金重新投入经济活动，使非法财富表面合法。",
      "type": "定义"
    },
    {
      "i": 47,
      "keep": true,
      "knowledge": "第三阶段需要将洗白后的资金用于表面上看似正常的交易，从而给人具有合法性的感觉。",
      "type": "流程"
    }
  ]
}