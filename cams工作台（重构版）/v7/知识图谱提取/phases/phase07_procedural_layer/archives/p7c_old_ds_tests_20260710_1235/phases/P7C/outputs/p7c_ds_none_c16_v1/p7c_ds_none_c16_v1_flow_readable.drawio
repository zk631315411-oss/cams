 parent="1"><mxGeometry x="655" y="444" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_f63363e6b1" value="&lt;b&gt;步骤：&lt;/b&gt;Holistically review internal&lt;br&gt;and external information&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003346&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_d58df66ae4" value="&lt;b&gt;判断：&lt;/b&gt;Determine next steps:&lt;br&gt;dismiss or escalate&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003346, v7u_N003347&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_c307e3d3ae" value="&lt;b&gt;产出：&lt;/b&gt;Decision: Dismiss alert&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003347&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="727" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_6e5f3910f0" value="&lt;b&gt;产出：&lt;/b&gt;Decision: Escalate alert&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003347&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="819" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_dac063864d" value="&lt;b&gt;步骤：&lt;/b&gt;Document investigation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003347, v7u