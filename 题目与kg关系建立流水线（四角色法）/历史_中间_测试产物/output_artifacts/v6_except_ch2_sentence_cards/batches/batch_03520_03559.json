{
  "batch_start": 3520,
  "items": [
    {
      "i": 3520,
      "keep": true,
      "knowledge": "就信托而言，让与人通常指信托的设立者或资助者。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3521,
      "keep": true,
      "knowledge": "证人对所知事实的口头陈述，通常需要经过宣誓。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 3522,
      "keep": true,
      "knowledge": "也称为调查委托函 (letters rogatory)，是一国中央政府为寻求司法管辖区外的证据而向另一国的中央政府发出的法律或司法协助书面请求。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 3523,
      "keep": true,
      "knowledge": "通常来说，该委托书会明确请求的性质、在请求国国内的有关刑事指控、作出请求所依据的法律规定以及所希望寻求的信息。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 3524,
      "keep": true,
      "knowledge": "参见\"调查委托书(Commission Rogatoire)\"。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3525,
      "keep": true,
      "knowledge": "双方就制定一系列原则来处理双方在特定事项上的关系而达成的协议。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3526,
      "keep": true,
      "knowledge": "谅解备忘录通常被各国用来管理国际资产没收案件中的资产共享事宜或者确定各自在反洗钱工作中的义务。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3527,
      "keep": true,
      "knowledge": "金融情报机构肩负着以下职责：不间断的接收和分析可疑交易报告，与警方和海关保持密切联系， 调查期间在内部非正式地共享信息，这些通常都是以谅解备忘录的形式进行。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 3528,
      "keep": true,
      "knowledge": "也称为代理人账户。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3529,
      "keep": true,
      "knowledge": "贝纳米账户由某一个人或实体代表他人持有，通常与印度次大陆的哈瓦拉地下钱庄体系相关。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3530,
      "keep": true,
      "knowledge": "如果处于某一司法管辖区的个人希望通过哈瓦拉经纪人将资金转到另一司法管辖区，此人可利用贝纳米账户或贝纳米交易来掩饰其真实身份或资金接收方的真实身份。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3531,
      "keep": true,
      "knowledge": "流通中作为交换媒介的钞票和硬币。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3532,
      "keep": true,
      "knowledge": "也称为货币兑换所 (Bureau de Change)、外币兑换所(exchange office)。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3533,
      "keep": true,
      "knowledge": "货币兑换处提供的一系列服务对洗钱者非常具有吸引力，其中包括：货币兑换和零票换整；",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 3534,
      "keep": true,
      "knowledge": "兑换旅行支票、汇票和私人支票等金融票据；",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3535,
      "keep": true,
      "knowledge": "以及电汇服务。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3536,
      "keep": true,
      "knowledge": "开展下列活动且超过适用监管限额的个人（自然人或法人），在此情况下，这个人通常被视为须遵守反洗钱规定的金融机构：",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 3537,
      "keep": true,
      "knowledge": "外汇交易",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3538,
      "keep": true,
      "knowledge": "支票兑现",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3539,
      "keep": true,
      "knowledge": "签发或出售旅行支票或汇票",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3540,
      "keep": true,
      "knowledge": "提供或出售预付存取产品",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3541,
      "keep": true,
      "knowledge": "资金转账",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3542,
      "keep": true,
      "knowledge": "货币走私 (Currency Smuggling)",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3543,
      "keep": true,
      "knowledge": "大量现金的非法跨境转移，通常是将现金转入未实施严格银行保密制度、外汇控制措施混乱或缺乏反洗钱法规的国家或地区。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 3544,
      "keep": true,
      "knowledge": "贸易融资 (Trade Finance)",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3545,
      "keep": true,
      "knowledge": "参见\"信用证(Letter Of Credit)\"。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3546,
      "keep": true,
      "knowledge": "资产保护 (Asset Protection)",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3547,
      "keep": true,
      "knowledge": "包括重组所持资产在内的流程，旨在减少个人遭索赔时对资产的影响。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 3548,
      "keep": true,
      "knowledge": "资产保护还是税务筹划人员使用的一个术语，用来描述为保护资产免受其他司法管辖区的税收政策影响而采取的各项措施。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3549,
      "keep": true,
      "knowledge": "不可撤销信托的特殊形式，通常在海外创立（设立），主要目的是保留和保护个人财产不受其债权人追索。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3550,
      "keep": true,
      "knowledge": "资产所有权被转移给指定的受托人。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3551,
      "keep": true,
      "knowledge": "资产保护信托通常用来保护资产，往往呈税收中性。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3552,
      "keep": true,
      "knowledge": "其最终功能是为受益人服务。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3553,
      "keep": true,
      "knowledge": "有些支持者宣称，资产保护信托允许外国受托人无视美国法庭命令并方便地将信托资产转移至另一司法管辖区，以应对威胁信托资产安全的法律诉讼。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 3554,
      "keep": true,
      "knowledge": "通过通讯、信息、转账或资金/ 价值转移服务所属的清算网络，在一地接收现金、支票或其他可储值的金融票据并在另一地把相应的金额以现金或其他形式向受益人支付的金融服务。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3555,
      "keep": true,
      "knowledge": "这一服务提供的交易可能涉及一个或多个中介以及第三方最终支付。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3556,
      "keep": true,
      "knowledge": "资金或价值转移服务可由个人（自然人或法人）正式通过受监管的金融系统（如银行账户）提供，也可非正式地通过非银行类金融机构和监管系统外的商业实体提供。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 3557,
      "keep": true,
      "knowledge": "在有些司法管辖区，非正规体系被称为替代性汇款服务处或地下（或平行）银行业务体系。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3558,
      "keep": true,
      "knowledge": "用于涉及两个或两个以上国家的活动，如跨境电汇或跨境携带货币。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 3559,
      "keep": true,
      "knowledge": "委托银行通过其委托的代理银行为其他金融机构提供下游代理服务的做法。",
      "type": "事实",
      "local_label": true
    }
  ],
  "label_source": "local_rules"
}