{
  "batch_start": 3144,
  "items": [
    {
      "i": 3144,
      "keep": true,
      "knowledge": "退休计划账户不易受洗钱活动滥用。",
      "type": "事实"
    },
    {
      "i": 3145,
      "keep": true,
      "knowledge": "该客户和账户的风险比前一个外国私企小。",
      "type": "事实"
    },
    {
      "i": 3146,
      "keep": true,
      "knowledge": "下一个步骤是建立每个风险类别所适用的阈值。",
      "type": "流程"
    },
    {
      "i": 3147,
      "keep": true,
      "knowledge": "组织应确保高风险客户不得在所有关系构成中占过大比重。",
      "type": "法规"
    },
    {
      "i": 3148,
      "keep": true,
      "knowledge": "机构不需要调整得分来适应客户构成，因为高风险客户确实需要更多的注意。",
      "type": "事实"
    },
    {
      "i": 3149,
      "keep": true,
      "knowledge": "如果客户构成过多地倾向于高风险客户，则组织的整体风险等级可能变得难以承受。",
      "type": "事实"
    },
    {
      "i": 3150,
      "keep": true,
      "knowledge": "评估反洗钱/反恐融资风险是反洗钱/反恐融资合规制度的一个持续而不断发展的组成部分。",
      "type": "定义"
    },
    {
      "i": 3151,
      "keep": true,
      "knowledge": "评估风险评分模型并更新风险评估，纳入产品、服务、分销渠道、客户和司法管辖区的变化，确保准确反映反洗钱/反恐融资风险至关重要。",
      "type": "流程"
    },
    {
      "i": 3152,
      "keep": true,
      "knowledge": "在推出新产品、收购另一家金融组织之前以及风险环境发生重大变化时，应更新风险评估。",
      "type": "流程"
    },
    {
      "i": 3153,
      "keep": true,
      "knowledge": "组织可通过定期复查风险评级标准，了解被评为高风险的客户是否真的更可能参与可疑活动。",
      "type": "流程"
    },
    {
      "i": 3154,
      "keep": true,
      "knowledge": "如果高风险客户并不更可能参与可疑活动，则需要对风险评分模型进行重新评估。",
      "type": "流程"
    },
    {
      "i": 3155,
      "keep": true,
      "knowledge": "风险评估的另一大关键组成部分是重新评估风险，确定是否应该调高或降低客户的风险等级。",
      "type": "流程"
    },
    {
      "i": 3156,
      "keep": true,
      "knowledge": "为了有效地分配有限的资源，有必要识别触发复查工作的重要因素。",
      "type": "事实"
    },
    {
      "i": 3157,
      "keep": true,
      "knowledge": "除了对客户固有风险的初次评估，还需考虑客户与组织的关系及其风险评级随时间的变化。",
      "type": "流程"
    },
    {
      "i": 3158,
      "keep": true,
      "knowledge": "决定客户风险评级的最重要因素也许是客户的实际活动。",
      "type": "事实"
    },
    {
      "i": 3159,
      "keep": true,
      "knowledge": "一个学生活期存款账户的风险一开始可能很低。",
      "type": "案例"
    },
    {
      "i": 3160,
      "keep": true,
      "knowledge": "如果学生账户多次将大笔资金转至高风险司法管辖区，则该账户的风险等级应调高。",
      "type": "案例"
    },
    {
      "i": 3161,
      "keep": true,
      "knowledge": "货币服务企业或代理银行等潜在的高风险客户可能只从事其分内活动。",
      "type": "案例"
    },
    {
      "i": 3162,
      "keep": true,
      "knowledge": "这种客户的实际风险可能低于仅根据固有风险做出的判断。",
      "type": "事实"
    },
    {
      "i": 3163,
      "keep": true,
      "knowledge": "仅根据固有风险被判断为风险低或标准的学生客户实际上给机构带来的风险高于固有风险高的货币服务企业。",
      "type": "案例"
    },
    {
      "i": 3164,
      "keep": true,
      "knowledge": "组织应考虑根据以下因素调整客户的风险评级。",
      "type": "流程"
    },
    {
      "i": 3165,
      "keep": true,
      "knowledge": "日常活动，例如警报、案例和可疑活动报告等记录。",
      "type": "事实"
    },
    {
      "i": 3166,
      "keep": true,
      "knowledge": "收到执法机关问讯，如作证传票。",
      "type": "事实"
    },
    {
      "i": 3167,
      "keep": true,
      "knowledge": "违反经济制裁制度的交易。",
      "type": "事实"
    }
  ]
}