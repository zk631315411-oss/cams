ES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_729f814900" target="v_369c06a01d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3e3499831f" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_369c06a01d" target="v_03f452d441"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_1fb98968a3" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_03f452d441" target="v_9e59fd39d6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_0afbb34079" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Some branches are inferred from the text and marked needs_review: dismissal after Level 2 not suspicious (edge 013), direct SAR filing for non-highly suspicious cases (edge 016), Level 3 to SAR filing (edge 021), monitoring recommendation sequence (edge 024), final output (node n_output_final). Further validation required for complete branch accuracy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1847" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S07" id="page_5f423d5a69"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_d6d79f0c1e" value="CH47-S07 Transaction monitoring &amp;gt; Other sources of investigation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_e5e0de4ed3" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_44209b8aaa" value="CH47-S07 / card 1: Sensitive Investigation Source Handling Control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_c91d257683" value="nature=control | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_6742249ac7" value="&lt;b&gt;标准：&lt;/b&gt;Avoid tipping off potential&lt;br&gt;subject (felony risk)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003327, v7u_N003328&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_b3513cdb74" value="&lt;b&gt;标准：&lt;/b&gt;Handle with extra care due&lt;br&gt;to high materiality and&lt;br&gt;sensitivity&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003326&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_b89d36d973" value="&lt;b&gt;触发：&lt;/b&gt;Investigation originates&lt;br&gt;from sensitive source&lt;br&gt;(internal/external referral,&lt;br&gt;RFI, negative news,&lt;br&gt;regulatory finding, law&lt;br&gt;enforcement request)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003314, v7u_N003326&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_88d5cbc9be" value="&lt;b&gt;步骤：&lt;/b&gt;Apply robust investigation&lt;br&gt;management procedures&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003329&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_21026b9489" value="&lt;b&gt;产出：&lt;/b&gt;Risk of information leaks&lt;br&gt;minimized&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003329&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_b84dccbbe1" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_b89d36d973" target="v_88d5cbc9be"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_46d89cf29e" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_88d5cbc9be" target="v_6742249ac7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_520933d317" value="USES" 