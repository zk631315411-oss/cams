{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAMS v7 cleaned question bank",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "total_items",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "v7_questions_v1"
    },
    "generated_at": {
      "type": "string"
    },
    "total_items": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "question_id",
        "source_question_id",
        "chapter_code",
        "question_type",
        "stem",
        "options",
        "answer",
        "answer_source",
        "risk_flags",
        "tier",
        "stem_en",
        "options_en"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^v7_q_[0-9]{6}$"
        },
        "source_question_id": {
          "type": "string"
        },
        "section_code": {
          "type": "string"
        },
        "chapter_code": {
          "type": "string"
        },
        "chapter_path_en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chapter_path_zh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "display_chapter_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "question_type": {
          "enum": [
            "single",
            "multiple",
            "unknown"
          ]
        },
        "stem": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "answer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer_source": {
          "type": "string"
        },
        "risk_flags": {
          "type": "array"
        },
        "tier": {
          "type": "string"
        },
        "stem_en": {
          "type": "string"
        },
        "options_en": {
          "$ref": "#/$defs/options"
        },
        "raw_question_en": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "options": {
      "type": "object",
      "patternProperties": {
        "^[A-F]$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
