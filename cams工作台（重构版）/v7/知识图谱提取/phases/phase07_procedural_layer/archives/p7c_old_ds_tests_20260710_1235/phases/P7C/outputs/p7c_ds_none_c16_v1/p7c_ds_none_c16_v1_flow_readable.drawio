erts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_d56906cbfd" value="nature=risk_indicator | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_4fda05bb92" value="&lt;b&gt;标准：&lt;/b&gt;Excessive channel usage&lt;br&gt;compared to customer type&lt;br&gt;(e.g., high cash over&lt;br&gt;electronic)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003292&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7cf864887a" value="&lt;b&gt;标准：&lt;/b&gt;Round trip transactions:&lt;br&gt;sent remittance returned as&lt;br&gt;received shortly after&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003293&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_92736df798" value="&lt;b&gt;标准：&lt;/b&gt;One to N parties or N&lt;br&gt;parties to one without&lt;br&gt;logical explanation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003294&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeom