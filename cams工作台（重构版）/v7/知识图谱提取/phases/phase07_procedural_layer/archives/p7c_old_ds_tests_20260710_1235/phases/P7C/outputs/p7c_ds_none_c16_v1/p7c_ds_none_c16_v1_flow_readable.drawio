;b&gt;标准：&lt;/b&gt;Documentation and&lt;br&gt;record-keeping requirements&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003414, v7u_N003426, v7u_N003428, v7u_N003429, v7u_N003430, v7u_N003432, v7u_N003433, v7u_N003436, v7u_N003437&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_3921ec2324" value="&lt;b&gt;标准：&lt;/b&gt;Organizational policies and&lt;br&gt;jurisdictional requirements&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003411, v7u_N003416, v7u_N003417&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_bc4b6f4715" value="&lt;b&gt;标准：&lt;/b&gt;Precise terminology and&lt;br&gt;correct report names&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003421, v7u_N003422, v7u_N003423&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_2ec8826821" value="&lt;b&gt;触发：&lt;/b&gt;Unmitigated risk indicators&lt;br&gt;identified&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003410&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_a859d90d1d" value="&lt;b&gt;步骤：&lt;/b&gt;Escalate customer for&lt;br&gt;additional investigation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003410&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_eff865489d" value="&lt;b&gt;步骤：&lt;/b&gt;Collaborate with others on&lt;br&gt;next steps&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003415&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_6e59d21997" value="&lt;b&gt;步骤：&lt;/b&gt;File internal escalation&lt;br&gt;report&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003419&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_d93250a588" value="&lt;b&gt;判断：&lt;/b&gt;Determine if SAR should be&lt;br&gt;filed&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003424, v7u_N003425&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_e336888c34" value="&lt;b&gt;步骤：&lt;/b&gt;MLRO files SAR with FIU&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003425&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a