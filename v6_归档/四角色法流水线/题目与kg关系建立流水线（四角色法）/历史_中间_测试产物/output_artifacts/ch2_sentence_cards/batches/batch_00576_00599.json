    },
    {
      "i": 590,
      "keep": true,
      "knowledge": "信用合作社的风险因素包括允许与第三方进行转账往来。",
      "type": "风险指标"
    },
    {
      "i": 591,
      "keep": true,
      "knowledge": "信用合作社的风险因素包括频繁现金支付。",
      "type": "风险指标"
    },
    {
      "i": 592,
      "keep": true,
      "knowledge": "信用合作社的风险因素包括客户实施大额的一次性交易。",
      "type": "风险指标"
    },
    {
      "i": 593,
      "keep": true,
      "knowledge": "信用合作社的风险因素包括异常的贷款或储蓄交易，如使用来源不明的收入提前偿还贷款。",
      "type": "风险指标"
    },
    {
      "i": 594,
      "keep": true,
      "knowledge": "信用合作社的风险因素包括客户不愿意提供身份证明或有关业务关系目的或性质的信息。",
      "type": "风险指标"
    },
    {
      "i": 595,
      "keep": true,
      "knowledge": "基于信用合作社的服务及其与雇主、福利提供者和学校的关系，需考虑客户是否有合理理由缺少身份证件，以及是否被视为金融排斥。",
      "type": "流程"
    },
    {
      "i": 596,
      "keep": true,
      "knowledge": "指南提供示例，如雇主或学校来信，协助识别遭受金融排斥的人员。",
