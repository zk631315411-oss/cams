          "edge_id": "edge_004",
          "edge_type": "REFERENCES",
          "source": "e002",
          "target": "e005",
          "evidence_unit_ids": [
            "v7u_N002746"
          ],
          "relation_type": "standard_constrains_action",
          "source_quote": "Determining jurisdiction risk might involve assessing political stability, the regulatory environment, and sanctions status."
        },
