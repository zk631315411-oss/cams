          "node_id": "n003",
          "node_category": "process",
          "node_type": "P2_execution",
          "label": "欧盟通过第五项反洗钱指令",
          "evidence_unit_ids": [
            "v7u_N001794"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "n004",
          "node_category": "exit",
          "node_type": "X5_config_change",
          "label": "加强反洗钱与银行监管合作，加强现有法规，并扩大监管范围至非银行金融机构、指定非金融行业和加密资产服务商",
          "evidence_unit_ids": [
            "v7u_N001794"
          ],
          "evidence_strength": "explicit"
        }
