{
  "batch_start": 1760,
  "items": [
    {
      "i": 1760,
      "keep": true,
      "knowledge": "这样，组织就可以识别差距和缺陷，确保持续发展和改进。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1761,
      "keep": true,
      "knowledge": "独立测试可以由外部审计师或内部审计职能部门进行，这些职能部门与第一道和第二道防线职能部门之间有足够的独立性。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1762,
      "keep": true,
      "knowledge": "独立内部审计师应具备开展反洗钱审计的充足技能和培训。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1763,
      "keep": true,
      "knowledge": "他们直接向董事会汇报工作。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1764,
      "keep": true,
      "knowledge": "在 AAMPL 的案例中，有效的独立审查可能会发现持续控制措施中的任何差距。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1765,
      "keep": true,
      "knowledge": "风险评估的结果将为组织提供解决差距和违规问题的机会。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1766,
      "keep": true,
      "knowledge": "相反，这些违规行为被监管机构发现，因而吊销了该公司的资本市场服务许可证。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1767,
      "keep": true,
      "knowledge": "稳健、全面的反洗钱/反恐融资制度要纳入独立监督和审查。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1768,
      "keep": true,
      "knowledge": "需要进开展全企业范围的风险评估，以识别漏洞并允许组织制定有效的控制措施。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1769,
      "keep": true,
      "knowledge": "实体必须评估其客户是否存在较高的金融犯罪风险。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1770,
      "keep": true,
      "knowledge": "必须制定反洗钱/反恐融资政策来管理风险。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1771,
      "keep": true,
      "knowledge": "在金融组织的整体结构中建立合规文化是制定并持续管理有效的反洗钱/反恐融资制度的关键。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1772,
      "keep": true,
      "knowledge": "通常，反洗钱/反恐融资合规制度的最终责任由组织的董事会承担。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1773,
      "keep": true,
      "knowledge": "董事会和高级管理层必须公开表达他们对实施反洗钱/反恐融资制度的承诺，从而确定自上而下的基调，确保其承诺贯穿于所有服务领域和业务条线，并且敦促责任方对合规制度负责。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1774,
      "keep": true,
      "knowledge": "尽管建立合规文化可能无法解决现在或将来的所有问题，但注重识别和控制风险的有效反洗钱/反恐融资合规制度是组织取得全面成功的关键。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1775,
      "keep": true,
      "knowledge": "所有业务部门的员工都必须清楚地理解严守规则、支持合规制度的承诺。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1776,
      "keep": true,
      "knowledge": "采用合规文化是预防可识别的简单问题发展成系统性问题的最有效方式。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1777,
      "keep": true,
      "knowledge": "一套有效的反洗钱/反恐融资制度需要资金支持，而管理层可能不愿支出这笔费用。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1778,
      "keep": true,
      "knowledge": "合规专员面临的挑战在于说服管理层：实施反洗钱/反恐融资制度的支出是为了保护组织并使组织规避法律问题和声誉受损，因而这笔开支必不可少。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1779,
      "keep": true,
      "knowledge": "金融犯罪执法网络根据其调查发现了多家金融组织存在反洗钱/反恐融资合规缺陷，其中包括董事会和高级管理层的未勤勉尽责，这一调查结果发表在 2014 年 8 月的一份咨询文件中。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1780,
      "keep": true,
      "knowledge": "该咨询文件概述了六条加强金融组织反洗钱/反恐融资合规文化的建议，包括：",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1781,
      "keep": true,
      "knowledge": "1. 领导层必须积极支持和理解合规工作。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1782,
      "keep": true,
      "knowledge": "董事会在反洗钱 / 反恐融资合规中的作用包括审查和批准整个反洗钱 / 反恐融资制度以及确保制度得到持续的监管。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1783,
      "keep": true,
      "knowledge": "董事自身不必成为反洗钱/反恐融资专家，也无须负责日常的制度管理。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1784,
      "keep": true,
      "knowledge": "当然，他们应该足够了解并正式批准组织的反洗钱/反恐融资合规制度，确保制度得到员工的充分落实和维护。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1785,
      "keep": true,
      "knowledge": "董事会的监督作用还延伸到监管部门的检查过程中。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1786,
      "keep": true,
      "knowledge": "检查人员在现场检查前和检查过程中与董事会和管理层进行例行合作，以便评估董事会对合规制度的承诺、对法律的理解和对组织运作的了解。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1787,
      "keep": true,
      "knowledge": "在监管部门或审计师完成检查后，董事会有责任确保采取必要的整改措施。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1788,
      "keep": true,
      "knowledge": "具体职责可以授权他人行使，但如果检查人员或审计师指出的问题没有得到整改，董事会应对此负责。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1789,
      "keep": true,
      "knowledge": "机构不得为了营收利益而放松对反洗钱 / 反恐融资缺陷和风险的管控和缓释。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1790,
      "keep": true,
      "knowledge": "2. 合规人员应掌握适当权力以便落实组织的反洗钱/反恐融资政策。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1791,
      "keep": true,
      "knowledge": "不应无视合规工作，背离组织风险偏好，而一味追求收益。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1792,
      "keep": true,
      "knowledge": "从根本上讲，商业利润不应凌驾于合规之上。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1793,
      "keep": true,
      "knowledge": "组织各部门的相关信息必须与合规人员共享，以便进一步推进反洗钱/反恐融资工作。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1794,
      "keep": true,
      "knowledge": "3. 业务部门不应局限于自身孤岛之内。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1795,
      "keep": true,
      "knowledge": "组织内不应存在沟通界限和障碍。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1796,
      "keep": true,
      "knowledge": "相关信息应与反洗钱 / 反恐融资合规人员共享。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1797,
      "keep": true,
      "knowledge": "组织必须向合规职能部门投入足够的资源。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1798,
      "keep": true,
      "knowledge": "4. 领导层除了必须指定人员负责依照法规协调和监控日常的反洗钱/反恐融资合规事务，还要根据组织的风险情况，提供科技资源和合适的反洗钱/反恐融资人员支持。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1799,
      "keep": true,
      "knowledge": "合规制度必须行之有效。",
      "type": "流程",
      "local_label": true
    }
  ],
  "label_source": "local_rules"
}