source="v_eba8fa2d69" target="v_b391d1ac7a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_1e2ff4a618" value="DECIDES / yes" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_f080f2f9cc" target="v_eba8fa2d69"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_620565d322" value="虚线 = functional_dependency 或 needs_review，需要 P7D 复核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="780" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH02-S04" id="page_5d2854b805"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_e063debf3e" value="CH02-S04 " style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_8f1db385d5" value="status=failed | cards=0 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_a2fac97dde" value="&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="780" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH03-S02" id="page_9ba1e0b8e4"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_8276f6529a" value="CH03-S02 Examples of predicate crimes &amp;gt; Environmental crime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_d74cc39a0c" value="status=ok | cards=0 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_42d69b0e96" value="&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;当前章节内容主要是定义、分类、犯罪背景、起诉困难、犯罪手法案例和一般风险说明，所有命题已由基础KG充分表达，不存在超出定义、事实、案例或孤立风险指标的增量程序性或判断性有向结构。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="780" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH03-S07" id="page_315598fc08"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="3730" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_e6dee3531b" value="CH03-S07 Examples of predicate crimes &amp;gt; Case example: Mr. Wolfe’s scheme" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_650ad85976" value="status=ok | cards=6 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_27ef529bab" value="CH03-S07 / card 1: 资金获得后中间人采用复杂洗钱方法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_d4fd37df45" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_131f6ab145" value="&lt;b&gt;触发：&lt;/b&gt;资金提供者获得资金&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000277&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_03737c6b36" value="&lt;b&gt;步骤：&lt;/b&gt;中间人采用复杂洗钱方法掩盖来源和去向&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000277&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_7f6b643f67" value="PRECEDES / 一旦资金提供者获得资金" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_131f6ab145" target="v_03737c6b36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_39de565b64" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：资金提供者获得资金（事件）触发中间人采用复杂洗钱方法（动作）；KG不足：基础KG可保存该事实但无法表达“一旦…就…”的条件导向关系；选项判断：可帮助确认或排除关于中间人介入时机的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_99d79c2f61" value="CH03-S07 / card 2: 金融机构交易监控系统检测并标记可疑活动" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_1b613709c5" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_c363ae8e39" value="&lt;b&gt;输入：&lt;/b&gt;结构化存款、快速跨境分层及与已知恐怖钱包关联的异常资金流动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000283&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="827" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_e0dd2ea700" value="&lt;b&gt;步骤：&lt;/b&gt;金融机构交易监控系统检测并标记可疑活动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000283&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_18631717d4" value="&lt;b&gt;产出：&lt;/b&gt;标记为可疑活动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000283&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_82ed8d6cd1" value="作为输入或线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_c363ae8e39" target="v_e0dd2ea700"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4ba40f50e1" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_e0dd2ea700" target="v_18631717d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_a89e6a1db1" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：金融机构交易监控系统将特定异常交易模式作为依据进行检测，并产生标记结果；KG不足：基础KG可保存“系统检测”事实，但不能表达检测所依据的具体输入模式和标记结果的有向关系；选项判断：可确认系统标记了哪些类型的活动，或系统基于何种输入产生标记；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_f9dee28f6b" value="CH03-S07 / card 3: 区块链分析公司提供取证情报追踪非法加密资产流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1345" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_f72051bea6" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1379" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_94fca7ac78" value="&lt;b&gt;输入：&lt;/b&gt;暗网市场和高风险交易所的非法加密资产流&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000284&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1427" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_27a4059c87" value="&lt;b&gt;步骤：&lt;/b&gt;区块链分析公司追踪并映射非法加密资产流&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000284&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1427" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_85698dd8df" value="&lt;b&gt;产出：&lt;/b&gt;取证情报&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000284&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1552" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_602b4f1435" value="作为输入或线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_94fca7ac78" target="v_27a4059c87"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_8eb4829592" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_27a4059c87" target="v_85698dd8df"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_969d6e5d31" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：区块链分析公司基于暗网市场和高风险交易所的加密资产流进行追踪分析，产出取证情报；KG不足：基础KG可保存该事实但无法表达分析输入与产出的有向关系；选项判断：可帮助回答关于区块链分析公司作用或其分析对象的问题；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1672" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_1c5f46f12a" value="CH03-S07 / card 4: FIUs综合分析银行SARs和跨境活动触发红旗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1945" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_0aafe414df" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1979" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_14c5b2175e" value="&lt;b&gt;输入：&lt;/b&gt;银行可疑交易报告（SARs）与跨境金融活动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000285&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="2027" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_03fb999d58" value="&lt;b&gt;步骤：&lt;/b&gt;FIUs综合分析银行SARs与跨境金融活动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000285&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2027" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_5f629a5560" value="&lt;b&gt;产出：&lt;/b&gt;触发国际监管网络红旗信号&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000285&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2152" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_26634b1967" value="作为输入或线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_14c5b2175e" target="v_03fb999d58"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9d6eab0128" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_03fb999d58" target="v_5f629a5560"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_ac347d90f5" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：FIUs将银行SARs和跨境活动作为分析输入，产生红旗发现；KG不足：基础KG可保存分析事实，但不能表达输入与触发红旗的有向链条；选项判断：可确认FIU的分析依据及产生的信号类型；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2272" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_e0bbaa502a" value="CH03-S07 / card 5: FIU升级案件后执法机构开展针对性监控" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="2545" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_dc778b04c8" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="2579" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_f0736aa890" value="&lt;b&gt;步骤：&lt;/b&gt;FIUs升级处置案件&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000286&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2627" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_a57da8098f" value="&lt;b&gt;步骤：&lt;/b&gt;执法机构进行针对性监控以追踪现金走私者和哈瓦拉网络&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000286&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2752" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_3c7a5fb686" value="PRECEDES / As FIUs escalated the case" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_f0736aa890" target="v_a57da8098f"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_95f348031f" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：FIUs升级案件的动作触发执法机构后续的监控行动；KG不足：基础KG可分别保存升级和监控事实，但无法表达升级触发监控的有向顺序；选项判断：可帮助回答关于案件升级后谁采取了什么行动，或执法机构行动的前提条件；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2872" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_ed460023f1" value="CH03-S07 / card 6: 执法机构协调资产冻结导致查封和瓦解" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="3145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_95b022113d" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="3179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_291c8e656f" value="&lt;b&gt;步骤：&lt;/b&gt;执法机构协调资产冻结&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000287&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="3227" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_5de323cc80" value="&lt;b&gt;产出：&lt;/b&gt;查封数字钱包&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000287&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="3352" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_cb983e8848" value="&lt;b&gt;结束：&lt;/b&gt;瓦解用于资助恐怖主义的公司&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000287&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="3444" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_90cc25c898" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_291c8e656f" target="v_5de323cc80"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_37882b0298" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_291c8e656f" target="v_cb983e8848"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_091af76336" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：执法机构的资产冻结动作直接导致查封数字钱包和瓦解公司的结果；KG不足：基础KG可保存冻结、查封和瓦解等事实，但不能表达冻结产生这些结果的有向因果链；选项判断：可帮助确认资产冻结的具体直接后果；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="3472" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH05-S04" id="page_f7929796b0"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_9ee732fe4c" value="CH05-S04 Financial crime risks in relation to other types of risks &amp;gt; Operational, legal, concentration, and reputational risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_aecb82c0a8" value="status=ok | cards=1 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_a6ecf35238" value="CH05-S04 / card 1: 全球组织以母国标准为基础并适应东道国法律" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_4f3cbb7538" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_694e570585" value="&lt;b&gt;标准：&lt;/b&gt;母国监管机构政策&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000376&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_5ac3c6b171" value="&lt;b&gt;标准：&lt;/b&gt;各东道国法律&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000376&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_c7d69d553c" value="&lt;b&gt;步骤：&lt;/b&gt;全球组织通常以母国监管机构政策为基础标准&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000376&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_5ea8ff21d4" value="&lt;b&gt;步骤：&lt;/b&gt;全球组织然后根据各东道国法律进行调整&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000376&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_8a38782cca" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_694e570585" target="v_c7d69d553c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_54f7c3d903" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5ac3c6b171" target="v_5ea8ff21d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d0c7135677" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_c7d69d553c" target="v_5ea8ff21d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_b271205098" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：全球组织先以母国政策为基础标准，再根据东道国法律进行调整（顺序性）；KG不足：基础KG只能将该实践保存为一条事实，无法表达“先……然后……”的有向动作序列；选项判断：可据以判断或排除涉及全球化组织政策制定顺序的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH06-S09" id="page_6d4a3a4bcc"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2530" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_4cd2e47d13" value="CH06-S09 Money Laundering Risks in Financial Services &amp;gt; Politically exposed person risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_db25fab205" value="status=ok | cards=4 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_92bf21156f" value="CH06-S09 / card 1: 当地监管要求约束PEP识别义务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_acdff3a423" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_157173e242" value="&lt;b&gt;标准：&lt;/b&gt;当地监管要求&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000459&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_e4aae76c38" value="&lt;b&gt;步骤：&lt;/b&gt;机构必须依据当地监管要求识别PEP&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000459&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_9f98b5e2e6" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_157173e242" target="v_e4aae76c38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_f777f25d95" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：当地监管要求 --constrains--&amp;gt; 机构识别PEP的义务；KG不足：基础KG不能表达标准约束具体识别动作的内部有向关系；选项判断：可确认或排除关于识别PEP是否必须遵循当地监管要求的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="347" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_46fe4bbb1a" value="CH06-S09 / card 2: 风险偏好指导选择更高PEP标准" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_1d5e4f873a" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_b690e9c3a2" value="&lt;b&gt;标准：&lt;/b&gt;机构的风险偏好&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000460&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="827" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_c73fbb2702" value="&lt;b&gt;步骤：&lt;/b&gt;机构可选择执行更高的PEP标准&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000460&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_0c7c8f454c" value="作为判定标准或规范依据 / 基于其风险偏好" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_b690e9c3a2" target="v_c73fbb2702"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_0541c7a8b4" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：风险偏好 --guides--&amp;gt; 机构可选择执行更高的PEP标准；KG不足：基础KG不能表达风险偏好作为条件导向标准选择的方向性；选项判断：可确认或排除关于选择更高标准是否需要依据风险偏好的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="947" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_72204cf9e2" value="CH06-S09 / card 3: 部分机构在个人卸任后仍维持PEP分类" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1345" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_740fedce8e" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1379" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_da933fefa9" value="&lt;b&gt;触发：&lt;/b&gt;个人已卸任，但可能保持影响力&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000477&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1427" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_1676ee1754" value="&lt;b&gt;步骤：&lt;/b&gt;部分机构维持PEP分类&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000477&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1552" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_5bc157b841" value="PRECEDES / 即使已卸任，仍可能保持影响力" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_da933fefa9" target="v_1676ee1754"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_9cdc1abd36" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：个人卸任（仍可能保持影响力）--conditions--&amp;gt; 部分机构维持PEP分类；KG不足：基础KG不能表达卸任条件与分类维持之间的有向判断链；选项判断：可确认部分机构即使个人卸任仍维持PEP，排除自动去分类的选项；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1672" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_8a3253b935" value="CH06-S09 / card 4: 机构必须基于风险偏好调整监控和审查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1945" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_1b2a7ca52f" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1979" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_8ae31db71a" value="&lt;b&gt;标准：&lt;/b&gt;机构的风险偏好&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000482&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="2027" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_9d27aa50ab" value="&lt;b&gt;步骤：&lt;/b&gt;机构必须调整交易监控、KYC审查并升级处理&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000482&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2027" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_6cc0a237d5" value="作为判定标准或规范依据 / 基于其风险偏好" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_8ae31db71a" target="v_9d27aa50ab"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_d6e60e7cd3" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：风险偏好 --constrains--&amp;gt; 机构必须调整监控、KYC审查并升级；KG不足：基础KG不能表达该义务的内部有向约束关系；选项判断：可确认调整监控必须基于风险偏好的义务，排除无需基于风险偏好的说法；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2147" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH06-S10" id="page_d2d558ade0"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_19e0567cef" value="CH06-S10 Money Laundering Risks in Financial Services &amp;gt; Control and ownership for AML compliance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_d2482f18b7" value="status=ok | cards=2 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_9acac897b9" value="CH06-S10 / card 1: 基于风险方法的UBO识别程序" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_cf7580fb5b" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_cfbf4f69c1" value="&lt;b&gt;标准：&lt;/b&gt;持股阈值标准：通常25%或以上，高风险客户可低至10%甚至5%&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000489, v7u_N000491&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7a392afa23" value="&lt;b&gt;输入：&lt;/b&gt;直接和间接持股信息&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000493&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_b51c73d692" value="&lt;b&gt;触发：&lt;/b&gt;审查客户所有权结构&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000488&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_7843bbb4de" value="&lt;b&gt;步骤：&lt;/b&gt;合计直接和间接持股比例并与阈值比较进行评估&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000489, v7u_N000493, v7u_N000494, v7u_N000495&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="319" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_7ddbdae089" value="&lt;b&gt;步骤：&lt;/b&gt;机构基于风险方法识别客户的UBO&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000488, v7u_N000490&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_eb3ef2a560" value="&lt;b&gt;产出：&lt;/b&gt;UBO认定结果（达到阈值者被认定为UBO）&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000494, v7u_N000495&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="444" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_d472269320" value="PRECEDES / 当审查所有权结构时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_b51c73d692" target="v_7ddbdae089"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f33a090c10" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_cfbf4f69c1" target="v_7ddbdae089"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d1b47009b9" value="作为识别线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_7a392afa23" target="v_7ddbdae089"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0a0af03908" value="作为识别线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_7a392afa23" target="v_7843bbb4de"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ae69a36ebb" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_cfbf4f69c1" target="v_7843bbb4de"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_8760a973bf" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_7843bbb4de" target="v_eb3ef2a560"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_2f97a98947" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：审查所有权结构 --条件触发(PRECEDES)--&amp;gt; 机构基于风险方法识别客户的UBO；识别过程需参照持股阈值标准（通常25%，高风险可降至10%或5%）和直接间接持股信息。KG不足：基础KG仅能保存“需识别UBO”、“25%阈值”等孤立事实，无法表达条件触发识别动作、风险调整阈值约束识别过程、以及持股信息作为识别依据的有向关系。选项判断：可确认或排除关于识别UBO的顺序、条件、阈值适用、风险调整方法以及必须考虑间接持股等选项。LLM推理：无" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_26e8435c25" value="CH06-S10 / card 2: 无自然人UBO时的替代识别" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_c9f196f942" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_0d233a767d" value="&lt;b&gt;触发：&lt;/b&gt;公司中不存在自然人受益所有人&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000496&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_d831b0dfad" value="&lt;b&gt;步骤：&lt;/b&gt;机构识别并核实控制人或名义受益所有人&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000496&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_b46959937a" value="PRECEDES / 当公司中不存在自然人受益所有人时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_0d233a767d" target="v_d831b0dfad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_d7df1507f2" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：公司中不存在自然人受益所有人 --条件触发(PRECEDES)--&amp;gt; 机构识别并核实控制人或名义受益所有人。KG不足：KG仅能保存规则文本，无法表达“无自然人”条件触发替代识别动作的有向关系。选项判断：可帮助确定在缺少自然人UBO时的正确后续动作。LLM推理：无" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH07-S03" id="page_bf17a33794"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_e33179320a" value="CH07-S03 Money laundering risks associated with retail and commercial banking &amp;gt; Credit-related product risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_815ecbdf5c" value="status=ok | cards=2 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_6d413aa641" value="CH07-S03 / card 1: 知道或怀疑非法资金还贷时银行不应接受还款" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_8e6a9d6954" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_140ea3952d" value="&lt;b&gt;触发：&lt;/b&gt;银行知道或怀疑客户使用非法资金还贷&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000554&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_1abe18a501" value="&lt;b&gt;步骤：&lt;/b&gt;银行不应接受该资金用于还贷&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000554&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_bafda41b83" value="PRECEDES / 银行知道或怀疑客户使用非法资金还贷" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_140ea3952d" target="v_1abe18a501"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_cf2b09cb11" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：银行知道或怀疑非法资金还贷 → 银行不应接受该资金（条件触发禁止性动作）；KG不足：基础KG不能表达条件导向的具体应对动作的有向关系；选项判断：可确认在知道或怀疑非法资金时，银行应采取禁止接受还款的应对措施；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_6488dc2103" value="CH07-S03 / card 2: 退出超出风险容忍度的客户时核销贷款需充分理由和批准" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_33db5e01f5" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_e7153181b5" value="&lt;b&gt;标准：&lt;/b&gt;通常需要充分理由和批准&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000555&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="827" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_46611eb7d5" value="&lt;b&gt;步骤：&lt;/b&gt;银行核销贷款&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000555&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_bfebf6537b" value="作为判定标准或规范依据 / 退出超出风险容忍度的客户关系时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_e7153181b5" target="v_46611eb7d5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_bb400cc28a" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：退出超出风险容忍度的客户时，银行核销贷款（动作）受约束于需要充分理由和批准（标准）；KG不足：基础KG可以表达核销需要理由这一事实，但不能表达该约束与特定退出场景的条件化关联；选项判断：可确认在退出超出容忍度的客户时，核销贷款需要额外审批要求；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="947" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH08-S05" id="page_26e75a967d"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_58152aba1a" value="CH08-S05 Private banking and wealth management risks &amp;gt; Special purpose vehicle risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_269a99ace1" value="status=ok | cards=1 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_c1c377c16c" value="CH08-S05 / card 1: 强化尽职调查（EDD）对SPV和PIV的要求" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_20b4a27a4e" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_873e2ff9f8" value="&lt;b&gt;输入：&lt;/b&gt;SPVs and PIVs&lt;br&gt;(特殊目的载体和集合投资工具)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000658&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_357c347524" value="&lt;b&gt;标准：&lt;/b&gt;CDD regulations such as the&lt;br&gt;Financial Crime Enforcement&lt;br&gt;Network&amp;#x27;s CDD rule&lt;br&gt;(客户尽职调查规则)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000658&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7b1866ef1b" value="&lt;b&gt;步骤：&lt;/b&gt;金融机构必须对SPV和PIV进行强化尽职调查，包括识别最终受益所有人并了解真实目的&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000658, v7u_N000659&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_5c82a6b4a8" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_357c347524" target="v_7b1866ef1b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fe302beb92" value="作为输入或线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_873e2ff9f8" target="v_7b1866ef1b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_9ca64657b8" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：金融机构必须执行EDD --REFERENCES--&amp;gt; CDD规则（标准约束动作），且EDD包含识别UBO和了解真实目的。KG不足：基础KG可能保存了EDD义务的一般事实，但未能表达EDD过程必须参照CDD规则的具体有向约束以及EDD内部子动作（识别UBO、了解目的）在程序上的从属关系。选项判断：可以帮助判断金融机构在EDD过程中是否必须识别UBO并遵守CDD规则，以及EDD适用的对象（SPV/PIV）。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="347" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH12-S04" id="page_c7136e875b"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2530" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_cab1dc210f" value="CH12-S04 Money laundering risks associated with insurance, securities, brokerage, and custodian services &amp;gt; Securities and brokerage risks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_1f6cc6bda1" value="status=ok | cards=4 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_1a1475757c" value="CH12-S04 / card 1: 资产管理公司CDD流程要求了解所有交易方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_680f721bd6" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_b76cd44f28" value="&lt;b&gt;标准：&lt;/b&gt;必须了解所有交易方&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000936&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_bf97f554e5" value="&lt;b&gt;步骤：&lt;/b&gt;资产管理公司：执行客户尽职调查（CDD）流程&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000936&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_341c343736" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_b76cd44f28" target="v_bf97f554e5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_219c6f074f" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：资产管理公司的CDD流程必须参照“了解所有交易方”这一要求（standard_constrains_action）。KG不足：基础KG仅解释CDD复杂且需了解所有方，未表达流程对要求的参照关系。选项判断：可确认资产管理公司CDD范围必须涵盖所有交易方。LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="347" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_6f589cd91c" value="CH12-S04 / card 2: 高风险客户需要进行仔细的风险评估" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_03c7884c52" value="nature=assessment | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_099c46b01d" value="&lt;b&gt;触发：&lt;/b&gt;客户为高风险（如PEPs）或中介&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000921&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_1f3136f4a4" value="&lt;b&gt;步骤：&lt;/b&gt;需要进行仔细的风险评估&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000921&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="952" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_661549291d" value="PRECEDES / 当客户为高风险或中介时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_099c46b01d" target="v_1f3136f4a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_34f0675c98" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;原文明确要求高风险客户需要仔细风险评估，构建条件触发评估流程，限定词进入节点标签与边。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1072" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_e4402205ac" value="CH12-S04 / card 3: 持续监控及基于预定义标准的系统标记帮助识别洗钱模式与具体交易" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1345" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_3f7a7148b8" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1379" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_19c9b93f44" value="&lt;b&gt;标准：&lt;/b&gt;预定义标准&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000923&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1427" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_778c4623a8" value="&lt;b&gt;步骤：&lt;/b&gt;持续监控交易活动&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000923&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1427" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_f0581b8f45" value="&lt;b&gt;步骤：&lt;/b&gt;稳健的交易监控系统基于预定义标准标记可疑交易&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000923&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1519" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_10cfcb061e" value="&lt;b&gt;产出：&lt;/b&gt;可以帮助识别可能表明洗钱的异常模式或行为&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000923&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1552" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_d26e62649f" value="&lt;b&gt;产出：&lt;/b&gt;可以帮助识别大额或异常交易、快速交易模式、高频交易及涉及高风险司法管辖区的交易&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000923&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1644" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_328800135c" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_778c4623a8" target="v_10cfcb061e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4c490996a8" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_19c9b93f44" target="v_f0581b8f45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_8bc53b0893" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_f0581b8f45" target="v_d26e62649f"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_4fdada2a2e" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;涵盖v7u_N000923两句话：持续监控帮助识别异常模式；系统基于标准标记帮助识别具体交易。未连接无证据的边。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1672" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_78cb2e5924" value="CH12-S04 / card 4: 客户尽职调查有助于确保资金合法并基于交易模式细分客户" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1945" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_329f24ec71" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1979" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_a4d185602d" value="&lt;b&gt;标准：&lt;/b&gt;预期和历史交易模式&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000924&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="2027" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_64e4379398" value="&lt;b&gt;步骤：&lt;/b&gt;执行客户尽职调查（CDD）&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000924&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2027" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_f8b401b2dd" value="&lt;b&gt;产出：&lt;/b&gt;有助于确保资金来源合法&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000924&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2152" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_514ffa639b" value="&lt;b&gt;产出：&lt;/b&gt;有助于确保按照预期和历史交易模式正确细分客户&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N000924&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2244" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_ed48f77f9d" value="作为判定标准或规范依据" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a4d185602d" target="v_64e4379398"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_48fe2238f2" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_64e4379398" target="v_f8b401b2dd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_232bdc8ef6" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_64e4379398" target="v_514ffa639b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_2625e977fd" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;表达CDD的有向效果：参照预期和历史交易模式，帮助确保资金合法与客户正确细分。限定词进入节点标签。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2272" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S04" id="page_6d804c0135"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_ea75b61b3a" value="CH47-S04 Transaction monitoring &amp;gt; Transaction monitoring system tuning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_bbbba95a75" value="status=ok | cards=2 | errors=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_2b343011f5" value="CH47-S04 / card 1: 动态调优触发专项评估" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_a4d8c8f8bd" value="nature=control | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_0b9b68d2b3" value="&lt;b&gt;触发：&lt;/b&gt;重大事件或趋势发生&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003286&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_b91d0a4ed1" value="&lt;b&gt;步骤：&lt;/b&gt;机构应进行专项评估（调优）&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003286&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_a963b309d9" value="PRECEDES / 发生重大事件或趋势时" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_0b9b68d2b3" target="v_b91d0a4ed1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_7fe4cd6fcb" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：重大事件或趋势（E6_change_exception）触发机构应进行专项评估（P8_constrained_action）；KG不足：基础KG只能保存静态规则，不能表达条件触发关系；选项判断：可确认或排除动态调优的触发条件和应执行的动作；LLM推理：无。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="472" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_a9f78ab244" value="CH47-S04 / card 2: 场景设置参照经验创建、修改或移除检测规则和场景" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="745" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_75ecd6b81a" value="nature=execution | review=None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="779" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_75681a9f91" value="&lt;b&gt;输入：&lt;/b&gt;以往可疑活动经验和实际事件&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003279&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="827" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_a9a9d423c9" value="&lt;b&gt;步骤：&lt;/b&gt;基于以往可疑活动和实际事件经验创建、修改或移除检测规则和场景&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003279&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="827" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_74b92118d3" value="作为输入或线索" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_75681a9f91" target="v_a9a9d423c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_b00b81a94a" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;增量命题：场景设置动作参照以往经验；选项判断：可确定场景设置时的输入依据。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="947" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>