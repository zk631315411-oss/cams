    },
    {
      "i": 5151,
      "keep": true,
      "knowledge": "明知故犯是进行禁止行为的心理状态。",
      "type": "定义"
    },
    {
      "i": 5152,
      "keep": true,
      "knowledge": "2012年金融行动特别工作组40项建议第3项的解释性说明指出，证明洗钱犯罪所需的意图和认识应该与《维也纳公约》和《巴勒莫公约》所设定的标准一致。",
      "type": "法规"
    },
    {
      "i": 5153,
      "keep": true,
      "knowledge": "反洗钱法律对明知的准确定义因国家而异。",
      "type": "事实"
    },
    {
      "i": 5154,
      "keep": true,
      "knowledge": "在某些情况下，明知可认为包括有意忽视。",
      "type": "事实"
    },
    {
      "i": 5155,
      "keep": true,
      "knowledge": "有意忽视即有意避免对事实的认识。",
      "type": "定义"
    },
    {
      "i": 5156,
      "keep": true,
      "knowledge": "替代性汇款体系是地下钱庄或非正规价值转移体系。",
      "type": "定义"
    },
    {
      "i": 5157,
      "keep": true,
      "knowledge": "替代性汇款体系通常与中东、非洲或亚洲的族群相关，且通常涉及银行体系以外的跨国价值转移。",
      "type": "事实"
    },
    {
      "i": 5158,
      "keep": true,
      "knowledge": "替代性汇款体系的汇款实体可以是与另一国家或地区代理企业有协议关系的从事商品销售的普通商店。",
      "type": "事实"
    },
    {
      "i": 5159,
      "keep": true,
      "knowledge": "替代性汇款体系通常不存在货币的实际转移且缺少关于身份验证和记录保存方面的正规手续。",
      "type": "事实"
    }
