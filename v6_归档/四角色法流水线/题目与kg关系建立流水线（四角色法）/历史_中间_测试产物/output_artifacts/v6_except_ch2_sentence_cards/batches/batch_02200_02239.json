      "local_label": true
    },
    {
      "i": 2223,
      "keep": true,
      "knowledge": "监控交易并识别可疑活动异常情况的能力",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2224,
      "keep": true,
      "knowledge": "采集新老客户的客户尽职调查信息，对客户回应进行打分并存储客户尽职调查数据以备后续使用的能力",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2225,
      "keep": true,
      "knowledge": "根据各个客户的风险状况和同类客户群的风险特征，由监控系统识别可疑和异常交易并进行高级评估和分析的能力",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 2226,
      "keep": true,
      "knowledge": "结合客户在本组织内的所有活动在较广范围内审视个别警示信号的能力",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 2227,
      "keep": true,
      "knowledge": "工作流程特征，包括根据一次或者一系列警示信号创建案例的能力，多个利益集团之间（同步或连续）合作审查和更新信息以及在监控和调查部门以及整个组织（必要时）共享反洗钱/反恐融资信息的能力",
