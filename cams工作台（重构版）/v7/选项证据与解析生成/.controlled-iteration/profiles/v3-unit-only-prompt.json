      "cwd": "{workspace}",
      "timeout_seconds": 60,
      "required_env": []
    },
    "variant": {
      "argv": [
        "python",
        ".controlled-iteration/run_v3_prompt_arm.py",
        "--arm",
        "variant",
        "--source-question",
        "{baseline_ref}",
        "--artifact-dir",
        "{artifact_dir}"
      ],
      "cwd": "{workspace}",
      "timeout_seconds": 240,
      "required_env": ["DEEPSEEK_API_KEY"]
