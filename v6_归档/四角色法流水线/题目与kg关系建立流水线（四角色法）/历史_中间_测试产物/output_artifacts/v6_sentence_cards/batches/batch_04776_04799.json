{
  "batch_start": 4776,
  "items": [
    {
      "i": 4776,
      "keep": true,
      "knowledge": "内部备忘录、交易凭证、日志等文件中隐含着重要信息。",
      "type": "事实"
    },
    {
      "i": 4777,
      "keep": true,
      "knowledge": "金融组织必须确保相关文件未被篡改、遗失或损毁且所有员工都已知晓。",
      "type": "事实"
    },
    {
      "i": 4778,
      "keep": true,
      "knowledge": "规定可以通过备忘录向所有相关人员传达。",
      "type": "流程"
    },
    {
      "i": 4779,
      "keep": true,
      "knowledge": "如果备忘录可能提醒员工篡改或损毁文件，则必须另当别论。",
      "type": "事实"
    },
    {
      "i": 4780,
      "keep": true,
      "knowledge": "组织应建立文档销毁制度，确保调查期间不得销毁文件。",
      "type": "流程"
    },
    {
      "i": 4781,
      "keep": true,
      "knowledge": "与政府调查有关的文件在收到调查通知前按规定销毁，不会产生严重影响。",
      "type": "事实"
    },
    {
      "i": 4782,
      "keep": true,
      "knowledge": "接到调查通知后销毁文件，即使未收到传票且出于合法政策，也会成为严重问题。",
      "type": "事实"
    },
    {
      "i": 4783,
      "keep": true,
      "knowledge": "金融组织应确保原始文件完整性，同时尽量不影响业务开展。",
      "type": "事实"
    },
    {
      "i": 4784,
      "keep": true,
      "knowledge": "金融组织必须建立有效的文件保管系统，用于文件整理、维护、编号、保护和复制。",
      "type": "流程"
    },
    {
      "i": 4785,
      "keep": true,
      "knowledge": "为方便寻找，文件应该建立索引。",
      "type": "流程"
    },
    {
      "i": 4786,
      "keep": true,
      "knowledge": "收集文档时应创建详细的权限日志，并将权限文档与其他文档分开。",
      "type": "流程"
    },
    {
      "i": 4787,
      "keep": true,
      "knowledge": "向调查人员提供有助于得出调查结论的信息可能是终止调查最有效的方法。",
      "type": "事实"
    },
    {
      "i": 4788,
      "keep": true,
      "knowledge": "配合调查包括安排员工接受面谈，在不要求作证传票的情况下提供文件。",
      "type": "流程"
    },
    {
      "i": 4789,
      "keep": true,
      "knowledge": "配合调查还包括主动披露相关信息并提供专业顾问书写的报告。",
      "type": "流程"
    },
    {
      "i": 4790,
      "keep": true,
      "knowledge": "金融组织应尽量与调查人员和检察官保持积极的关系。",
      "type": "事实"
    },
    {
      "i": 4791,
      "keep": true,
      "knowledge": "积极的工作关系有助于金融组织有效开展内部调查并回应调查和检察质询。",
      "type": "事实"
    },
    {
      "i": 4792,
      "keep": true,
      "knowledge": "充分了解调查人员和检察官对事件的看法对金融组织非常重要。",
      "type": "事实"
    },
    {
      "i": 4793,
      "keep": true,
      "knowledge": "如果调查人员和检察官对部分事实存在误解，金融组织有机会进行纠正。",
      "type": "事实"
    },
    {
      "i": 4794,
      "keep": true,
      "knowledge": "了解调查人员和检察官的关注点能使金融组织的回应更有针对性。",
      "type": "事实"
    },
    {
      "i": 4795,
      "keep": true,
      "knowledge": "在特别重大、重要或严重的调查中，金融组织可能需要聘请法律顾问。",
      "type": "流程"
    },
    {
      "i": 4796,
      "keep": true,
      "knowledge": "包括大型银行和证券经销商在内的很多金融组织都聘有内部法律顾问。",
      "type": "事实"
    },
    {
      "i": 4797,
      "keep": true,
      "knowledge": "小型货币服务企业等很多其他机构不一定拥有内部法律顾问。",
      "type": "事实"
    },
    {
      "i": 4798,
      "keep": true,
      "knowledge": "在政府对金融组织展开调查时，最好聘请或咨询外部资深法律顾问。",
      "type": "流程"
    },
    {
      "i": 4799,
      "keep": true,
      "knowledge": "面临迫在眉睫的刑事起诉或控告时，需聘请资深律师为金融组织辩护。",
      "type": "流程"
    }
  ]
}