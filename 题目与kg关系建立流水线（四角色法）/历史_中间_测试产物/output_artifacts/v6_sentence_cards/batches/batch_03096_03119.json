{
  "batch_start": 3096,
  "items": [
    {
      "i": 3096,
      "keep": true,
      "knowledge": "风险为本的分析应涵盖国家、行业、法律实体和业务关系层面的适当固有风险与剩余风险。",
      "type": "定义"
    },
    {
      "i": 3097,
      "keep": true,
      "knowledge": "金融组织应充分认识其客户基础、产品、销售渠道、服务及业务和客户所在司法管辖区的固有风险。",
      "type": "流程"
    },
    {
      "i": 3098,
      "keep": true,
      "knowledge": "组织应根据其收集的业务、交易或其他内部信息和外部信息，充分认识上述风险。",
      "type": "流程"
    },
    {
      "i": 3099,
      "keep": true,
      "knowledge": "为识别所有的洗钱/恐怖融资风险，必须全面考虑所有信息。",
      "type": "事实"
    },
    {
      "i": 3100,
      "keep": true,
      "knowledge": "识别洗钱/恐怖融资风险通常要求业务、风险管理、合规和法务部门的专家参与，有时可能还需听取外部专家的建议。",
      "type": "流程"
    },
    {
      "i": 3101,
      "keep": true,
      "knowledge": "新的商业产品和服务尤其需要进行洗钱和制裁漏洞方面的评估，在进入市场前事先采取适当的管控措施。",
      "type": "流程"
    },
    {
      "i": 3102,
      "keep": true,
      "knowledge": "组织还应考虑有关洗钱/恐怖融资风险评估的公开指南，此类指南数量越来越多，且非常有用。",
      "type": "事实"
    },
    {
      "i": 3103,
      "keep": true,
      "knowledge": "洗钱/恐怖融资风险评估的公开指南由金融行动特别工作组、区域性组织、监管机构及联合国等组织定期发布。",
      "type": "事实"
    },
    {
      "i": 3104,
      "keep": true,
      "knowledge": "风险是动态变化的，需要持续进行管理。",
      "type": "事实"
    },
    {
      "i": 3105,
      "keep": true,
      "knowledge": "每个机构的营业环境不断变化，这一点也应注意。",
      "type": "事实"
    },
    {
      "i": 3106,
      "keep": true,
      "knowledge": "某司法管辖区的政治局势变化以及是否对其施加或取消经济制裁可能影响一国的风险评级。",
      "type": "事实"
    },
    {
      "i": 3107,
      "keep": true,
      "knowledge": "组织内部需要根据市场和客户需求变化，合并或收购其他公司，引入新产品、新服务，实施新的销售系统。",
      "type": "事实"
    },
    {
      "i": 3108,
      "keep": true,
      "knowledge": "这些变化共同决定了对审查洗钱/恐怖融资风险模型进行定期审查是非常关键的。",
      "type": "事实"
    },
    {
      "i": 3109,
      "keep": true,
      "knowledge": "某些国家强制要求组织定期审查风险模型（通常一年一次），或在新产品、新销售渠道和新客户类型出现时进行审查。",
      "type": "法规"
    },
    {
      "i": 3110,
      "keep": true,
      "knowledge": "反洗钱/反恐融资风险类别可分为以下等级。",
      "type": "分类"
    },
    {
      "i": 3111,
      "keep": true,
      "knowledge": "禁止类：组织不得进行涉及这一风险的任何类型的任何交易。",
      "type": "定义"
    },
    {
      "i": 3112,
      "keep": true,
      "knowledge": "遭受经济制裁或被认定为资助恐怖主义活动的国家或地区均为禁止交易的对象。",
      "type": "事实"
    },
    {
      "i": 3113,
      "keep": true,
      "knowledge": "高风险：交易面临极大的风险，但不一定被禁止。",
      "type": "定义"
    },
    {
      "i": 3114,
      "keep": true,
      "knowledge": "为了缓释交易中的高度风险，金融组织应适用更严格的控制措施来降低洗钱/恐怖融资风险。",
      "type": "流程"
    },
    {
      "i": 3115,
      "keep": true,
      "knowledge": "以腐败或贩毒闻名的国家或地区一般都视为具有高风险。",
      "type": "事实"
    },
    {
      "i": 3116,
      "keep": true,
      "knowledge": "高风险客户包括政治公众人物，以及特定类型的货币服务企业或资金密集型企业。",
      "type": "分类"
    },
    {
      "i": 3117,
      "keep": true,
      "knowledge": "高风险产品和服务包括代理银行业务、私人银行业务、现金服务及国际电汇业务。",
      "type": "分类"
    },
    {
      "i": 3118,
      "keep": true,
      "knowledge": "中等风险需要进行额外审查，但尚未达到高风险的级别。",
      "type": "定义"
    },
    {
      "i": 3119,
      "keep": true,
      "knowledge": "低风险是洗钱风险的基线。",
      "type": "定义"
    }
  ]
