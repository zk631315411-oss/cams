html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_e5d4fc3741" target="v_7cf864887a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a0119c1a79" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_e5d4fc3741" target="v_92736df798"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_61cce21078" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_e5d4fc3741" target="v_ea14053abf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_29cfb30a78" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;weak inferred process order; non-procedural source material converted into risk_indicator card; trigger node is functional dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="597" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S06" id="page_b580feabf2"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2209" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_4c960dcb84" value="CH47-S06 Transaction monitoring &amp;gt; Procedures for alerts review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_52b05eb6bd" value="status=validation_failed | cards=1 | errors=1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_018270936e" value="CH47-S06 / card 1: Multi-Level Alert Review and Escalation Process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_95af5cee79" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_21bf10f6c6" value="&lt;b&gt;标准：&lt;/b&gt;Analyze transaction patterns&lt;br&gt;and frequency&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003303&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_3375db5786" value="&lt;b&gt;标准：&lt;/b&gt;Assess source and&lt;br&gt;destination of funds&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003304&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_422e6d2c98" value="&lt;b&gt;标准：&lt;/b&gt;Review KYC information and&lt;br&gt;customer risk profile&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003305&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_580751ebde" value="&lt;b&gt;标准：&lt;/b&gt;Gather additional records:&lt;br&gt;communication logs, prior&lt;br&gt;investigations&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003306&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_55d5f1f848" value="&lt;b&gt;标准：&lt;/b&gt;Conduct open-source research&lt;br&gt;: social media, news, public&lt;br&gt;records, regulatory alerts&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003307&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_83a84549ea" value="&lt;b&gt;标准：&lt;/b&gt;Cross-department&lt;br&gt;collaboration&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003310&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="752" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_5cf65cab3f" value="&lt;b&gt;标准：&lt;/b&gt;Complex risk assessments&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003310&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="857" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7fb5155f8f" value="&lt;b&gt;标准：&lt;/b&gt;Intricate analysis of&lt;br&gt;transaction networks&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003310&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="962" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_c92da0b803" value="&lt;b&gt;触发：&lt;/b&gt;TM system generates alert&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003297&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_f9983a7bd0" value="&lt;b&gt;步骤：&lt;/b&gt;Level 1 initial review:&lt;br&gt;examine alert and determine&lt;br&gt;if abnormal&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003298, v7u_N003299&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_c2924daa5b" value="&lt;b&gt;判断：&lt;/b&gt;Activity abnormal or exceeds&lt;br&gt;thresholds?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003300&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_c9de7eee43" value="&lt;b&gt;步骤：&lt;/b&gt;Dismiss as false positive&lt;br&gt;and document rationale&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003301&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_d36388ee04" value="&lt;b&gt;步骤：&lt;/b&gt;Escalate to Level 2 review&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003300&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_08b61532d4" value="&lt;b&gt;产出：&lt;/b&gt;Alert closed as false&lt;br&gt;positive&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003301&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_b906dc7843" value="&lt;b&gt;步骤：&lt;/b&gt;Level 2 Investigation:&lt;br&gt;detailed analysis to&lt;br&gt;establish if unusual&lt;br&gt;behavior indicates financial&lt;br&gt;crime&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003302&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="819" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_0be1d94a8a" value="&lt;b&gt;判断：&lt;/b&gt;Activity suspicious?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003308&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="852" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_3ec9982720" value="&lt;b&gt;产出：&lt;/b&gt;Alert resolved as not&lt;br&gt;suspicious&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003308&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="977" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_28b2443e41" value="&lt;b&gt;判断：&lt;/b&gt;Highly suspicious or&lt;br&gt;involves numerous&lt;br&gt;transactions or sensitive&lt;br&gt;situations?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003309&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="977" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_a79a358d3e" value="&lt;b&gt;步骤：&lt;/b&gt;Escalate to Level 3 complex&lt;br&gt;analysis&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003309&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1102" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_f94f0866d4" value="&lt;b&gt;步骤：&lt;/b&gt;Level 3 Comprehensive&lt;br&gt;Assessment: cross-department&lt;br&gt;collaboration, complex risk&lt;br&gt;assessments, intricate&lt;br&gt;network analysis&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003310&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1227" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_729f814900" value="&lt;b&gt;步骤：&lt;/b&gt;File SAR with regulatory&lt;br&gt;authorities if required,&lt;br&gt;include all pertinent&lt;br&gt;information and rationale&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003311&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_ce47cbc73f" value="&lt;b&gt;产出：&lt;/b&gt;SAR filed&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003311&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1477" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_369c06a01d" value="&lt;b&gt;步骤：&lt;/b&gt;Conduct ongoing monitoring&lt;br&gt;to mitigate further issues&lt;br&gt;and identify additional&lt;br&gt;criminal activities&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003312&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1569" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_03f452d441" value="&lt;b&gt;步骤：&lt;/b&gt;Recommend enhanced customer&lt;br&gt;monitoring or account&lt;br&gt;restrictions as preventive&lt;br&gt;measures&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003313&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_9e59fd39d6" value="&lt;b&gt;产出：&lt;/b&gt;Risk mitigated; ongoing&lt;br&gt;monitoring and preventive&lt;br&gt;measures in place&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003312, v7u_N003313&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1727" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_87bd38beb4" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_c92da0b803" target="v_f9983a7bd0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_c801c84c25" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_f9983a7bd0" target="v_c2924daa5b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f478528e96" value="DECIDES / no" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_c2924daa5b" target="v_c9de7eee43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9f25ffd75d" value="DECIDES / yes" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_c2924daa5b" target="v_d36388ee04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_1cfccfa85f" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_c9de7eee43" target="v_08b61532d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_31bf65e52a" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_d36388ee04" target="v_b906dc7843"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4