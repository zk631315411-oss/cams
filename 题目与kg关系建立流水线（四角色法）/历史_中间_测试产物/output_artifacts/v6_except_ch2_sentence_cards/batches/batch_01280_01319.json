{
  "batch_start": 1280,
  "items": [
    {
      "i": 1280,
      "keep": true,
      "knowledge": "违反经济制裁制度的交易",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1281,
      "keep": true,
      "knowledge": "其他因素，例如客户进行大量出乎意料之外的活动，如国内慈善机构收到多笔存款（例如现金和电汇）然后开展大规模国际交易，或正常情况下不需大量现金的企业接触大笔现金",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1282,
      "keep": true,
      "knowledge": "金融组织了解客户的活动后，可更好地确定该客户的实际风险。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1283,
      "keep": true,
      "knowledge": "正如之前所述，高风险客户以及风险评级因活动而调高的客户应接受增强尽职调查，以便缓释风险。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1284,
      "keep": true,
      "knowledge": "这种增强尽职调查可能最终确定客户的活动是否可疑。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1285,
      "keep": true,
      "knowledge": "如果可疑，客户记录应予以更新，以反映此活动造成的变化。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1286,
      "keep": true,
      "knowledge": "风险为本的方法的核心目的是评估金融组织的客户、地理位置/司法管辖区以及产品和服务的风险。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1287,
      "keep": true,
      "knowledge": "下文将更深入地分析这三大重要的风险因素。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1288,
      "keep": true,
      "knowledge": "风险评估中一个至关重要的步骤，是对组织所提供产品和服务的用户进行分析。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1289,
      "keep": true,
      "knowledge": "客户类型包括个人、上市公司、私营企业、合资企业、合伙企业和金融机构，基本包含任何希望与组织建立业务关系的客户。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1290,
      "keep": true,
      "knowledge": "有犯罪历史的客户会被评定为最高风险等级。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1291,
      "keep": true,
      "knowledge": "对政治人物和政治组织成员的评分也趋于最高。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1292,
      "keep": true,
      "knowledge": "跨国上市公司的风险评分一般低于非上市公司，因为在主要证交所上市的公司已经提供了大量公开信息，也进行了一定的尽职调查。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1293,
      "keep": true,
      "knowledge": "如果洗钱分子隐藏在公司组织形式之后，如信托、慈善组织、有限责任公司以及很难识别受益所有人的机构，风险通常更高。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1294,
      "keep": true,
      "knowledge": "如果客户公司位于反洗钱要求不健全或有严格公司保密法规保护的国家或地区，则风险将会进一步增加。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1295,
      "keep": true,
      "knowledge": "各国监管机构均已确认，一些客户类型本身即具有较高的洗钱风险，包括：",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1296,
      "keep": true,
      "knowledge": "位于避税 / 金融庇护所的离岸公司和银行",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1297,
      "keep": true,
      "knowledge": "货币服务企业，包括货币兑换所、汇款经纪公司和支票兑现所",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1298,
      "keep": true,
      "knowledge": "虚拟货币交易所",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1299,
      "keep": true,
      "knowledge": "汽车、船舶和飞机经销商",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1300,
      "keep": true,
      "knowledge": "二手车、二手卡车经销商和机械零部件生产商",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1301,
      "keep": true,
      "knowledge": "专业服务供应商（例如，律师、会计、投资经纪商，以及为客户提供金融联络服务的第三方）",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1302,
      "keep": true,
      "knowledge": "证券经纪经销商",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1303,
      "keep": true,
      "knowledge": "珠宝、宝石和贵金属经销商",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1304,
      "keep": true,
      "knowledge": "进出口公司",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1305,
      "keep": true,
      "knowledge": "现金密集型企业（如餐馆、零售商店、停车场等）",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1306,
      "keep": true,
      "knowledge": "以上为高风险行业的不完全名单。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1307,
      "keep": true,
      "knowledge": "值得注意的是，行业并非决定风险大小的唯一因素。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1308,
      "keep": true,
      "knowledge": "许多其他类型的企业也能被用于洗钱，因此审视风险时应结合许多其他因素。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1309,
      "keep": true,
      "knowledge": "在接纳客户时，以及开展业务关系期间，应落实严格有效的筛查程序，这是识别高风险客户类型的重要环节。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1310,
      "keep": true,
      "knowledge": "制定风险评分模型的关键步骤之一是评估司法管辖区风险。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1311,
      "keep": true,
      "knowledge": "个人客户的居住国或司法管辖区在哪？",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1312,
      "keep": true,
      "knowledge": "客户的国籍国又在哪？",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1313,
      "keep": true,
      "knowledge": "企业客户的总部在哪？",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1314,
      "keep": true,
      "knowledge": "它们的业务主营地又在哪？",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1315,
      "keep": true,
      "knowledge": "在评估不同区域和国家存在的洗钱风险方面，目前并没有明确且独立的系统。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1316,
      "keep": true,
      "knowledge": "一些企业会自行设计评估方法；",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1317,
      "keep": true,
      "knowledge": "其他企业则使用外部解决方案。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1318,
      "keep": true,
      "knowledge": "无论选择何种途径，对风险评级方法进行记录至关重要。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1319,
      "keep": true,
      "knowledge": "在较大的组织内，整体风险管理战略可能要求执行人员审查，并由高级管理层签批洗钱/恐怖融资风险评估结果。",
      "type": "风险指标",
      "local_label": true
    }
  ],
  "label_source": "local_rules"
}