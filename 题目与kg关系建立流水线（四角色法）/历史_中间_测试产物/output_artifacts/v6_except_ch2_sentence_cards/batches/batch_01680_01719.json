{
  "batch_start": 1680,
  "items": [
    {
      "i": 1680,
      "keep": true,
      "knowledge": "现有员工至少应参加年度培训课程。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1681,
      "keep": true,
      "knowledge": "新员工应在入职或转入新岗位后的合理期限内，接受与其职务相关的培训。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1682,
      "keep": true,
      "knowledge": "但也可能出现需要立即展开培训的紧急情况，或者是基本培训项目之外的增强培训。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1683,
      "keep": true,
      "knowledge": "例如，在检查或审计中发现洗钱控制措施存在严重缺陷之后，机构可能就有必要进行紧急培训；",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1684,
      "keep": true,
      "knowledge": "如果新闻提到本机构的名称或近期的监管活动，例如同意令 (Consent Order)，组织也应进行快速响应培训。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1685,
      "keep": true,
      "knowledge": "软件、系统、程序或规章的变化，以及影响特定业务线或部门的特定洗钱或其他非法金融活动风险，都是促成临时培训的因素。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1686,
      "keep": true,
      "knowledge": "有些组织设有培训中心，培训学员可以避免日常工作的干扰。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1687,
      "keep": true,
      "knowledge": "有些培训（如洗钱案例评析）更适合以小组的形式进行。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1688,
      "keep": true,
      "knowledge": "角色扮演练习是对课堂讲解或小组讨论的有益补充，同样采用小组的形式效果更佳。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1689,
      "keep": true,
      "knowledge": "这些培训可以在任何地点进行。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1690,
      "keep": true,
      "knowledge": "规模较大的机构可开展网络培训课程，设计自动记录出勤和测试等功能（设定及格线，确保学员对材料的最低掌握度）。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1691,
      "keep": true,
      "knowledge": "2016 年 2 月 25 日，金融犯罪执法网络和美国货币监理署 (OCC) 联合开展执法行动，以故意反洗钱违规的名义对美国佛罗里达州科勒尔盖布尔斯的 Gibraltar 私人银行和信托公司进行了处理。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1692,
      "keep": true,
      "knowledge": "该银行严重违反反洗钱制度，包括未能妥当培训合规人员，因此分别被美国货币监理署和金融犯罪执法网络处以 250 万美元和 400 万美元的民事罚款。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1693,
      "keep": true,
      "knowledge": "从 2009 年至 2014 年，该银行的反洗钱培训工作不充分，未按照特定岗位、部门、董事或其他员工的需求制定具体的培训项目。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1694,
      "keep": true,
      "knowledge": "例如，2009 年，高级银行官员接受的基本反洗钱课程是专为柜员设计的，与他们的职责不匹配。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1695,
      "keep": true,
      "knowledge": "2013 年 5 月，管理层开展的培训评估结果显示，银行需要开展重大培训项目，以便充分落实反洗钱制度。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1696,
      "keep": true,
      "knowledge": "一年后（2014 年），监管部门发现该银行仍不满足 2013 年评估中提出的培训需求。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1697,
      "keep": true,
      "knowledge": "至关重要的是，反洗钱培训应针对具体职责，并侧重于相关员工的责任和金融犯罪风险敞口。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1698,
      "keep": true,
      "knowledge": "高级官员和董事会成员不需要接受执行业务职能方面的培训，但他们确实需要了解反洗钱要求、违规处罚以及如何解释风险报告。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1699,
      "keep": true,
      "knowledge": "受监管公司可能因未能落实充分的反洗钱培训而受到重罚，如没有及时弥补已知差距则受到的处罚尤其严重。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1700,
      "keep": true,
      "knowledge": "仅仅建立反洗钱/反恐融资合规制度是不够的。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1701,
      "keep": true,
      "knowledge": "还必须对该制度进行监控和评估。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1702,
      "keep": true,
      "knowledge": "组织应该定期评估反洗钱/反恐融资合规制度，以确保其有效性并及时发现新的风险因素。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1703,
      "keep": true,
      "knowledge": "审计必须独立进行（即审计人员不应由组织内部的反洗钱/反恐融资合规部门员工担任），且审计人员应直接向董事会报告，或者直接向指定的董事委员会（主要或全部由外部董事组成）报告。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1704,
      "keep": true,
      "knowledge": "进行审计的人员必须具有充分的资质，以确保审计发现和结论的可靠性，包括具备反洗钱/反恐融资的知识和专业技术。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1705,
      "keep": true,
      "knowledge": "由于司法管辖区不同，独立审计也可能称为独立测试或独立审查。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1706,
      "keep": true,
      "knowledge": "评估反洗钱/反恐怖融资合规制度的整体完整性和有效性，包括政策、程序和流程。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1707,
      "keep": true,
      "knowledge": "评估反洗钱/反恐融资风险评估的充分性。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1708,
      "keep": true,
      "knowledge": "评估客户尽职调查政策、程序和流程的充分性，包括是否符合监管要求。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1709,
      "keep": true,
      "knowledge": "确定工作人员是否遵循组织的反洗钱/反恐怖融资政策、程序和流程。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1710,
      "keep": true,
      "knowledge": "进行适当的交易测试，重点关注高风险业务（产品、服务、客户和地理位置/司法管辖区）。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1711,
      "keep": true,
      "knowledge": "评估培训的充分性，包括其全面性、材料的准确性、培训日程、出勤记录和缺勤率上报流程。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1712,
      "keep": true,
      "knowledge": "评估制度是否符合组织业务所在司法管辖区的适用法律法规。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1713,
      "keep": true,
      "knowledge": "审查反洗钱/ 反恐融资合规制度中所用管理信息系统的完整性和准确性。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1714,
      "keep": true,
      "knowledge": "如果适用，审查应包括评估相关第三方独立系统的验证范围充分性和涉及人员的资质。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1715,
      "keep": true,
      "knowledge": "审查每个外包给第三方的反洗钱/反恐融资合规职能部门的方方面面，包括人员资质、合同、表现以及公司声誉。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1716,
      "keep": true,
      "knowledge": "通过以下措施，评估用于识别异常活动的交易监控软件应用的能力：",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1717,
      "keep": true,
      "knowledge": "审查与可疑活动监控相关的政策、程序和流程",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1718,
      "keep": true,
      "knowledge": "审查用于确保源交易处理系统提供的数据是否完整、准确、及时的流程",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1719,
      "keep": true,
      "knowledge": "评估用于建立和分析预期行为和筛选标准的方法",
      "type": "事实",
      "local_label": true
    }
  ],
  "label_source": "local_rules"
}