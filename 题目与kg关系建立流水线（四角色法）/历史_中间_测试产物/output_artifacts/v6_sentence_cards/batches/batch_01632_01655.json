    {
      "i": 1632,
      "keep": true,
      "knowledge": "公司组织形式有多种，一些被用于转移非法资金。",
      "type": "事实"
    },
    {
      "i": 1633,
      "keep": true,
      "knowledge": "犯罪分子可利用公司组织形式洗钱、行贿、掩藏资产和逃税。",
      "type": "案例"
    },
    {
      "i": 1634,
      "keep": true,
      "knowledge": "公司、合伙制企业、信托公司等组织形式是隐匿所有权和真实目的的有效方式。",
      "type": "事实"
    },
    {
      "i": 1635,
      "keep": true,
      "knowledge": "大多数司法管辖区的公司结构分为公众公司和私人有限公司两种。",
      "type": "分类"
    },
    {
      "i": 1636,
      "keep": true,
      "knowledge": "上市公司的股票可自由买卖，股东数量通常无限制，信息公开且受严格监管。",
      "type": "定义"
    },
    {
      "i": 1637,
      "keep": true,
      "knowledge": "非上市有限公司不可公开交易，股份数量受限，所有者可为一人及以上，监管相对宽松。",
      "type": "定义"
    },
    {
      "i": 1638,
      "keep": true,
      "knowledge": "有限责任公司是最常受到滥用的公司组织形式。",
      "type": "事实"
    },
    {
      "i": 1639,
      "keep": true,
      "knowledge": "有限责任公司的所有者和管理人员可匿名，因而很受犯罪分子喜爱。",
      "type": "事实"
    },
    {
      "i": 1640,
      "keep": true,
      "knowledge": "几乎任何人都可以拥有或管理一家有限责任公司，包括外籍人士及其他商业机构。",
      "type": "事实"
    },
    {
      "i": 1641,
      "keep": true,
      "knowledge": "有限责任公司的成员相当于公司的股东，管理者相当于公司的高管或董事。",
      "type": "定义"
    },
    {
      "i": 1642,
      "keep": true,
      "knowledge": "有些有限责任公司可能没有专职管理者，而是由其成员负责管理工作。",
      "type": "事实"
    },
    {
      "i": 1643,
      "keep": true,
      "knowledge": "金融犯罪执法网络采取措施监控有限责任公司，因各州对管理者、最终受益人和代名人的管控不同。",
      "type": "事实"
    },
    {
      "i": 1644,
      "keep": true,
      "knowledge": "国际商业公司是指在某人或公司常驻国境外建立的公司，通常出于保密或资产保护在离岸司法管辖区设立。",
      "type": "定义"
    },
    {
      "i": 1645,
      "keep": true,
      "knowledge": "国际商业公司可降低所有者所在国与离岸公司注册国之间的信息透明度。",
      "type": "事实"
    },
    {
      "i": 1646,
      "keep": true,
      "knowledge": "国际商业公司的优势包括资产保护、进入多个投资市场、不动产规划、合法税务优势和作为控股公司。",
      "type": "事实"
    },
    {
      "i": 1647,
      "keep": false,
      "knowledge": "",
      "type": "context"
    },
    {
      "i": 1648,
      "keep": true,
      "knowledge": "国际商业公司的固有风险包括设于避税天堂、需当地代理参与，代理可能降低透明度并帮助开立账户。",
      "type": "风险指标"
    },
    {
      "i": 1649,
      "keep": true,
      "knowledge": "私人投资公司的建立和受利用方式与国际商业公司类似。",
      "type": "事实"
    },
    {
      "i": 1650,
      "keep": true,
      "knowledge": "私人投资公司通常仅限于在税收中性的离岸金融司法管辖区持有投资资产。",
      "type": "定义"
    },
    {
      "i": 1651,
      "keep": true,
      "knowledge": "不记名股票和不记名债券表面上属于持有人，使其成为主要的洗钱工具。",
      "type": "案例"
    },
    {
      "i": 1652,
      "keep": true,
      "knowledge": "不记名证券转移后无所有者登记，资金转移发生在债券或股票证书实质交付之时。",
      "type": "流程"
    },
    {
      "i": 1653,
      "keep": true,
      "knowledge": "持有债券或股票的人基本可以主张所有权。",
      "type": "事实"
    },
    {
      "i": 1654,
      "keep": true,
      "knowledge": "不记名股票为掩饰合法所有权提供了很多机会。",
      "type": "事实"
    },
    {
      "i": 1655,
      "keep": true,
