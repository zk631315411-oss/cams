ck;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_acf7cf88b8" target="v_9f51aa78d4"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S12" id="page_31ed97c270"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1145" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_ec54272d3b" value="CH47-S12 Transaction monitoring &amp;gt; Communicating with customers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_d1fb61a505" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_f7a1c94704" value="CH47-S12 / card 1: Customer Communication for Information Gathering" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_1245df83f7" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_d7e5f16261" value="&lt;b&gt;标准：&lt;/b&gt;Use template and script for&lt;br&gt;complete and detailed&lt;br&gt;collection&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003378&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_766e1c93e9" value="&lt;b&gt;标准：&lt;/b&gt;Allow customer to speak&lt;br&gt;freely&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003377&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_735870cb70" value="&lt;b&gt;标准：&lt;/b&gt;Employ good interpersonal&lt;br&gt;skills and conversational&lt;br&gt;manner&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003376&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_62e2114749" value="&lt;b&gt;标准：&lt;/b&gt;Remain alert to responses&lt;br&gt;requiring follow-up or&lt;br&gt;clarification&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003379&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_f8f47a5f9f" value="&lt;b&gt;标准：&lt;/b&gt;Assure customer of data&lt;br&gt;discretion and regulatory&lt;br&gt;compliance&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003375&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_2ebc8550c8" value="&lt;b&gt;标准：&lt;/b&gt;Be aware that uncooperative&lt;br&gt;customer behavior may raise&lt;br&gt;suspicions&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003380&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="752" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_3de3c6fbad" value="&lt;b&gt;触发：&lt;/b&gt;Need to gather additional&lt;br&gt;customer info for due&lt;br&gt;diligence or investigation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003371&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_bb833b1e17" value="&lt;b&gt;步骤：&lt;/b&gt;Provide advance notification&lt;br&gt;of information collection&lt;br&gt;and data usage if required&lt;br&gt;or advisable&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003372, v7u_N003373&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_4221971f15" value="&lt;b&gt;步骤：&lt;/b&gt;Conduct information&lt;br&gt;gathering meeting with&lt;br&gt;customer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003371&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_1178ef4fc4" value="&lt;b&gt;步骤：&lt;/b&gt;Record meeting details in&lt;br&gt;writing and verify&lt;br&gt;information through other&lt;br&gt;sources&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003381&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_62ff38a53b" value="&lt;b&gt;产出：&lt;/b&gt;Accurate record of meeting&lt;br&gt;and verified information&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003381&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_293bd8cec5" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_3de3c6fbad" target="v_bb833b1e17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_5349ce4e36" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_bb833b1e17" target="v_4221971f15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a81ff9ecd1" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_4221971f15" target="v_1178ef4fc4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_583f26f4a4" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_1178ef4fc4" target="v_62ff38a53b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9cc9d1fc8f" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4221971f15" target="v_d7e5f16261"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_7d2f5ab02a" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4221971f15" target="v_766e1c93e9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_8cc437d56c" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4221971f15" target="v_735870cb70"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fdf8f4c337" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4221971f15" target="v_62e2114749"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2d7ac4f8c3" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4221971f15" target="v_f8f47a5f9f"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_63867c0dc7" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4221971f15" target="v_2ebc8550c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_5b83e19ca1" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Inferred sequence between trigger, notification, and meeting; notification requirement is conditional. Edge evidence strength set accordingly. Card is otherwise based on explicit guidance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="847" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S13" id="page_6de91b1981"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1398" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_1f943ec1bf" value="CH47-S13 Transaction monitoring &amp;gt; Investigating someone inside the organization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_8e392c46de" value="status=validation_failed | cards=1 | errors=3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_fc26e80c17" value="CH47-S13 / card 1: Internal Investigation Process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_f4d6842cc1" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_8487113e60" value="&lt;b&gt;输入：&lt;/b&gt;Interview plan&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003393&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_cee3b89fcb" value="&lt;b&gt;输入：&lt;/b&gt;Witness statements&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003389, v7u_N003390&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7364634a61" value="&lt;b&gt;输入：&lt;/b&gt;Digital evidence (emails,&lt;br&gt;logs, recordings)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003388&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_43cf96538e" value="&lt;b&gt;标准：&lt;/b&gt;Confidentiality&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003382, v7u_N003395&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7999696fbb" value="&lt;b&gt;标准：&lt;/b&gt;Proper recordkeeping&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003382, v7u_N003395&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_2059ee2ddb" value="&lt;b&gt;标准：&lt;/b&gt;Within the law and&lt;br&gt;organization&amp;#x27;s policies&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003385&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="752" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_915edba848" value="&lt;b&gt;标准：&lt;/b&gt;Protection of organization&lt;br&gt;and employee&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003382&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="857" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_ec3c07a18e" value="&lt;b&gt;标准：&lt;/b&gt;Not leading the witness&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003390&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="962" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_3d8937e6f9" value="&lt;b&gt;标准：&lt;/b&gt;Sensitive manner during&lt;br&gt;interviews&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003394&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1067" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_1f8641a4e2" value="&lt;b&gt;标准：&lt;/b&gt;Independent third party or&lt;br&gt;HR representative present&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003392&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1172" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7d21d5c970" value="&lt;b&gt;触发：&lt;/b&gt;Allegation received&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003386&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_4f3d1749b0" value="&lt;b&gt;步骤：&lt;/b&gt;Prepare interview plan&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003393&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="319" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_3c3812e155" value="&lt;b&gt;步骤：&lt;/b&gt;Create investigation plan&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003386&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_348d17651a" value="&lt;b&gt;判断：&lt;/b&gt;Determine required actions&lt;br&gt;based on allegations and&lt;br&gt;scope&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003384, v7u_N003387, v7u_N003388&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_463b200e70" value="&lt;b&gt;步骤：&lt;/b&gt;Conduct witness and suspect&lt;br&gt;interviews&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003384, v7u_N003389, v7u_N003390, v7u_N003391, v7u_N003392, v7u_N003394&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_dd53277493" value="&lt;b&gt;步骤：&lt;/b&gt;Engage HR for possible&lt;br&gt;suspension&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003387&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="694" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_ae950f05fe" value="&lt;b&gt;步骤：&lt;/b&gt;Engage IT to secure digital&lt;br&gt;evidence&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003388&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="786" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_4468e75ac5" value="&lt;b&gt;步骤：&lt;/b&gt;Collate, assess, and&lt;br&gt;preserve evidence&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003383&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_554d86c532" value="&lt;b&gt;产出：&lt;/b&gt;Case presented to department&lt;br&gt;for formal consideration&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003383&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="852" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_7b81995060" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_7d21d5c970" target="v_3c3812e155"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9e0ff5e7f0" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_3c3812e155" target="v_348d17651a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0971fd0ffd" value="DECIDES / If interview needed" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_348d17651a" target="v_463b200e70"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_8714fada6e" value="DECIDES / If HR involvement needed" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_348d17651a" target="v_dd53277493"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d9a6e92f9f" value="DECIDES / If IT support needed" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_348d17651a" target="v_ae950f05fe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d04436d561" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_4f3d1749b0" target="v_463b200e70"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fd490f2e26" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_4f3d1749b0" target="v_8487113e60"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_b29f73e383" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_463b200e70" target="v_8487113e60"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fde4db5e76" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_463b200e70" target="v_cee3b89fcb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a55f95068f" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_ae950f05fe" target="v_7364634a61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a438a10229" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_463b200e70" target="v_4468e75ac5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_642e9c031a" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_ae950f05fe" target="v_4468e75ac5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_97b43f99ec" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4468e75ac5" target="v_cee3b89fcb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_00091d9b61" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4468e75ac5" target="v_7364634a61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_326c890786" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_463b200e70" target="v_ec3c07a18e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_80adb113fe" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_463b200e70" target="v_3d8937e6f9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_32ce78efee" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_463b200e70" target="v_2059ee2ddb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f08752640c" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_463b200e70" target="v_1f8641a4e2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f5005fed15" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_dd53277493" target="v_915edba848"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0dee439d23" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4468e75ac5" target="v_43cf96538e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f36b3885ae" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4468e75ac5" target="v_7999696fbb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fec0416439" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_4468e75ac5" target="v_2059ee2ddb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_8beeca4a89" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_4468e75ac5" target="v_554d86c532"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_d027cbc0ec" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Weak inferred process order for plan-to-decision linkage and interview/IT-to-collate sequence; investigation steps may not be strictly linear. Decision node evidence is aggregated functional dependency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="972" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S14" id="page_ff9294b14c"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1956" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_d60c75bdd2" value="CH47-S14 Transaction monitoring &amp;gt; Analysis of information" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_db86280ee5" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_2f327fd242" value="CH47-S14 / card 1: Investigation Analysis and Decision-Making Process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_1795a25926" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_cbbc014bb8" value="&lt;b&gt;标准：&lt;/b&gt;Transaction patterns&lt;br&gt;(frequency, volume, timing,&lt;br&gt;unusual spikes, deviations,&lt;br&gt;large transactions to&lt;br&gt;high-risk jurisdictions)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003403&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_12c99ae900" value="&lt;b&gt;标准：&lt;/b&gt;Source and destination of&lt;br&gt;funds (align with customer&lt;br&gt;profile and business)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003404&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_f29c8dd03c" value="&lt;b&gt;标准：&lt;/b&gt;Layering transactions&lt;br&gt;(complex layering obscuring&lt;br&gt;fund trail)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003405&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_11876e835d" value="&lt;b&gt;标准：&lt;/b&gt;Integration with external&lt;br&gt;information (public records,&lt;br&gt;sanctions lists)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003406&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_51a0ca3aad" value="&lt;b&gt;开始：&lt;/b&gt;Investigation analysis&lt;br&gt;begins&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003396, v7u_N003397&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_b8cb26a0bf" value="&lt;b&gt;步骤：&lt;/b&gt;Collect and document data&lt;br&gt;from internal and external&lt;br&gt;sources&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003396&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_3fbe9bb6c5" value="&lt;b&gt;步骤：&lt;/b&gt;Analyze data to transform&lt;br&gt;into actionable intelligence&lt;br&gt;and insights&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003397&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_75b2f979fc" value="&lt;b&gt;步骤：&lt;/b&gt;Examine transaction&lt;br&gt;histories, customer profiles&lt;br&gt;, and regulatory alerts&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003398&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_63d706af65" value="&lt;b&gt;步骤：&lt;/b&gt;Seek to understand&lt;br&gt;relationships and cash and&lt;br&gt;fund flows&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003399&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_eaefc695fd" value="&lt;b&gt;步骤：&lt;/b&gt;Identify and map relevant&lt;br&gt;relationships between&lt;br&gt;individuals and entities&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003400&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="852" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_e336e7c421" value="&lt;b&gt;步骤：&lt;/b&gt;Perform network analysis to&lt;br&gt;visualize complex&lt;br&gt;relationships and&lt;br&gt;transaction flows&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003401&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="977" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_8b4ecb773d" value="&lt;b&gt;步骤：&lt;/b&gt;Analyze cash and fund flows&lt;br&gt;to assess transaction&lt;br&gt;legitimacy and identify&lt;br&gt;potential illicit activity&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003402&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1102" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_76405715a5" value="&lt;b&gt;步骤：&lt;/b&gt;Visualize cash flows and&lt;br&gt;relationships to comprehend&lt;br&gt;dynamics and detect&lt;br&gt;irregularities&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003407&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1227" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_84e36028d8" value="&lt;b&gt;判断：&lt;/b&gt;Is the case more complicated&lt;br&gt;or new information&lt;br&gt;discovered?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003408&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1352" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_74cffb3f8c" value="&lt;b&gt;步骤：&lt;/b&gt;Consult AFC compliance team&lt;br&gt;to determine how to proceed&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003409&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_21a9460c8f" value="&lt;b&gt;判断：&lt;/b&gt;Are suspicions validated and&lt;br&gt;further investigation,&lt;br&gt;reporting, or action&lt;br&gt;warranted?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003398&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1477" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_d7984a83ac" value="&lt;b&