 value="&lt;b&gt;产出：&lt;/b&gt;Account disposition decision&lt;br&gt;(maintain or close)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003560, v7u_N003565&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_4982e626f6" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_78a456cf38" target="v_36312cca7c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_5520484b87" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_36312cca7c" target="v_98c26a8fd2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_1a25f6b105" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_36312cca7c" target="v_f779fe76fb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_5c9c471af3" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_36312cca7c" target="v_7661e60aba"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_8a73c144dd" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_36312cca7c" target="v_7b8dfda82a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_10932b4731" value="CH49-S07 / card 2: Post-SAR monitoring and controls for maintained accounts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="814" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_876025d60e" value="nature=control | review=accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="848" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_96075ded45" value="&lt;b&gt;标准：&lt;/b&gt;Perform regular transaction&lt;br&gt;review for suspicious&lt;br&gt;activity&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003567&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="896" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_d4a807ff7c" value="&lt;b&gt;标准：&lt;/b&gt;Apply enhanced measures to&lt;br&gt;other accounts of same&lt;br&gt;customer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003568&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1001" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_e0724a3ca6" value="&lt;b&gt;标准：&lt;/b&gt;Perform enhanced due&lt;br&gt;diligence (update account&lt;br&gt;purpose/expected activity)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003569&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1106" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_f19bef3513" value="&lt;b&gt;标准：&lt;/b&gt;Introduce senior management&lt;br&gt;approval for transactions&lt;br&gt;(if extra measures needed)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003570&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1211" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_2080f0aa78" value="&lt;b&gt;标准：&lt;/b&gt;Adhere to all law&lt;br&gt;enforcement agency&lt;br&gt;restrictions&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003571&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1316" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_9c96bdb7f5" value="&lt;b&gt;标准：&lt;/b&gt;If high‑risk customer,&lt;br&gt;perform EDD and enhanced&lt;br&gt;monitoring&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003564&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1421" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_fc3eab23c2" value="&lt;b&gt;标准：&lt;/b&gt;Prevent new account openings&lt;br&gt;and verify principal/&lt;br&gt;interest are not proceeds of&lt;br&gt;crime (when termination is&lt;br&gt;not possible)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003575&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1526" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_9dc0fe80c2" value="&lt;b&gt;触发：&lt;/b&gt;Account remains open after&lt;br&gt;SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003566, v7u_N003567&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="896" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_616e8c4d24" value="&lt;b&gt;步骤：&lt;/b&gt;Apply post-SAR risk&lt;br&gt;management controls&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003566&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1021" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_f662e44ab9" value="&lt;b&gt;产出：&lt;/b&gt;Account risk management&lt;br&gt;controls applied&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003566, v7u_N003565&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1146" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_3408befa2b" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_9dc0fe80c2" target="v_616e8c4d24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_b6866a2735" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_96075ded45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_45ccb651a8" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_d4a807ff7c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4ed3609124" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_e0724a3ca6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_188d8d4730" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_f19bef3513"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d66fa9cc4e" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_2080f0aa78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_aae23faf68" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_9c96bdb7f5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_224c10e4f0" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_fc3eab23c2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4e5cdc5c01" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_616e8c4d24" target="v_f662e44ab9"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S08" id="page_6abb0066e1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_2c6d0c44a5" value="CH49-S08 Concluding an investigation and suspicious activity reporting &amp;gt; Reasons and consequences for not filing a SAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_a85fed9e3e" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_84dd19c644" value="CH49-S08 / card 1: Risk-based SAR filing decision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_fcd2aee60f" value="nature=assessment | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_0d6054f959" value="&lt;b&gt;标准：&lt;/b&gt;Regulatory guidelines&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003583&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_031ff42969" value="&lt;b&gt;触发：&lt;/b&gt;Detection of unusual&lt;br&gt;activity&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003576, v7u_N003577&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_f20be0437d" value="&lt;b&gt;步骤：&lt;/b&gt;Examine case facts&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003577&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_36fe95a5dd" value="&lt;b&gt;步骤：&lt;/b&gt;Analyze facts and compare&lt;br&gt;with regulatory guidelines&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003583&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_81a9e5ad68" value="&lt;b&gt;判断：&lt;/b&gt;Does analysis reveal&lt;br&gt;suspicious activity?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003583&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_ffd244fb7d" value="&lt;b&gt;判断：&lt;/b&gt;Does it meet regulatory&lt;br&gt;guidelines for filing a SAR?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003583&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="727" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_9fe94aeefc" value="&lt;b&gt;产出：&lt;/b&gt;Decision to file SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003583&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="852" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_16baa22bf8" value="&lt;b&gt;产出：&lt;/b&gt;Decision to not file SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003583, v7u_N003579&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="944" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_cc2b7a7f3b" value="&lt;b&gt;步骤：&lt;/b&gt;Document findings and&lt;br&gt;rationale for decision&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003579, v7u_N003583&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="977" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_effc082c9c" value="&lt;b&gt;产出：&lt;/b&gt;Documented SAR decision&lt;br&gt;rationale&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003579, v7u_N003583&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1102" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_71b1a4f2b0" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_031ff42969" target="v_f20be0437d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f96fc0183f" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_f20be0437d" target="v_36fe95a5dd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_e01c8047b0" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_36fe95a5dd" target="v_0d6054f959"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_dbfd94f3fd" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_36fe95a5dd" target="v_81a9e5ad68"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0a85f04beb" value="DECIDES / Yes - suspicious activity revealed" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_81a9e5ad68" target="v_ffd244fb7d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_74b0bc183a" value="DECIDES / No - insufficient suspicious activity / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;dashed=1;" edge="1" parent="1" source="v_81a9e5ad68" target="v_16baa22bf8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_6a806b63c4" value="DECIDES / Yes - meets regulatory filing guidelines" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_ffd244fb7d" target="v_9fe94aeefc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_b536af67ce" value="DECIDES / No - does not meet regulatory filing guidelines / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;dashed=1;" edge="1" parent="1" source="v_ffd244fb7d" target="v_16baa22bf8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_eb7b79c567" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_9fe94aeefc" target="v_cc2b7a7f3b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_92158d4be2" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_16baa22bf8" target="v_cc2b7a7f3b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9a28a7e32e" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_cc2b7a7f3b" target="v_effc082c9c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_7e4d597b86" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Card assembles a decision process from fragmented statements across the section. The explicit sequence only covers the positive path; negative branches are logically inferred and supported by examples of reasons for not filing (insufficient evidence, legal orders without enough support). The PRECEDES edge from examine facts to analyze facts is inferred as a logical next step in the risk-based decision process." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1222" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S09" id="page_ccdca9804a"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1485" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_527770624a" value="CH49-S09 Concluding an investigation and suspicious activity reporting &amp;gt; Follow-up action when no SAR is filed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_7d7d0186e4" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_5db954ca7a" value="CH49-S09 / card 1: Follow-up actions when no SAR is filed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_5caa47d969" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_44c0e21dd0" value="&lt;b&gt;触发：&lt;/b&gt;Decision not to file a SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003588, v7u_N003589&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_ee5a120f01" value="&lt;b&gt;步骤：&lt;/b&gt;Document rationale for not&lt;br&gt;filing a SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003590&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_9ead10c590" value="&lt;b&gt;步骤：&lt;/b&gt;Conduct trigger-event KYC&lt;br&gt;review&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003591&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_081f495750" value="&lt;b&gt;步骤：&lt;/b&gt;Document KYC review and&lt;br&gt;actions&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003592&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_5c4402a5e0" value="&lt;b&gt;判断：&lt;/b&gt;Has customer risk profile&lt;br&gt;changed?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003593&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_fc255506e0" value="&lt;b&gt;步骤：&lt;/b&gt;Re-perform CRA, consider&lt;br&gt;further risk mitigants, and&lt;br&gt;document&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003593, v7u_N003594&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="852" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_e0804ce79e" value="&lt;b&gt;步骤：&lt;/b&gt;Update client file with&lt;br&gt;investigation-related&lt;br&gt;documentation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003595&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="977" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_50fd870e97" value="&lt;b&gt;步骤：&lt;/b&gt;Conduct ongoing monitoring&lt;br&gt;for further unusual activity&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003596&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1102" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_fc22f589e4" value="&lt;b&gt;步骤：&lt;/b&gt;Maintain thorough and&lt;br&gt;accessible records&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003598, v7u_N003599&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1227" width="260" height="76" as="geometry" /></mxCell><mxCell id="e_c6c44fe466" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_44c0e21dd0" target="v_ee5a120f01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_b6534f1e37" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_ee5a120f01" target="v_9ead10c590"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_480d322759" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_9ead10c590" target="v_081f495750"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_bf1de282d2" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_081f495750" target="v_5c4402a5e0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_45c915733a" value="DECIDES / yes" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_5c4402a5e0" target="v_fc255506e0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0452f0b2f9" value="DECIDES / no / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;dashed=1;" edge="1" parent="1" source="v_5c4402a5e0" target="v_e0804ce79e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2ae08951d0" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_fc255506e0" target="v_e0804ce79e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9facd4eb35" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_e0804ce79e" target="v_50fd870e97"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_c46d1952c5" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_50fd870e97" target="v_fc22f589e4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_afa5eab7e2" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Process order is inferred from sequential listing of units. The &amp;#x27;no&amp;#x27; branch from risk change decision and several PRECEDES edges are based on functional dependency rather than explicit sequence statements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1347" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S10" id="page_40433d17c7"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_523bd626a6" value="CH49-S10 Concluding an investigation and suspicious activity reporting &amp;gt; Defensive suspicious activity reports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_369c04eb0a" value="status=ok | cards=0 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_911d161618" value="&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;Section defines defensive SARs and describes their negative impact, but provides only a high-level best practice (consider business risk appetite and customer relationship) without detailed assessment standards, control requirements, or risk indicators usable for judging business handling." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="780" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S11" id="page_caafd9221b"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_5ba7ec5a01" value="CH49-S11 Concluding an investigation and suspicious activity reporting &amp;gt; Communicating with law enforcement for an investigation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_1927d0f6e0" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_666d557d7f" value="CH49-S11 / card 1: Law Enforcement Communication Handling Controls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_70641717c3" value="nature=control | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_4dc0295bd7" value="&lt;b&gt;标准：&lt;/b&gt;Designated law enforcement&lt;br&gt;point of contact&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003618&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_2f9353a75f" value="&lt;b&gt;标准：&lt;/b&gt;Written procedures for law&lt;br&gt;enforcement communication&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003619&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_74d640e640" value="&lt;b&gt;标准：&lt;/b&gt;Formal request handling and&lt;br&gt;compliance requirements&lt;br&gt;(subpoenas, court orders,&lt;br&gt;search warrants, deadlines,&lt;br&gt;penalties)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003620, v7u_N003621, v7u_N003622, v7u_N003623, v7u_N003624&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_787d3f67cb" value="&lt;b&gt;标准：&lt;/b&gt;Documentation and&lt;br&gt;recordkeeping standards&lt;br&gt;(clear, concise, written,&lt;br&gt;timely notes)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003625, v7u_N003626, v7u_N003627, v7u_N003628&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_12e3e37b68" value="&lt;b&gt;开始：&lt;/b&gt;AFC investigation in&lt;br&gt;progress&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003612&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_ef2b515fea" value="&lt;b&gt;触发：&lt;/b&gt;Law enforcement&lt;br&gt;communication needed (seek&lt;br&gt;guidance, respond to&lt;br&gt;requests, cooperate, refer&lt;br&gt;cases)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003612, v7u_N003613&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_3c15a4b95e" value="&lt;b&gt;步骤：&lt;/b&gt;Manage law enforcement&lt;br&gt;communication&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003614, v7u_N003615, v7u_N003616, v7u_N003617&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_d9689ff0db" value="&lt;b&gt;产出：&lt;/b&gt;Compliant law enforcement&lt;br&gt;communication record and&lt;br&gt;outcome&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003625, v7u_N003624&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_aa060c9ad9" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_12e3e37b68" target="v_ef2b515fea"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f083458f74" value="PRECEDES / When law enforcement interaction occurs" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_ef2b515fea" target="v_3c15a4b95e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4696959394" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_3c15a4b95e" target="v_4dc0295bd7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_cc000fd13d" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_3c15a4b95e" target="v_2f9353a75f"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_01e0ca4518" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_3c15a4b95e" target="v_74d640e640"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_1741ff1b8f" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_3c15a4b95e" target="v_787d3f67cb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_5d3eb50138" value="PRODUCES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_3c15a4b95e" target="v_d9689ff0db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_7edbf548b2" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;This card models control requirements rather than a strict sequential execution process. The trigger and start nodes use functional dependency; the output node is inferred from documentation and compliance expectations. The USES edges capture parallel control standards applicable when managing law enforcement communications." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="722" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S12" id="page_71aab1bfd9"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_5470bf1da3" value="CH49-S12 Concluding an investigation and suspicious activity reporting &amp;gt; Responding to law enforcement requests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_afa313fbe3" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_89436e9e6a" value="CH49-S12 / card 1: Responding to Law Enforcement Requests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_fa02af46a3" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_8e99eb1696" value="&lt;b&gt;标准：&lt;/b&gt;Assessment criteria:&lt;br&gt;legality, urgency, relevance&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003638&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_ecd1bfb112" value="&lt;b&gt;标准：&lt;/b&gt;Response proportionality and&lt;br&gt;justification&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003634, v7u_N003639&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_0a62d170da" value="&lt;b&gt;标准：&lt;/b&gt;Information integrity and&lt;br&gt;confidentiality&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003635, v7u_N003632&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_1ae6bebb6f" value="&lt;b&gt;触发：&lt;/b&gt;Receipt of law enforcement&lt;br&gt;request&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003636&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_a7117adff3" value="&lt;b&gt;步骤：&lt;/b&gt;Initial assessment by&lt;br&gt;designated officer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003636, v7u_N003637, v7u_N003638, v7u_N003639&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_0bb399f021" value="&lt;b&gt;步骤：&lt;/b&gt;Coordinate response with&lt;br&gt;internal teams and maintain&lt;br&gt;relationships&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003640, v7u_N003641, v7u_N003642, v7u_N003643&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_26e79ceed2" value="&lt;b&gt;产出：&lt;/b&gt;Integrated and compliant&lt;br&gt;response&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003644&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_c88ddc1b62" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_1ae6bebb6f" target="v_a7117adff3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_dca6ada319" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a7117adff3" target="v_8e99eb1696"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2d4a89da96" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a7117adff3" target="v_ecd1bfb112"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3c5b7a4220" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a7117adff3" target="v_0a62d170da"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f848d11730" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_a7117adff3" target="v_0bb399f021"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_596279e50c" value="USES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;dashed=1;" edge="1" parent="1" source="v_0bb399f021" target="v_ecd1bfb112"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4fe2bd539d" value="USES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;dashed=1;" edge="1" parent="1" source="v_0bb399f021" target="v_0a62d170da"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_4c69971d54" value="PRODUCES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_0bb399f021" target="v_26e79ceed2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_4523c6369f" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Weak inferred process order: PRECEDES from initial assessment to coordinate response is functional dependency rather than explicit sequence. Also, USES edges from coordinate response to proportionality and integrity are inferred from general compliance requirements, not directly stated as used by the coordination action. The card represents a high-level execution process with some sequence reconstruction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="722" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S13" id="page_2c3a9f5494"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_a91fe180f1" value="CH49-S13 Concluding an investigation and suspicious activity reporting &amp;gt; How law enforcement case investigators read a SAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_5a456435d9" value="status=ok | cards=0 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_17394f745c" value="&lt;b&gt;SKIPPED&lt;/b&gt;&lt;br&gt;No section-level executable process, assessment standard, control requirement, or risk-indicator rule found. The section describes how law enforcement uses SARs, not how a business should handle, assess, or control processes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="780" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S14" id="page_49a5478f6e"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2340" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_39dd0b50c9" value="CH49-S14 Concluding an investigation and suspicious activity reporting &amp;gt; Refusing or terminating a customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_b372e93e9f" value="status=ok | cards=2 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_6e12d13d64" value="CH49-S14 / card 1: New Customer Refusal Handling Based on Reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_2f37db631c" value="nature=assessment | review=accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_3275903623" value="&lt;b&gt;触发：&lt;/b&gt;New customer fails CDD or is&lt;br&gt;outside risk appetite or&lt;br&gt;raises red flags&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003661&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_a24fd3919a" value="&lt;b&gt;步骤：&lt;/b&gt;Assess refusal reason&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003661&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_51d02e945c" value="&lt;b&gt;判断：&lt;/b&gt;Is refusal based on risk&lt;br&gt;appetite?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003661&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_9260e4cded" value="&lt;b&gt;步骤：&lt;/b&gt;Inform customer of refusal,&lt;br&gt;explaining &amp;#x27;outside risk&lt;br&gt;appetite&amp;#x27;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003666, v7u_N003668&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_4951bac197" value="&lt;b&gt;步骤：&lt;/b&gt;Take care not to tip off the&lt;br&gt;customer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003664, v7u_N003667&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_4d32c2a28a" value="&lt;b&gt;步骤：&lt;/b&gt;Make necessary suspicious&lt;br&gt;activity reports&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003670&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_3f59e619bf" value="&lt;b&gt;步骤：&lt;/b&gt;Keep a file stating reasons&lt;br&gt;for exit&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003669&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="852" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_418ff7e2de" value="&lt;b&gt;产出：&lt;/b&gt;Refusal concluded with&lt;br&gt;documentation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003669&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="977" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_d327fe1364" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_3275903623" target="v_a24fd3919a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_e565845f8f" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_a24fd3919a" target="v_51d02e945c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0367d7619b" value="DECIDES / yes" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_51d02e945c" target="v_9260e4cded"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0047b75695" value="DECIDES / no" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_51d02e945c" target="v_4951bac197"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_5c2707dec4" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_9260e4cded" target="v_3f59e619bf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_7668e25a7b" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_4951bac197" target="v_4d32c2a28a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d1158b2ef7" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_4d32c2a28a" target="v_3f59e619bf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fa9d4c8b16" value="PRODUCES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_3f59e619bf" target="v_418ff7e2de"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_56e9309edb" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Edge 006 and 008 have functional_dependency with needs_review due to no explicit ordering between avoid-tipping and making SAR, and inferred output from documentation requirement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1097" width="410" height="110" as="geometry" /></mxCell><mxCell id="v_346f1c15eb" value="CH49-S14 / card 2: Existing Customer Exit Handling Based on Reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="1250" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_fde5ab92a5" value="nature=assessment | review=accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="1284" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_28094e4742" value="&lt;b&gt;触发：&lt;/b&gt;Decision to exit an existing&lt;br&gt;customer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003662&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1332" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_9890228b99" value="&lt;b&gt;步骤：&lt;/b&gt;Determine exit reason&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003662&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1457" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_585fff7dfc" value="&lt;b&gt;判断：&lt;/b&gt;Is exit due to sector/&lt;br&gt;jurisdiction?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003672, v7u_N003673&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1582" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_6b73f06115" value="&lt;b&gt;步骤：&lt;/b&gt;Use press release or&lt;br&gt;standard statement to inform&lt;br&gt;customer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003672&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1707" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_dcaf714780" value="&lt;b&gt;步骤：&lt;/b&gt;Follow organization&amp;#x27;s&lt;br&gt;policies and procedures&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003674&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="1707" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_0e7e0290c7" value="&lt;b&gt;产出：&lt;/b&gt;Customer informed of exit&lt;br&gt;due to sector/jurisdiction&lt;br&gt;change&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003672&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1832" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_72017d20cf" value="&lt;b&gt;步骤：&lt;/b&gt;Send very generic letter or&lt;br&gt;communication of&lt;br&gt;discontinuation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003675, v7u_N003676&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1924" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_26bd57c62d" value="&lt;b&gt;步骤：&lt;/b&gt;Give customer reasonable&lt;br&gt;time to make other&lt;br&gt;arrangements&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003677&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="1957" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_5197b7aae3" value="&lt;b&gt;产出：&lt;/b&gt;Customer relationship&lt;br&gt;discontinued with proper&lt;br&gt;communication and time&lt;br&gt;allowance&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003675, v7u_N003677&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="2082" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_7badab4686" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_28094e4742" target="v_9890228b99"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_e0d4c7e5e4" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_9890228b99" target="v_585fff7dfc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d88d317e5c" value="DECIDES / yes" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_585fff7dfc" target="v_6b73f06115"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3a89a884fd" value="DECIDES / no" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_585fff7dfc" target="v_dcaf714780"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_eda1fdd9a3" value="PRODUCES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_6b73f06115" target="v_0e7e0290c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9b40803ef1" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_dcaf714780" target="v_72017d20cf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_60488a7f61" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_72017d20cf" target="v_26bd57c62d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d16c416f55" value="PRODUCES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_26bd57c62d" target="v_5197b7aae3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_e319cb15e8" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Edges 005-008 rely on functional_dependency for order and output inference. The sequence of policy follow, letter, and time allowance is logically implied but not explicitly ordered in source." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="2202" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S15" id="page_97636925fb"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_f2949d0a9e" value="CH49-S15 Concluding an investigation and suspicious activity reporting &amp;gt; De-risking" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_ea756ff159" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_6539f24e23" value="CH49-S15 / card 1: De-risking Mitigation Controls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_5cc8d902a8" value="nature=control | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_6fa548f2a7" value="&lt;b&gt;标准：&lt;/b&gt;Form a de-risking committee&lt;br&gt;with members from business,&lt;br&gt;legal, and compliance&lt;br&gt;departments to assess risk&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003691&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_6bd43e01d5" value="&lt;b&gt;标准：&lt;/b&gt;Adopt a risk-based approach&lt;br&gt;by conducting case-by-case&lt;br&gt;individual risk assessments&lt;br&gt;and reviews&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003692&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_cd09b7bea3" value="&lt;b&gt;标准：&lt;/b&gt;Develop a sector-specific&lt;br&gt;Wolfsberg-type questionnaire&lt;br&gt;to standardize information&lt;br&gt;collection&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003693&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_995821df76" value="&lt;b&gt;标准：&lt;/b&gt;Implement advanced&lt;br&gt;transaction monitoring to&lt;br&gt;improve transparency and&lt;br&gt;efficiency&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003694&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_be29f1342c" value="&lt;b&gt;标准：&lt;/b&gt;Engage in multi-stakeholder&lt;br&gt;discussions with regulators&lt;br&gt;and industry bodies&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003695&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_14b49701db" value="&lt;b&gt;标准：&lt;/b&gt;Develop nuanced risk tiers&lt;br&gt;accounting for multiple&lt;br&gt;factors beyond jurisdiction&lt;br&gt;or nationality&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003696&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="752" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_172fee457f" value="&lt;b&gt;标准：&lt;/b&gt;Provide financial access&lt;br&gt;through tiered accounts with&lt;br&gt;risk-appropriate transaction&lt;br&gt;limits&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003697&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="857" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_03c53482c5" value="&lt;b&gt;标准：&lt;/b&gt;Conduct due diligence or EDD&lt;br&gt;appropriate to the specific&lt;br&gt;risks of the sector or&lt;br&gt;business type&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003698&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="962" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_cadd4c8a77" value="&lt;b&gt;开始：&lt;/b&gt;Start&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003690&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_a5faa407d5" value="&lt;b&gt;触发：&lt;/b&gt;Organization considers broad&lt;br&gt;de-risking or customer&lt;br&gt;restriction&lt;br&gt;&lt;font col