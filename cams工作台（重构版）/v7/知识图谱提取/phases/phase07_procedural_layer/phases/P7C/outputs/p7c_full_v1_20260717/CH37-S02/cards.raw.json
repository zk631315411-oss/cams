          "edge_id": "edge_006",
          "edge_type": "REFERENCES",
          "source": "e002",
          "target": "e007",
          "evidence_unit_ids": [
            "v7u_N002748"
          ],
          "relation_type": "standard_constrains_action",
          "source_quote": "To assess channel risk, you might evaluate vulnerabilities in the delivery or communication channels."
        },
