{
  "batch_start": 1640,
  "items": [
    {
      "i": 1640,
      "keep": true,
      "knowledge": "员工的职责和问责",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1641,
      "keep": true,
      "knowledge": "如何保密反洗钱相关事务",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1642,
      "keep": true,
      "knowledge": "反洗钱趋势及与犯罪活动、恐怖融资和监管要求有关的新问题",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1643,
      "keep": true,
      "knowledge": "现实生活中的洗钱手法（最好选取那些发生在本组织或类似组织的案例），包括最初被发现时的行为模式、其对组织的影响以及最终如何解决等",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1644,
      "keep": true,
      "knowledge": "负责设计培训方案的人员必须确定上述哪些主题与培训对象相关。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1645,
      "keep": true,
      "knowledge": "英国金融市场行为监管局针对持续存在重大反洗钱缺陷的小型银行发布了一份改进指南。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1646,
      "keep": true,
      "knowledge": "这份指南的编制基础是英国金融市场行为监管局及其前身在两项主题审查中发现的优秀实践案例。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1647,
      "keep": true,
      "knowledge": "在发现问题中，英国金融市场行为监管局指出了培训项目的有效性问题，认为培训项目对组织独有风险的针对性往往不强。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1648,
      "keep": true,
      "knowledge": "指南公布的培训最佳实践包括：",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1649,
      "keep": true,
      "knowledge": "根据培训对象的具体岗位确定适当的培训。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1650,
      "keep": true,
      "knowledge": "如下领域的人员缺乏具体培训：离岸中心、抵押借贷、服务政治公众人物及其他高风险客户的领域、投资银行和贸易金融等。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 1651,
      "keep": true,
      "knowledge": "对具体业务部门或部门内具体岗位的培训，专门培训配合实践应用的培训方式较受欢迎。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1652,
      "keep": true,
      "knowledge": "为现有员工提供定期复训（通常为一年一次）至关重要。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1653,
      "keep": true,
      "knowledge": "银行应评估是否需要让第三方和外包部门的员工参与专门的反洗钱培训。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1654,
      "keep": true,
      "knowledge": "培训师可以采取下列步骤确保开展有效的反洗钱/反恐融资培训项目：",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1655,
      "keep": true,
      "knowledge": "明确必须进行沟通的议题，并确定最佳的沟通方式。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1656,
      "keep": true,
      "knowledge": "有时，无需正式的现场培训，通过备忘录或者电子邮件即可完成培训。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1657,
      "keep": true,
      "knowledge": "有时，利用网络教学可以有效传达信息。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1658,
      "keep": true,
      "knowledge": "有时，课堂培训才是最好的选择。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1659,
      "keep": true,
      "knowledge": "根据职能领域和员工/管理者的等级来确定培训对象。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1660,
      "keep": true,
      "knowledge": "这可以与\"他们为什么参加培训\"的快速评估 同步进行。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1661,
      "keep": true,
      "knowledge": "新员工应接受与老员工不同的培训。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1662,
      "keep": true,
      "knowledge": "确定培训需求。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1663,
      "keep": true,
      "knowledge": "可能是审计或监管检查发现的问题，或者系统、产品或规章的变化产生的问题。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 1664,
      "keep": true,
      "knowledge": "确定制定并实施培训计划的最佳人选。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1665,
      "keep": true,
      "knowledge": "确定采用分散式培训（例如通过较大的分支网络）的\"培训师培训\"课程是否必要。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1666,
      "keep": true,
      "knowledge": "制定课程摘要或课程大纲，其中应包括课程目标、目的和预期结果。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 1667,
      "keep": true,
      "knowledge": "务必明确培训对象以及相关资料的讲解方式。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1668,
      "keep": true,
      "knowledge": "在可能的情况下，制定培训日程表，明确培训主题和每门课程的培训频次。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1669,
      "keep": true,
      "knowledge": "考虑是否提供讲义。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1670,
      "keep": true,
      "knowledge": "大多数培训讲义的目的是强化培训要点，以及作为课后参考资料。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1671,
      "keep": true,
      "knowledge": "测试应作为评估培训效果的手段，测试应设定及格线。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1672,
      "keep": true,
      "knowledge": "员工分数应予以保存。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1673,
      "keep": true,
      "knowledge": "同样，如果用案例阐释某一个知识点，则应提供关于\"较为可取的行动方案\"的详细讨论。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 1674,
      "keep": true,
      "knowledge": "注意力持续时间也是需要考虑的因素。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1675,
      "keep": true,
      "knowledge": "重点关注易于领会且便于分类的小问题。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1676,
      "keep": true,
      "knowledge": "做好员工的出勤记录。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1677,
      "keep": true,
      "knowledge": "要求参加培训者签到，如果需要补课，则发出提醒通知。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 1678,
      "keep": true,
      "knowledge": "可对无故缺席者予以纪律处分并记入员工档案。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 1679,
      "keep": true,
      "knowledge": "组织的培训应具有常规性和持续性。",
      "type": "事实",
      "local_label": true
    }
  ],
  "label_source": "local_rules"
}