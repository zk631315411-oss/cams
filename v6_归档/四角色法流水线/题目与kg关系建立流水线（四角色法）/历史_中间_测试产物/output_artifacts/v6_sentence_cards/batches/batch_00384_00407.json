{
  "batch_start": 384,
  "items": [
    {
      "i": 384,
      "keep": true,
      "knowledge": "银行将多个地点的资金集中到一个账户中，即集中账户。",
      "type": "定义"
    },
    {
      "i": 385,
      "keep": true,
      "knowledge": "集中账户也被称为特殊用途账户、综合账户、清偿账户、暂记账户、当日账户、流动账户和托收账户。",
      "type": "事实"
    },
    {
      "i": 386,
      "keep": true,
      "knowledge": "集中账户通常用来为私人银行、信托和保管账户、资金转账以及国际附属机构的交易提供便利。",
      "type": "事实"
    },
    {
      "i": 387,
      "keep": true,
      "knowledge": "如果客户身份识别信息与金融交易分离，集中账户就可能滋生洗钱风险。",
      "type": "风险指标"
    },
    {
      "i": 388,
      "keep": true,
      "knowledge": "如果客户身份识别信息与交易分离，审计线索丧失，账户可能被滥用或不当管理。",
      "type": "风险指标"
    },
    {
      "i": 389,
      "keep": true,
      "knowledge": "使用集中账户的银行应采取政策、程序和流程来监督交易并保留记录。",
      "type": "流程"
    },
    {
      "i": 390,
      "keep": true,
      "knowledge": "在总分类账票据上要求双重签名。",
      "type": "流程"
    },
    {
      "i": 391,
      "keep": true,
      "knowledge": "禁止客户直接接入集中账户。",
      "type": "流程"
    },
    {
      "i": 392,
      "keep": true,
      "knowledge": "在客户账户报告中记录客户的交易情况。",
      "type": "流程"
    },
    {
      "i": 393,
      "keep": true,
      "knowledge": "禁止客户了解集中账户情况及直接指示员工通过这些账户进行交易。",
      "type": "流程"
    },
    {
      "i": 394,
      "keep": true,
      "knowledge": "保留妥当的交易和客户身份识别信息。",
      "type": "流程"
    },
    {
      "i": 395,
      "keep": true,
      "knowledge": "由独立第三方不时对该账户进行核对。",
      "type": "流程"
    },
    {
      "i": 396,
      "keep": true,
      "knowledge": "建立及时的差异解决流程。",
      "type": "流程"
    },
    {
      "i": 397,
      "keep": true,
      "knowledge": "识别并监控交易频繁的客户姓名。",
      "type": "流程"
    },
    {
      "i": 398,
      "keep": true,
      "knowledge": "私人银行为富有客户提供高度个性化和保密的产品和服务，费用依据所管理资产的数额决定。",
      "type": "定义"
    },
    {
      "i": 399,
      "keep": true,
      "knowledge": "私人银行业务通常半独立于银行的其他部门。",
      "type": "事实"
    },
    {
      "i": 400,
      "keep": true,
      "knowledge": "私人银行家在争夺高净值客户时面临的激烈竞争催生了全球范围内加强政府监管的要求。",
      "type": "事实"
    },
    {
      "i": 401,
      "keep": true,
      "knowledge": "激烈的竞争使得客户关系经理和营销人员在争取新客户、增加管理资产净值方面面临巨大压力。",
      "type": "事实"
    },
    {
      "i": 402,
      "keep": true,
      "knowledge": "私人银行大部分关系经理人的薪酬主要基于其为所在组织拉来的资产数额而定。",
      "type": "事实"
    },
    {
      "i": 403,
      "keep": true,
      "knowledge": "以下因素会导致私人银行容易被用于洗钱。",
      "type": "context"
    },
    {
      "i": 404,
      "keep": true,
      "knowledge": "公认的高额利润是导致私人银行容易被用于洗钱的因素之一。",
      "type": "案例"
    },
    {
      "i": 405,
      "keep": true,
      "knowledge": "客户关系经理人与其客户之间紧密的信托关系是导致私人银行容易被用于洗钱的因素之一。",
      "type": "案例"
    },
    {
      "i": 406,
      "keep": true,
      "knowledge": "以佣金为基础的客户关系经理人薪酬机制是导致私人银行容易被用于洗钱的因素之一。",
      "type": "案例"
    },
    {
      "i": 407,
      "keep": true,
      "knowledge": "由客户关系经理人形成的保密和谨慎文化是导致私人银行容易被用于洗钱的因素之一。",
      "type": "案例"
    }
  ]
