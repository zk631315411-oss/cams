{
  "batch_start": 800,
  "items": [
    {
      "i": 800,
      "keep": true,
      "knowledge": "1999 年，美洲开发银行 (IADB) 和美洲药物滥用管制委员会在 8 个南美国家启动了一项计划，对来自金融组织和负责执行反洗钱规定的金融监管机构的员工进行培训。",
      "type": "法规",
      "local_label": true
    },
    {
      "i": 801,
      "keep": true,
      "knowledge": "2001 年，它们针对这 8 个国家的法官和检察官制定并实施了另一项计划。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 802,
      "keep": true,
      "knowledge": "2002 年，它们又开始实施长期项目，计划在阿根廷、智利、厄瓜多尔、巴西、秘鲁、乌拉圭和委内瑞拉建立金融情报机构。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 803,
      "keep": true,
      "knowledge": "1995 年，多个国家的金融情报机构开始在一个非正式组织框架下开展合作；",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 804,
      "keep": true,
      "knowledge": "这个非正式组织即埃格蒙特集团，其名称取自首次会议召开地，即布鲁塞尔的埃格蒙特 - 艾伦贝格宫殿(Egmont-Arenberg Palace)。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 805,
      "keep": true,
      "knowledge": "该集团的目标是为全球的金融情报机构提供交流平台，以便促进各成员国开展合作并营造必要的环境，培养各成员国之间的信任，从而在反洗钱和反恐融资中安全分享敏感信息。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 806,
      "keep": true,
      "knowledge": "埃格蒙特集团由多个组织团体组成，其中不乏金融情报机构负责人。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 807,
      "keep": true,
      "knowledge": "埃格蒙特集团提供的支持包括：",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 808,
      "keep": true,
      "knowledge": "作为国际反洗钱/反恐融资机构的运作部门",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 809,
      "keep": true,
      "knowledge": "为打击反洗钱/反恐融资提供安全的专业知识和金融情报交流平台",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 810,
      "keep": true,
      "knowledge": "扩大信息交换合作，并形成制度化",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 811,
      "keep": true,
      "knowledge": "通过提供培训和促进人员交流来提高金融情报机构员工的专业知识与能力，从而增加金融情报机构的有效性",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 812,
      "keep": true,
      "knowledge": "通过埃格蒙特安全网站 (ESW) 等技术的应用，促进金融情报机构间进行更顺畅和安全的沟通",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 813,
      "keep": true,
      "knowledge": "提升金融情报机构的运作自主权",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 814,
      "keep": true,
      "knowledge": "促进在已经拥有反洗钱和反恐融资制度的司法管辖区或该制度尚处发展初期阶段的区域建立金融情报机构",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 815,
      "keep": true,
      "knowledge": "埃格蒙特集团编制了一系列治理文件，为埃格蒙特集团的未来工作奠定了基础，也将促进金融情报机构之间更广泛的国际合作和信息交流。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 816,
      "keep": true,
      "knowledge": "这些文件包括：《埃格蒙特宪章》和《埃格蒙特关于金融情报机构进行信息交流和行动指导的原则》。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 817,
      "keep": true,
      "knowledge": "后一份文件对各成员国具有约束力，并包括若干条款，包括一般框架和国际合作要求。",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 818,
      "keep": true,
      "knowledge": "这些条款包括：",
      "type": "分类",
      "local_label": true
    },
    {
      "i": 819,
      "keep": true,
      "knowledge": "埃格蒙特集团促进金融情报机构的发展和信息交流。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 820,
      "keep": true,
      "knowledge": "应鼓励金融情报机构在相互信任的基础上开展国际合作。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 821,
      "keep": true,
      "knowledge": "信息共享安排必须认识到具体问题，并针对具体问题的个案解决方案留出空间。",
      "type": "流程",
      "local_label": true
    },
    {
      "i": 822,
      "keep": true,
      "knowledge": "金融情报机构应与外国金融情报机构交换信息，无论其为何身份（例如行政、执法、司法或其他）。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 823,
      "keep": true,
      "knowledge": "金融情报机构应采用最高效的合作途径。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 824,
      "keep": true,
      "knowledge": "交换的信息应仅用于寻求或提供信息的目的。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 825,
      "keep": true,
      "knowledge": "埃格蒙特集团还提供案例研究，涵盖洗钱、恐怖融资、欺诈及其他形式的金融犯罪。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 826,
      "keep": true,
      "knowledge": "这些案例研究的素材通常是各司法管辖区内金融情报机构提交的案例。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 827,
      "keep": true,
      "knowledge": "它们可用来帮助反洗钱专业人员识别可疑活动，决定是否上报。",
      "type": "风险指标",
      "local_label": true
    },
    {
      "i": 828,
      "keep": true,
      "knowledge": "埃格蒙特集团开展一项行动倡议，并最终出版了题为《金融情报机构在行动：埃格蒙特的100 个洗钱案例》(FIUs in Action: 100 Cases from the Egmont Group) 的报告。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 829,
      "keep": true,
      "knowledge": "据埃格蒙特集团表示，这份出版物为识别洗钱案例要素提供了宝贵支持。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 830,
      "keep": true,
      "knowledge": "这份分析中的几个最佳实践可以使金融情报机构受益。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 831,
      "keep": true,
      "knowledge": "示例包括：即使金融情报机构正在开展调查，金融组织也应继续披露可疑活动，而许多案件表明，金融组织通过自身调查获得的其他信息对主管当局以后的调查非常有用。",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 832,
      "keep": true,
      "knowledge": "这份报告不仅分析了 100 个洗钱案例，还总结了洗钱活动中最常见的六大信号：",
      "type": "案例",
      "local_label": true
    },
    {
      "i": 833,
      "keep": true,
      "knowledge": "大额现金交易",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 834,
      "keep": true,
      "knowledge": "非典型及非经济的跨司法管辖区资金转账",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 835,
      "keep": true,
      "knowledge": "罕见的商业活动和交易",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 836,
      "keep": true,
      "knowledge": "大额和/或快速资金流动",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 837,
      "keep": true,
      "knowledge": "与客户资料不符的巨额财富",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 838,
      "keep": true,
      "knowledge": "抵抗询问。",
      "type": "事实",
      "local_label": true
    },
    {
      "i": 839,
      "keep": true,
      "knowledge": "由于金融行动特别工作组建议鼓励金融情报机构加入埃格蒙特，故该集团成员和观察员组织预期将继续壮大。",
      "type": "法规",
      "local_label": true
    }
  ],
