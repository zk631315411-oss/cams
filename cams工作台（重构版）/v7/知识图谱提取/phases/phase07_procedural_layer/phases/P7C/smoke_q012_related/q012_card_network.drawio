        <mxCell id="c4201_001" value="p7card_CH42-S01_001&lt;br&gt;Risk-based KYC/CDD onboarding process&lt;br&gt;KYC/CDD：识别、验证、目的性质、UBO、筛查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e6;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
