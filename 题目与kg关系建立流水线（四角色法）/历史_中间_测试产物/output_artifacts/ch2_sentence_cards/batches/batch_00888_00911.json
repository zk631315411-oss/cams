  "items": [
    {
      "i": 888,
      "keep": true,
      "knowledge": "赌博公费旅游是一种以赌场为基础的旅行方式，具有极大洗钱风险，公款消费客户通过第三方赌场中介将资金转移至国外并流经多家赌场。",
      "type": "事实"
    },
    {
      "i": 889,
      "keep": true,
      "knowledge": "赌博公费旅游方法会产生多层交易，掩饰资金来源、资金所有权及赌客身份。",
      "type": "事实"
    },
    {
      "i": 890,
      "keep": true,
      "knowledge": "在一些司法管辖区，赌场可能与赌场中介签订协议，出租私人赌博室。",
      "type": "事实"
    },
    {
      "i": 891,
      "keep": true,
      "knowledge": "赌场中介有时会代替赌场监控赌客活动，发放和收取赌场信贷。",
      "type": "事实"
    },
    {
      "i": 892,
      "keep": true,
      "knowledge": "一些司法管辖区允许赌场中介收集资金，以掩饰各客户的消费情况。",
      "type": "事实"
    },
    {
      "i": 893,
      "keep": true,
      "knowledge": "一些地区的持证赌场中介可能是其他国家赌场中介的挂名机构。",
      "type": "事实"
    },
    {
      "i": 894,
      "keep": true,
      "knowledge": "挂名中介通过持证赌场中介为赌场提供客源，而该持证赌场中介可能无法在赌场所在国取得执照。",
      "type": "事实"
    },
    {
      "i": 895,
      "keep": true,
      "knowledge": "无证次级赌场中介可作为无证信贷收取机构，并可能与有组织犯罪网络有联系。",
      "type": "事实"
    },
    {
      "i": 896,
      "keep": true,
      "knowledge": "无证次级赌场中介带来极大风险，可导致赌场与赌场中介间达成非正式合作，违反反洗钱/反恐融资规定。",
      "type": "事实"
    },
    {
      "i": 897,
      "keep": true,
      "knowledge": "金融行动特别工作组指出，一些司法管辖区未对赌场中介及其代理机构的营业资格进行规定，令洗钱风险进一步上升。",
      "type": "法规"
    },
    {
      "i": 898,
      "keep": true,
      "knowledge": "金融行动特别工作组强调需确保赌场中介运营商不受犯罪势力影响，确保金融交易透明，并遵守反洗钱/反恐融资举措。",
      "type": "法规"
    },
    {
      "i": 899,
      "keep": true,
      "knowledge": "金融犯罪执法网络和金融行动特别工作组指出了以下需特别注意的行为。",
