lue="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_f63363e6b1" target="v_d58df66ae4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d9af5fceb2" value="DECIDES / dismiss" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_d58df66ae4" target="v_c307e3d3ae"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_224aa76dbe" value="DECIDES / escalate" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_d58df66ae4" target="v_6e5f3910f0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_32be7ec878" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_c307e3d3ae" target="v_dac063864d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a9746194cc" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_6e5f3910f0" target="v_dac063864d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ed6dd23cf4" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_dac063864d" target="v_580446b6ba"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_b0e02aeb3d" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;The process order (trigger to gather actions) is inferred from context; the section describes the investigation context but does not explicitly state a sequential trigger. The gathering of internal and external information may occur simultaneously or in any order. The card is modeled as an execution process to judge compliance with information gathering and documentation steps." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1097" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S10" id="page_1fc642e23d"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_ef3155e579" value="CH47-S10 Transaction monitoring &amp;gt; How much research is reasonably enough?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_b35966a3d5" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_cdd59cb6ff" value="CH47-S10 / card 1: Assess Reasonableness of Research" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_4e872b5937" value="nature=assessment | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_8af891c425" value="&lt;b&gt;标准：&lt;/b&gt;Overall program&lt;br&gt;effectiveness considered&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003351&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_fb233baa83" value="&lt;b&gt;标准：&lt;/b&gt;Conclusions justifiable by&lt;br&gt;another person based on&lt;br&gt;content, documentation, and&lt;br&gt;steps&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003352&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_5245166f6d" value="&lt;b&gt;标准：&lt;/b&gt;Minimum standards reasonably&lt;br&gt;designed to comply with laws&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003354&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_89cf776b78" value="&lt;b&gt;标准：&lt;/b&gt;Verified documentation used&lt;br&gt;(e.g., primary verified docs&lt;br&gt;for UBOs 10%+)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003357, v7u_N003358&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_5c7654e670" value="&lt;b&gt;标准：&lt;/b&gt;FATF risk-based approach and&lt;br&gt;reasonable measures for&lt;br&gt;beneficial owner&lt;br&gt;verification&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003353&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_104df1c9d3" value="&lt;b&gt;标准：&lt;/b&gt;Systems and procedures to&lt;br&gt;detect, monitor, report&lt;br&gt;riskier customers/&lt;br&gt;transactions&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003360&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="752" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_fa4db5c787" value="&lt;b&gt;标准：&lt;/b&gt;Not expected to detect all&lt;br&gt;wrongdoing&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003359&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="857" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_57c405f52b" value="&lt;b&gt;标准：&lt;/b&gt;AML program standards&lt;br&gt;supplemented by policies of&lt;br&gt;specific business lines&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003355&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="962" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_3718faec9e" value="&lt;b&gt;标准：&lt;/b&gt;Corporate governance and&lt;br&gt;overall management of ML/TF&lt;br&gt;risks included&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003356&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="1067" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_a0e328836c" value="&lt;b&gt;开始：&lt;/b&gt;Evaluate reasonableness of&lt;br&gt;research&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003349, v7u_N003351&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_5778111ba4" value="&lt;b&gt;步骤：&lt;/b&gt;Assess research against&lt;br&gt;reasonableness standards&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003352&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_2ae5e450cd" value="&lt;b&gt;产出：&lt;/b&gt;Research reasonableness&lt;br&gt;conclusion&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003352, v7u_N003358&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_8cee9c6969" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_a0e328836c" target="v_5778111ba4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0e76bbb666" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_8af891c425"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f1f5f9543d" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_fb233baa83"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fb6c3c9831" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_5245166f6d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_310dde063a" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_89cf776b78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_37db7ea80e" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_5c7654e670"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_cd9f58761f" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_104df1c9d3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_cacb7e5e42" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_fa4db5c787"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_464655a2e3" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_57c405f52b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d40246c57c" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_3718faec9e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3f6543a21b" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_5778111ba4" target="v_2ae5e450cd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_a3c15a9086" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Converted non-procedural description of &amp;#x27;reasonable&amp;#x27; research standards into an assessment card. Standards are parallel assessment criteria used to judge reasonableness. No explicit decision flow was described; the card omits a decision node and instead uses a direct PRODUCES edge from the assess action to the conclusion output." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="597" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH47-S11" id="page_6963391aee"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1145" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_6aca4b2c16" value="CH47-S11 Transaction monitoring &amp;gt; Communication channels and tipping off" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_60c56c0271" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_fa0ce39a11" value="CH47-S11 / card 1: Customer Outreach for AML Alert Review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_f293b3bec9" value="nature=execution | review=accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_fcce3a2a95" value="&lt;b&gt;标准：&lt;/b&gt;Confidentiality: share&lt;br&gt;securely, authorized parties&lt;br&gt;only&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003365&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_e254b5a7d3" value="&lt;b&gt;标准：&lt;/b&gt;Clarity and precision: avoid&lt;br&gt;misunderstandings&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003366&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_cf60fe786a" value="&lt;b&gt;标准：&lt;/b&gt;Professionalism: maintain&lt;br&gt;professional tone&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003367&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_90881798fb" value="&lt;b&gt;标准：&lt;/b&gt;Avoid tipping off: do not&lt;br&gt;alert subject of monitoring&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003368&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_09e8d8ddf7" value="&lt;b&gt;标准：&lt;/b&gt;Compliance: adhere to data&lt;br&gt;protection laws and&lt;br&gt;regulations&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003369&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_33978968d1" value="&lt;b&gt;标准：&lt;/b&gt;Documentation: record all&lt;br&gt;communications&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003370&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="752" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_efcea9b808" value="&lt;b&gt;触发：&lt;/b&gt;Additional customer&lt;br&gt;information required for&lt;br&gt;alert/investigation&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003361, v7u_N003364&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_77e1e35495" value="&lt;b&gt;步骤：&lt;/b&gt;Ensure information is&lt;br&gt;critical and not available&lt;br&gt;internally/externally&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003364&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_ed0b272faa" value="&lt;b&gt;步骤：&lt;/b&gt;Plan outreach method&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003364&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_acf7cf88b8" value="&lt;b&gt;步骤：&lt;/b&gt;Conduct customer outreach&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003362, v7u_N003364&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_9f51aa78d4" value="&lt;b&gt;产出：&lt;/b&gt;Outreach completed with&lt;br&gt;documentation, no tipping&lt;br&gt;off&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003362, v7u_N003370&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="727" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_160ac3aa21" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_efcea9b808" target="v_77e1e35495"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_0