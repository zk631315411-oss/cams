      "card_nature": "execution",
      "title": "通过正式国际请求书提出司法协助请求",
      "flow_nodes": [
        {
          "node_id": "e001",
          "node_category": "entry",
          "node_type": "E3_state_threshold",
          "label": "没有MLAT的情况",
          "evidence_unit_ids": [
            "v7u_N002284"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "e002",
          "node_category": "process",
          "node_type": "P2_execution",
          "label": "通过正式国际请求书提出协助请求",
          "evidence_unit_ids": [
            "v7u_N002284"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "e003",
          "node_category": "exit",
          "node_type": "X3_state_change",
          "label": "请求由特定政府部门集中管理",
          "evidence_unit_ids": [
            "v7u_N002284"
          ],
          "evidence_strength": "explicit"
        }
      ],
      "flow_edges": [
        {
          "edge_id": "edge_001",
          "edge_type": "PRECEDES",
          "source": "e001",
          "target": "e002",
          "condition": "没有MLAT",
          "relation_type": "conclusion_triggers_response",
          "evidence_unit_ids": [
            "v7u_N002284"
          ],
          "source_quote": "In cases where no MLAT is in place, requests are made by a formal international letter of request, also known as commissions rogatoires in civil law jurisdictions and letters rogatory elsewhere."
        },
        {
          "edge_id": "edge_002",
          "edge_type": "PRODUCES",
          "source": "e002",
          "target": "e003",
          "relation_type": "result_handoffs_stage",
          "evidence_unit_ids": [
            "v7u_N002284"
          ],
          "source_quote": "These requests are managed centrally by specific government departments."
        }
      ],
      "source_unit_ids": [
        "v7u_N002284"
      ],
      "candidate_status": "candidate",
      "review_notes": "局部命题：当没有MLAT时，通过正式国际请求书请求协助，请求被政府部门集中管理。证据范围：v7u_N002284。待P7D逐边审核。"
    },
    {
      "card_id": "p7card_CH31-S08_002",
      "section_id": "CH31-S08",
      "card_nature": "assessment",
      "title": "基于政治、安全或双重犯罪原则拒绝司法协助",
      "flow_nodes": [
        {
          "node_id": "e001",
          "node_category": "auxiliary",
          "node_type": "standard",
          "label": "政治或安全原因",
          "evidence_unit_ids": [
            "v7u_N002286"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "e002",
          "node_category": "auxiliary",
          "node_type": "standard",
          "label": "请求涉及的行为在两国不具有同等可罚性（双重犯罪原则）",
          "evidence_unit_ids": [
            "v7u_N002286"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "e003",
          "node_category": "process",
          "node_type": "P1_assessment",
          "label": "被请求国可拒绝提供司法协助",
          "evidence_unit_ids": [
            "v7u_N002286"
          ],
          "evidence_strength": "explicit"
        }
      ],
      "flow_edges": [
        {
          "edge_id": "edge_001",
          "edge_type": "REFERENCES",
          "source": "e003",
          "target": "e001",
          "relation_type": "standard_constrains_action",
          "evidence_unit_ids": [
            "v7u_N002286"
          ],
          "source_quote": "Legal assistance can be denied by either jurisdiction due to political or security reasons"
        },
        {
          "edge_id": "edge_002",
          "edge_type": "REFERENCES",
          "source": "e003",
          "target": "e002",
          "relation_type": "standard_constrains_action",
          "evidence_unit_ids": [
            "v7u_N002286"
          ],
          "source_quote": "or if the offense is not equally punishable in each jurisdiction"
        }
      ],
      "source_unit_ids": [
        "v7u_N002286"
      ],
      "candidate_status": "candidate",
      "review_notes": "局部命题：可因政治、安全或双重犯罪原则拒绝司法协助。证据范围：v7u_N002286。待P7D逐边审核。"
    },
    {
      "card_id": "p7card_CH31-S08_003",
      "section_id": "CH31-S08",
      "card_nature": "assessment",
      "title": "MLAT措辞导致特定犯罪不被认可并致使请求无效",
      "flow_nodes": [
        {
          "node_id": "e001",
          "node_category": "auxiliary",
          "node_type": "standard",
          "label": "MLAT的措辞（是否涵盖特定犯罪）",
          "evidence_unit_ids": [
            "v7u_N002287"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "e002",
          "node_category": "process",
          "node_type": "P1_assessment",
          "label": "被请求国可能不认可请求国所指的特定犯罪",
          "evidence_unit_ids": [
            "v7u_N002287"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "e003",
          "node_category": "exit",
          "node_type": "X3_state_change",
          "label": "协助请求无效（如对加勒比避税港）",
          "evidence_unit_ids": [
            "v7u_N002288"
          ],
          "evidence_strength": "explicit"
        }
      ],
      "flow_edges": [
        {
          "edge_id": "edge_001",
          "edge_type": "REFERENCES",
          "source": "e002",
          "target": "e001",
          "relation_type": "standard_constrains_action",
          "evidence_unit_ids": [
            "v7u_N002287"
          ],
          "source_quote": "Depending on how the MLAT has been written, certain jurisdictions might not recognize specific crimes from the requesting state."
        },
        {
          "edge_id": "edge_002",
          "edge_type": "PRODUCES",
          "source": "e002",
          "target": "e003",
          "relation_type": "conclusion_triggers_response",
          "evidence_unit_ids": [
            "v7u_N002288"
          ],
          "source_quote": "For example, agreements between the US and the Caribbean do not cover US tax evasion, so they are ineffective when applied to Caribbean jurisdictions, which are often tax havens."
        }
      ],
      "source_unit_ids": [
        "v7u_N002287",
        "v7u_N002288"
      ],
      "candidate_status": "candidate",
      "review_notes": "局部命题：MLAT措辞可致不认犯罪使请求无效。证据范围：v7u_N002287, v7u_N002288。待P7D逐边审核。"
    },
    {
      "card_id": "p7card_CH31-S08_004",
      "section_id": "CH31-S08",
      "card_nature": "execution",
      "title": "EIO基于相互承认原则要求执行当局执行请求",
      "flow_nodes": [
        {
          "node_id": "e001",
          "node_category": "auxiliary",
          "node_type": "standard",
          "label": "相互承认原则（EIO基于相互承认）",
          "evidence_unit_ids": [
            "v7u_N002290"
          ],
          "evidence_strength": "explicit"
        },
        {
          "node_id": "e002",
          "node_category": "process",
          "node_type": "P8_constrained_action",
          "label": "执行当局必须承认并执行其他司法管辖区的请求",
          "evidence_unit_ids": [
            "v7u_N002290"
          ],
          "evidence_strength": "explicit",
          "modality": "required"
        }
      ],
      "flow_edges": [
        {
          "edge_id": "edge_001",
          "edge_type": "REFERENCES",
          "source": "e002",
          "target": "e001",
          "relation_type": "standard_constrains_action",
          "evidence_unit_ids": [
            "v7u_N002290"
          ],
          "source_quote": "The EIO is based on mutual recognition; that is, the executing authority must, in principle, recognize and ensure execution of the request of the other jurisdiction."
        }
      ],
      "source_unit_ids": [
        "v7u_N002290"
      ],
      "candidate_status": "candidate",
      "review_notes": "局部命题：基于相互承认原则，执行当局必须执行请求。证据范围：v7u_N002290。待P7D逐边审核。"
    },
