ment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_be5c4a5d4c" value="nature=assessment | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_2edecc6085" value="&lt;b&gt;触发：&lt;/b&gt;Alert generated (automated&lt;br&gt;or manual)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003233, v7u_N003235, v7u_N003237&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_36b6035bd3" value="&lt;b&gt;步骤：&lt;/b&gt;Review alert&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003234&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_ef5090670a" value="&lt;b&gt;判断：&lt;/b&gt;Is unusual behavior&lt;br&gt;explainable?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003234&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_b77f4f26e2" value="&lt;b&gt;产出：&lt;/b&gt;Behavior explained&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003234&lt;/font&gt;" style="shape=document;whiteSpace=wra