        <mxCell id="title" value="Q012 P7 卡片网络：EWRA 中私人银行高固有风险如何进入剩余风险评估" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="20" width="1300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="entry" value="场景入口&lt;br&gt;EWRA 识别出私人银行部门&lt;br&gt;较高固有洗钱风险&lt;br&gt;原因：高净值客户 + 财务结构复杂" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="90" width="420" height="105" as="geometry" />
        </mxCell>

        <mxCell id="col1" value="1. 固有风险依据卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="430" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c0801_001" value="p7card_CH08-S01_001&lt;br&gt;Assess relationship-manager incentive risk&lt;br&gt;关系经理激励 / AUM 压力 / 利益冲突" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="50" y="325" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c0801_002" value="p7card_CH08-S01_002&lt;br&gt;Review high-risk private banking customer profiles&lt;br&gt;高净值 / 复杂所有权结构 / PEP 等客户风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c0801_003" value="p7card_CH08-S01_003&lt;br&gt;Apply private banking governance controls&lt;br&gt;合规监督 / 平衡计分卡 / 风险管理融入职责" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="50" y="535" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c0805_001" value="p7card_CH08-S05_001&lt;br&gt;Screen SPVs for disguise or fraud red flags&lt;br&gt;SPV/PIV 红旗：掩饰、欺诈、透明度不足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="50" y="640" width="430" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c0805_002" value="p7card_CH08-S05_002&lt;br&gt;Model trade-based laundering through SPVs and PIVs&lt;br&gt;SPV/PIV 贸易型洗钱过程与结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="50" y="745" width="430" height="85" as="geometry" />
        </mxCell>

        <mxCell id="inherent" value="中间判断&lt;br&gt;私人银行部门固有风险高&lt;br&gt;且复杂结构提高风险识别难度" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
