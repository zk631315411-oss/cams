bc" target="v_a9869d3f16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_addec18de8" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_5d606671fc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_81cfd095d2" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_a1a4dd8b46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_982c2a6a1d" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_88e10ecc2c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d3eefc659b" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_1a30baadd5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f147f26043" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_359e40ecc3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_fb88ba7c2f" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_b7c6a57b77"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ce2fe7b009" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_c91c0e55b9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2098672125" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_a9869d3f16" target="v_126a7726cf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_beeaec94b2" value="PRODUCES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_a9869d3f16" target="v_5a3b268496"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_2df22fb8ca" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Control card derived from protective measure requirements. Start and output nodes are inferred and marked needs_review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="597" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S02" id="page_2576c364a0"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1113" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_f3060f1b8b" value="CH49-S02 Concluding an investigation and suspicious activity reporting &amp;gt; Duty to report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_86cd91988c" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_da3be1954e" value="CH49-S02 / card 1: Duty to Report Suspicious Activity Process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_487082e7ec" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_8a7fc12c86" value="&lt;b&gt;标准：&lt;/b&gt;Legal duty to report&lt;br&gt;financial crime&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003475, v7u_N003476, v7u_N003480&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_5eff3ff3f6" value="&lt;b&gt;标准：&lt;/b&gt;Willful blindness liability&lt;br&gt;standard&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003481, v7u_N003482&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_a6af5d6cc4" value="&lt;b&gt;标准：&lt;/b&gt;Organizational policies and&lt;br&gt;procedures for reporting&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003477, v7u_N003483, v7u_N003484&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_7966bc5f4c" value="&lt;b&gt;标准：&lt;/b&gt;Reporting within agreed&lt;br&gt;timelines&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003488&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_c01273323b" value="&lt;b&gt;标准：&lt;/b&gt;Unusual activity reporting&lt;br&gt;requirement&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003489&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_6bd30b7ad3" value="&lt;b&gt;触发：&lt;/b&gt;Suspicion of financial crime&lt;br&gt;by customer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003475, v7u_N003483&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_924b2591e1" value="&lt;b&gt;步骤：&lt;/b&gt;Staff report suspicion to&lt;br&gt;assigned compliance officer&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003483, v7u_N003484&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_c446a78399" value="&lt;b&gt;步骤：&lt;/b&gt;Compliance officer assesses&lt;br&gt;reported information&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003485&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_027f9f0dae" value="&lt;b&gt;判断：&lt;/b&gt;Is activity or explanation&lt;br&gt;sufficient?&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003486, v7u_N003487&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="270" height="96" as="geometry" /></mxCell><mxCell id="v_92696af0ed" value="&lt;b&gt;产出：&lt;/b&gt;Process stops (no further&lt;br&gt;action)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003486&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="727" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_da9be3ab75" value="&lt;b&gt;产出：&lt;/b&gt;Submit suspicious activity&lt;br&gt;report (SAR) to authority&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003487, v7u_N003488&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="819" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_ed218833e9" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_6bd30b7ad3" target="v_924b2591e1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a1933d9d35" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_924b2591e1" target="v_c446a78399"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_e938117536" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_c446a78399" target="v_027f9f0dae"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_bebb93d29a" value="DECIDES / yes (sufficient explanation/activity)" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_027f9f0dae" target="v_92696af0ed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_df9ebb8e44" value="DECIDES / no (facts indicate external report required)" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="v_027f9f0dae" target="v_da9be3ab75"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_c1f13dcaeb" value="USES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;dashed=1;" edge="1" parent="1" source="v_c446a78399" target="v_8a7fc12c86"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3e0832339a" value="USES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;dashed=1;" edge="1" parent="1" source="v_c446a78399" target="v_5eff3ff3f6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f2d563d49c" value="USES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;dashed=1;" edge="1" parent="1" source="v_c446a78399" target="v_a6af5d6cc4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2d624a4096" value="USES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;dashed=1;" edge="1" parent="1" source="v_c446a78399" target="v_7966bc5f4c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_c64c228f74" value="USES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;dashed=1;" edge="1" parent="1" source="v_c446a78399" target="v_c01273323b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_c150a8ddad" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;The USES edges from the assessment action to the legal, policy, and timeline standards are inferred as functional dependencies since the section does not explicitly state that the compliance officer uses these specific standards in the assessment step. The card captures the high-level reporting duty and decision process, but the exact criteria for the sufficiency decision are not detailed. Card may require downstream handoff to SAR filing procedures." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="847" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S03" id="page_a7f9030934"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_05b57de362" value="CH49-S03 Concluding an investigation and suspicious activity reporting &amp;gt; Regulations related to suspicious activity reporting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_6b8b58495e" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_e4c3f0c67d" value="CH49-S03 / card 1: SAR Regulatory Filing Requirements" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_98cbe54e34" value="nature=control | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_b81c581b1a" value="&lt;b&gt;标准：&lt;/b&gt;Timely filing within&lt;br&gt;jurisdictional timelines&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003502, v7u_N003503, v7u_N003493&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_8979a64425" value="&lt;b&gt;标准：&lt;/b&gt;Include appropriate,&lt;br&gt;complete, factual&lt;br&gt;information and reason for&lt;br&gt;suspicion&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003494, v7u_N003504, v7u_N003505, v7u_N003506&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_4c96a1b9e8" value="&lt;b&gt;标准：&lt;/b&gt;Do not disclose SAR to&lt;br&gt;unauthorized parties; avoid&lt;br&gt;tipping off&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003495, v7u_N003496, v7u_N003507, v7u_N003508&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_ba2dcf94dc" value="&lt;b&gt;触发：&lt;/b&gt;Suspicion of criminal&lt;br&gt;activity detected&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003493, v7u_N003501&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_1bd1c70ccc" value="&lt;b&gt;步骤：&lt;/b&gt;File SAR according to&lt;br&gt;regulations&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003493, v7u_N003498, v7u_N003491&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_262fb9b45b" value="&lt;b&gt;产出：&lt;/b&gt;SAR filed in compliance with&lt;br&gt;regulations&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003491, v7u_N003493, v7u_N003510&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_08e483cf71" value="PRECEDES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="v_ba2dcf94dc" target="v_1bd1c70ccc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_c95878d937" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_1bd1c70ccc" target="v_b81c581b1a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f587ca8b7c" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_1bd1c70ccc" target="v_8979a64425"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_d2b3095f7f" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_1bd1c70ccc" target="v_4c96a1b9e8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_164d2e80fc" value="PRODUCES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;dashed=1;" edge="1" parent="1" source="v_1bd1c70ccc" target="v_262fb9b45b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_54a6d1bcef" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;Converted regulatory requirements into a control card. The sequence from suspicion to filing is explicit, but the content and non-disclosure standards are parallel and modeled as USES edges. Output node is inferred functional dependency. Card represents a simplified view and may need refinement for operational process." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="597" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S04" id="page_4a9c5ed2f5"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_e2aac34aa5" value="CH49-S04 Concluding an investigation and suspicious activity reporting &amp;gt; Suspicious activity report structure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_ea8614f0ba" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_f69a8188f5" value="CH49-S04 / card 1: Completing the Suspicious Activity Report (SAR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_e08a6ee8e0" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_b2f71b0911" value="&lt;b&gt;标准：&lt;/b&gt;Subject demographics (name,&lt;br&gt;birthdate, address, ID&lt;br&gt;numbers, phone; if unknown,&lt;br&gt;note in SAR)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003512, v7u_N003523, v7u_N003524&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_94f2167d31" value="&lt;b&gt;标准：&lt;/b&gt;Filing institution, activity&lt;br&gt;location, primary regulator,&lt;br&gt;and point of contact&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003514, v7u_N003515, v7u_N003516, v7u_N003517, v7u_N003525&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_2f5295a59c" value="&lt;b&gt;标准：&lt;/b&gt;Report type (initial/&lt;br&gt;continuing) and internal&lt;br&gt;control number&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003521, v7u_N003522&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="437" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_728d4a2c14" value="&lt;b&gt;标准：&lt;/b&gt;Contact with law enforcement&lt;br&gt;and subpoena/judgment&lt;br&gt;details&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003526&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_6180c41071" value="&lt;b&gt;标准：&lt;/b&gt;Narrative: introduction/&lt;br&gt;impact statement, background&lt;br&gt;, transaction, conclusion;&lt;br&gt;answers who, what, where,&lt;br&gt;when, why, how&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003518, v7u_N003527, v7u_N003528&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="647" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_b2975e76ff" value="&lt;b&gt;开始：&lt;/b&gt;Decision to file SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003511&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_640d955737" value="&lt;b&gt;步骤：&lt;/b&gt;Gather all required&lt;br&gt;information and complete SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003512, v7u_N003513&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_5dbc0be80e" value="&lt;b&gt;产出：&lt;/b&gt;Completed SAR&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003520&lt;/font&gt;" style="shape=document;whiteSpace=wrap;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="290" height="76" as="geometry" /></mxCell><mxCell id="e_15c1720ca3" value="PRECEDES / review" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#666666;fontSize=10;dashed=1;" edge="1" parent="1" source="v_b2975e76ff" target="v_640d955737"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_a4e7776c83" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_640d955737" target="v_b2f71b0911"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3bab86a94f" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_640d955737" target="v_94f2167d31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_46bb37f9b3" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_640d955737" target="v_2f5295a59c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_19afc48962" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_640d955737" target="v_728d4a2c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_70ac1daecd" value="USES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="v_640d955737" target="v_6180c41071"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_9db344a242" value="PRODUCES" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="v_640d955737" target="v_5dbc0be80e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_927ea082e2" value="&lt;b&gt;review_notes&lt;/b&gt;&lt;br&gt;weak inferred process order; the source lists SAR structure requirements rather than a strict step-by-step sequence, and the sequential flow from start to action is inferred; review_status set to needs_review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="597" width="410" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CH49-S05" id="page_0519683620"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1142" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v_b1d7c138e7" value="CH49-S05 Concluding an investigation and suspicious activity reporting &amp;gt; Case example: SAR for a family trust" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="1050" height="42" as="geometry" /></mxCell><mxCell id="v_cf1b2b9792" value="status=ok | cards=1 | errors=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="78" width="680" height="28" as="geometry" /></mxCell><mxCell id="v_9026de06fa" value="CH49-S05 / card 1: SAR Filing Process for Family Trust Case" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="920" height="32" as="geometry" /></mxCell><mxCell id="v_d9ca70c7f2" value="nature=execution | review=needs_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="179" width="640" height="24" as="geometry" /></mxCell><mxCell id="v_e8ad5b2673" value="&lt;b&gt;标准：&lt;/b&gt;Maintain strict&lt;br&gt;confidentiality and no&lt;br&gt;tipping off&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003552&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="227" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_630c79b175" value="&lt;b&gt;标准：&lt;/b&gt;30-day filing deadline&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003553&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="120" y="332" width="330" height="74" as="geometry" /></mxCell><mxCell id="v_0e199078ee" value="&lt;b&gt;触发：&lt;/b&gt;Detection of unusual&lt;br&gt;activity in family trust&lt;br&gt;account&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003529, v7u_N003530, v7u_N003531&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="227" width="290" height="76" as="geometry" /></mxCell><mxCell id="v_1154e9f9d2" value="&lt;b&gt;步骤：&lt;/b&gt;Gather information for&lt;br&gt;initial SAR filing&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003533, v7u_N003534, v7u_N003535, v7u_N003536, v7u_N003537, v7u_N003538, v7u_N003539, v7u_N003540, v7u_N003541, v7u_N003542, v7u_N003543, v7u_N003544, v7u_N003545&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="352" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_a9ba5a46fe" value="&lt;b&gt;步骤：&lt;/b&gt;Analyze transaction activity&lt;br&gt;and assess money laundering&lt;br&gt;risk&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003546&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="477" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_93389a1e89" value="&lt;b&gt;步骤：&lt;/b&gt;Prepare SAR narrative and&lt;br&gt;attachments&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003547, v7u_N003548, v7u_N003549, v7u_N003551&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="655" y="602" width="260" height="76" as="geometry" /></mxCell><mxCell id="v_2cdd22f9c6" value="&lt;b&gt;步骤：&lt;/b&gt;Submit SAR to FinCEN online&lt;br&gt;portal within 30 days&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;v7u_N003553&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;